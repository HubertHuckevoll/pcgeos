		word	universi_12KernValues-universi_12StartData	; kerning value offset
		byte	32	; first character
		byte	255	; last character
		byte	46	; default character
		WBFixed	<0,13>	; underline position
		WBFixed	<0,1>	; underline thickness
		WBFixed	<204,7>	; strike-through position
		WBFixed	<0,0>	; above font box
		WBFixed	<0,0>	; below font box
		sword	0	; minimum LSB
		sword	0	; minimum TSB
		sword	15	; maximum BSB
		sword	12	; maximum RSB
		word	15	; pixel height
		byte	0x00	; font flags
		word	666	; heap count

