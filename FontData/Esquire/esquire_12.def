; SBCS bitmap strike. Offsets and unused records preserve the reference.
esquire_12Seg	segment
esquire_12StartData label byte
		word	esquire_12EndData-esquire_12StartData	; data size
		word	0	; maker
		WBFixed	<0,8>	; average width
		WBFixed	<0,11>	; maximum width
		WBFixed	<0,0>	; height adjustment
		WBFixed	<0,15>	; height
		WBFixed	<0,3>	; accent
		WBFixed	<0,7>	; mean
		WBFixed	<0,0>	; baseline adjustment
		WBFixed	<0,12>	; baseline
		WBFixed	<0,3>	; descent
		WBFixed	<0,1>	; external leading
		word	0	; kerning count
		word	1863	; kerning pair offset
		word	1863	; kerning value offset
		byte	0	; first character
		byte	255	; last character
		byte	46	; default character
		WBFixed	<0,13>	; underline position
		WBFixed	<0,1>	; underline thickness
		WBFixed	<204,7>	; strike-through position
		WBFixed	<0,0>	; above font box
		WBFixed	<0,0>	; below font box
		sword	0	; minimum LSB
		sword	0	; minimum TSB
		sword	15	; maximum BSB
		sword	11	; maximum RSB
		word	15	; pixel height
		byte	0x00	; font flags
		word	666	; heap count

