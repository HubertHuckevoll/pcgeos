; SBCS bitmap strike. Offsets and unused records preserve the reference.
esquire_09Seg	segment
esquire_09StartData label byte
		word	esquire_09EndData-esquire_09StartData	; data size
		word	0	; maker
		WBFixed	<0,9>	; average width
		WBFixed	<0,12>	; maximum width
		WBFixed	<0,0>	; height adjustment
