; SBCS bitmap strike. Offsets and unused records preserve the reference.
bison_12Seg	segment
bison_12StartData label byte
		word	bison_12EndData-bison_12StartData	; data size
		word	0	; maker
		WBFixed	<0,7>	; average width
		WBFixed	<0,14>	; maximum width
		WBFixed	<0,0>	; height adjustment
		WBFixed	<0,17>	; height
		WBFixed	<0,5>	; accent
		WBFixed	<0,6>	; mean
		WBFixed	<0,0>	; baseline adjustment
		WBFixed	<0,14>	; baseline
		WBFixed	<0,3>	; descent
		WBFixed	<0,1>	; external leading
		word	0	; kerning count
		word	bison_12KernPairs-bison_12StartData	; kerning pair offset
		word	bison_12KernValues-bison_12StartData	; kerning value offset
		byte	0	; first character
		byte	255	; last character
		byte	46	; default character
		WBFixed	<0,15>	; underline position
		WBFixed	<0,1>	; underline thickness
		WBFixed	<102,10>	; strike-through position
		WBFixed	<0,0>	; above font box
		WBFixed	<0,0>	; below font box
		sword	-1	; minimum LSB
		sword	0	; minimum TSB
		sword	17	; maximum BSB
		sword	14	; maximum RSB
		word	17	; pixel height
		byte	0x00	; font flags
		word	666	; heap count

	; Character table: glyph offset, advance, flags, usage.

