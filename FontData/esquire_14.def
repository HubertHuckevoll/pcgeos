; SBCS bitmap strike. Offsets and unused records preserve the reference.
esquire_14Seg	segment
esquire_14StartData label byte
		word	esquire_14EndData-esquire_14StartData	; data size
		word	0	; maker
		WBFixed	<0,10>	; average width
		WBFixed	<0,14>	; maximum width
		WBFixed	<0,0>	; height adjustment
		WBFixed	<0,18>	; height
		WBFixed	<0,3>	; accent
		WBFixed	<0,8>	; mean
		WBFixed	<0,0>	; baseline adjustment
		WBFixed	<0,14>	; baseline
		WBFixed	<0,4>	; descent
		WBFixed	<0,1>	; external leading
		word	0	; kerning count
		word	1863	; kerning pair offset
		word	1863	; kerning value offset
		byte	0	; first character
		byte	255	; last character
		byte	46	; default character
		WBFixed	<0,16>	; underline position
		WBFixed	<0,1>	; underline thickness
		WBFixed	<51,9>	; strike-through position
		WBFixed	<0,0>	; above font box
		WBFixed	<0,0>	; below font box
		sword	0	; minimum LSB
		sword	0	; minimum TSB
		sword	18	; maximum BSB
		sword	14	; maximum RSB
		word	18	; pixel height
		byte	0x00	; font flags
		word	666	; heap count

