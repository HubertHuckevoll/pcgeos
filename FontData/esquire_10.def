; SBCS bitmap strike. Offsets and unused records preserve the reference.
esquire_10Seg	segment
esquire_10StartData label byte
		word	esquire_10EndData-esquire_10StartData	; data size
		word	0	; maker
		WBFixed	<0,9>	; average width
		WBFixed	<0,12>	; maximum width
		WBFixed	<0,0>	; height adjustment
		WBFixed	<0,12>	; height
		WBFixed	<0,2>	; accent
		WBFixed	<0,6>	; mean
		WBFixed	<0,0>	; baseline adjustment
		WBFixed	<0,10>	; baseline
		WBFixed	<0,2>	; descent
		WBFixed	<0,1>	; external leading
		word	0	; kerning count
		word	1863	; kerning pair offset
		word	1863	; kerning value offset
		byte	0	; first character
		byte	255	; last character
		byte	46	; default character
		WBFixed	<0,11>	; underline position
		WBFixed	<0,1>	; underline thickness
		WBFixed	<0,6>	; strike-through position
		WBFixed	<0,0>	; above font box
		WBFixed	<0,0>	; below font box
		sword	0	; minimum LSB
		sword	0	; minimum TSB
		sword	12	; maximum BSB
		sword	12	; maximum RSB
		word	12	; pixel height
		byte	0x00	; font flags
		word	666	; heap count

