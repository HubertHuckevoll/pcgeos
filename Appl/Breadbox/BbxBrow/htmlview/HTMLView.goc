/*
 * Assemble WebMagick, the web browser in PC/GEOS Ensemble.
 *
 * This is the application entry module: it registers HTMLVProcessClass and
 * HTMLVApplicationClass, includes the UI object tree from htmlv_ui.goh and
 * holds shared text/error resources. The other HTMLView*.goc files implement
 * startup, commands, options, loading control and status updates for those
 * classes. Documents, frames and URLText handle individual pages below them.
 * Final shutdown, saved-local-page list commands and the URL entry text
 * class are implemented here.
 */


#ifdef __BORLANDC__
#pragma codeseg HTMLVIEW_TEXT
#endif
#ifdef __WATCOMC__
#pragma code_seg("HTMLVIEW_TEXT")
#endif

