/* URL-driver lifetime, FILE loading, redirects and connection checks.
 * Fetch scheduling remains in URLFETCH.goc; source files belong to the cache.
 * Keep the original Navigation_TEXT resource and plain C interfaces.
 */
#ifdef __BORLANDC__
#pragma codeseg Navigation_TEXT
#endif
#ifdef __WATCOMC__
#pragma code_seg("Navigation_TEXT")
#endif

