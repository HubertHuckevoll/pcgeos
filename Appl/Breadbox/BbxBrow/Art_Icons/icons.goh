/*
 * Select and package the browser's toolbar artwork.
 *
 * Included by htmlv_ui.goh, this file chooses the GPC, 256-color or 16-color
 * monikers according to build options and places them in TopIcons resources.
 * The individual Art/ and Art_Icons/ files contain the graphic data used by
 * toolbar buttons; this file connects those assets to the UI build.
 */

@ifdef COMPILE_OPTION_GPC_ICONS
@start TopIcons1Resource ;
@include "Art/GI001_8.goh"
@include "Art/GI002_8.goh"
@include "Art/GI003_8.goh"
@end TopIcons1Resource ;

@start TopIcons2Resource ;
@include "Art/GI004_8.goh"
@include "Art/GI005_8.goh"
@include "Art/A111_8.goh"
@end TopIcons2Resource ;

@start TopIcons3Resource ;
@include "Art/A113_8.goh"
@include "Art/A114_8.goh"
@include "Art/GI009_8.goh"
@include "Art/GI010_8.goh"
@end TopIcons3Resource ;

@start TopIcons4Resource, data ;
@include "Art/GI011_8.goh"
@include "Art/GI012_8.goh"
@include "Art/GI013_8.goh"
@include "Art/GI014_8.goh"
@end TopIcons4Resource ;
@endif

@ifdef COMPILE_OPTION_256_COLOR_ICONS
@start TopIcons1Resource ;
@include "Art_Icons/forward.goh"
@include "Art_Icons/home.goh"
@end TopIcons1Resource ;

@start TopIcons2Resource ;
@include "Art_Icons/open.goh"
@include "Art_Icons/back.goh"
@end TopIcons2Resource ;

@start TopIcons3Resource ;
@include "Art_Icons/stop.goh"
@include "Art_Icons/reload.goh"
@end TopIcons3Resource ;

@start TopIcons4Resource ;
@include "Art_Icons/history.goh"
@include "Art_Icons/print.goh"
@end TopIcons4Resource ;
@endif


@ifdef COMPILE_OPTION_16_COLOR_ICONS
@start TopIcons1Resource ;
@include "Art_Icons/forwar16.goh"
@include "Art_Icons/home16.goh"
@end TopIcons1Resource ;

@start TopIcons2Resource ;
@include "Art_Icons/open16.goh"
@include "Art_Icons/back16.goh"
@end TopIcons2Resource ;

@start TopIcons3Resource ;
@include "Art_Icons/stop16.goh"
@include "Art_Icons/reload16.goh"
@end TopIcons3Resource ;

@start TopIcons4Resource ;
@include "Art_Icons/histor16.goh"
@include "Art_Icons/print16.goh"
@end TopIcons4Resource ;
@endif
