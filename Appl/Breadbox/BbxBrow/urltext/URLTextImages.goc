/*
 * URLTextClass image requests, geometry, replacement and visibility.
 *
 * Ordinary and script-driven requests share ProcessSingleGraphic.
 * Keep its near calling convention by keeping every caller in this file.
 * Fetch acknowledgement and native image replacement retain ownership.
 *
 * URLTEXT.goc owns URLTextClass and registers these external methods.
 */

@include <stdapp.goh>
#include <geoMisc.h>
#include <Ansi/string.h>
#include <Ansi/stdio.h>
#include <Ansi/stdlib.h>
@include "htmlview.goh"
@include "importg.goh"
#include "URLTextInternal.h"

@extern object SettingsBoolGroup;
@extern object NavigateFitToWindow;

/* Source organization does not change code-resource placement. */
#ifdef __BORLANDC__
#pragma codeseg URLTEXT_TEXT
#pragma option -dc-
#endif
#ifdef __WATCOMC__
#pragma code_seg("URLTEXT_TEXT")
#endif

#define RoundWWF(wwf) (IntegerOf(wwf) + ((FractionOf(wwf) >= 0x8000) ? 1 : 0))

/* Use the existing GIF assumption when an image MIME prefix is missing. */
void AssumeGraphic(TCHAR *mimeType)
{
    if (LocalCmpStringsNoCase(mimeType, _TEXT("image/"), 6) != 0) {
        /* assume GIF, will fall through to JPG */
        strcpy(mimeType, _TEXT("image/gif"));
    }
}

@extern method URLTextClass, MSG_URL_TEXT_GET_IMAGE_SOURCE_WIDTH
{
    HTMLTextInstance *textP = ObjDerefVis(oself);

    return (textP->HTI_state & HTS_VIEW_NOT_OPENED) ? 0 : textP->HTI_viewWidth;
}

/* Collapse broken inline images before the final page layout. */
@extern method URLTextClass, MSG_URL_TEXT_HIDE_BROKEN_IMAGES
{
    word i, n;
    HTMLimageData image;
#ifdef ERROR_CHECK
    VisTextGraphic graphic;
#endif

    n = @call oself::MSG_HTML_TEXT_GET_IMAGE_COUNT();
    for(i = 0; i < n; i++) {
        @call oself::MSG_HTML_TEXT_GET_IMAGE(i, &image);
        if(!(image.flags & HTML_IDF_BROKEN) ||
            image.pos >= HTML_IMAGE_POS_RESERVED)
            continue;

        image.HID_size.XYS_width = image.HID_size.XYS_height = 0;
        image.hspace = image.vspace = 0;
        /* ATTENTION: Resolving clears BROKEN, so "Load Images Now" skips
         * these images. Page reload resets loading state and retries them. */
        @call oself::MSG_HTML_TEXT_RESOLVE_IMAGE(i, &image, 0, 0xFFFF);
#ifdef ERROR_CHECK
        @call oself::MSG_VIS_TEXT_GET_GRAPHIC_AT_POSITION(&graphic, image.pos);
        EC_ERROR_IF(graphic.VTG_size.XYS_width ||
            graphic.VTG_size.XYS_height, -1);
#endif
    }
}

#define IMAGE_URL_EXTENSION_MAX 16

/*
 * Return TRUE only when the URL gives us a known image type and no installed
 * MIME driver handles it. Unknown and extensionless URLs must reach HTTP.
 */
static Boolean _pascal
ImageURLGetUnsupportedFormat(NameToken nameT)
{
    TCHAR url[HTML_STATIC_BUF];
    TCHAR extension[IMAGE_URL_EXTENSION_MAX];
    TCHAR mimeType[MIME_MAXBUF];
    FileLongName driver;
    TCHAR *urlP;
    TCHAR *end;
    TCHAR *fragment;
    TCHAR *slash;
    TCHAR *dot;
    word extensionLength;
    Boolean unsupported;

    unsupported = FALSE;
    NamePoolCopy(namePool, url, sizeof(url), nameT, &urlP);

    end = strchr(urlP, '?');
    fragment = strchr(urlP, '#');
    if(!end || (fragment && fragment < end))
        end = fragment;
    if(end)
        *end = 0;

    slash = strrchr(urlP, '/');
    dot = strrchr(urlP, '.');
    if(dot && (!slash || dot > slash) && dot[1])
    {
        extensionLength = strlen(dot + 1);
        if(extensionLength < IMAGE_URL_EXTENSION_MAX)
        {
            strcpy(extension, dot + 1);
            strupr(extension);
            if(NameAssocFindAssociation(assocExtType, extension,
                mimeType, sizeof(mimeType), TRUE, (void *)0) &&
                !LocalCmpStringsNoCase(mimeType, _TEXT("image/"), 6) &&
                !NameAssocFindAssociation(assocTypeDriver, mimeType,
                    driver, sizeof(driver), TRUE, (void *)0))
            {
                unsupported = TRUE;
            }
        }
    }

    NamePoolDestroyIfDynamic(urlP);
    return unsupported;
}

void IReplaceGraphic(optr oself, ObjCacheToken oct, HTMLimageData *p, word i,
    word invalFrom, word invalTo);

/* Reuse the cache or queue a fetch while retaining the image name reference. */
Boolean LOCAL ProcessSingleGraphic(HTMLimageData *p, optr oself,
    NameToken referer,
    word i,
    Boolean loadUnknownSize,
    Boolean forceLoad,
    Boolean objCache,
    Boolean replaceLike)
{
    word nameT;
    ObjCacheToken oct;
    optr request ;
    URLTextRequestGraphic *p_request ;
#if PROGRESS_DISPLAY
    /* get vfptr to callback routine */
    static proc_LoadProgressCallback *loadProgressCallback = LoadGraphicProgressCallback;
    LoadProgressData loadProgressData;
#endif
    Boolean ret = FALSE;
    TCHAR svgName[1], *svgNameP;
    optr frame;
    ObjCacheToken owner;
    URLTextInstance *textP;
    Boolean queued;
    extern Boolean G_stopped ;

    nameT = p->HID_resolvedURL;         /* fully resolved URL */

    /* The token will be released by either INTERNAL_REPLACE_LIKE_GRAPHICS
       or by the fetch handling. */
    NamePoolUseToken(namePool, nameT);

    if(objCache && !forceLoad && !(p->flags & HTML_IDF_INLINE_SVG))
    {
        oct = ObjCacheFindURL(OCT_GSTRING, nameT, TRUE, TRUE);
        /* find out if object was cached */
    }
    else
    {
        oct = OCT_NULL;                   /* no image yet... */
    }

    if(oct != OCT_NULL)                 /* found in cache */
    {
        if (replaceLike)
        {
            /* Replace the images. Cache and Name token are released by receiver */
            @call oself::MSG_URL_TEXT_INTERNAL_REPLACE_LIKE_GRAPHICS(oct,
                nameT, 0, 0xFFFF);
        }
        else			/* Replace just the one image */
        {
            HTMLimageData dupP = *p;

            IReplaceGraphic(oself, oct, &dupP, i, 0, 0xFFFF);
            ObjCacheUnlockItem(oct);
            NamePoolReleaseToken(namePool, nameT);
        }
    }
    else if(ImageURLGetUnsupportedFormat(nameT))
    {
        @call oself::MSG_URL_TEXT_INTERNAL_REPLACE_LIKE_GRAPHICS(OCT_NULL,
            nameT, 0, 0xFFFF);
    }
    else if ((loadUnknownSize || !p->size.XYS_height || !p->size.XYS_width) && (!G_stopped))
    {                                   // possibly load even if size unknown
        /* Do the actual request for the image */
        @call oself::MSG_URL_TEXT_INC_PENDING() ;

        if(p->flags & HTML_IDF_INLINE_SVG) {
            textP = ObjDerefVis(oself);
            frame = textP->UTI_frame;
            owner = @call frame::MSG_URL_FRAME_GET_CACHE_TOKEN();
            NamePoolCopy(namePool, svgName, sizeof(svgName), nameT, &svgNameP);
            queued = owner && ImportThreadRequestImportGraphic(oself, nameT,
                _TEXT("image/svg+xml"), svgNameP, FALSE, owner
#if PROGRESS_DISPLAY
                , NULL
#endif
                );
            NamePoolDestroyIfDynamic(svgNameP);
            if(!queued) {
                @call oself::MSG_URL_TEXT_INTERNAL_REPLACE_LIKE_GRAPHICS(
                    OCT_NULL, nameT, 0, 0xFFFF);
                @call oself::MSG_URL_TEXT_DEC_PENDING();
            }
            return queued;
        }

        request = URLFetchExtraMemoryAlloc(sizeof(URLTextRequestGraphic)) ;
        URLFetchExtraMemoryLock(request) ;
        p_request = URLFetchExtraMemoryDeref(request) ;
        p_request->index = i ;
        p_request->imageGeneration =
            ((URLTextInstance *)ObjDerefVis(oself))->UTI_imageGeneration;

        EC(   NamePoolIsTokenValid(namePool, nameT, TRUE) ; )
        p_request->nameT = nameT ;        /* Remember the _original_ name */

        /* Token is released when request is finished */

        p_request->objCache = objCache ;
#if PROGRESS_DISPLAY
        p_request->progressCanceled = FALSE;
#endif
        URLFetchExtraMemoryUnlock(request) ;

#if PROGRESS_DISPLAY
        /* set up loading progress data and make fetch request */
        loadProgressData.LPD_callback = loadProgressCallback;
        loadProgressData.LPD_textObj = oself;
        loadProgressData.LPD_nameT = nameT;
        loadProgressData.LPD_request = request;
        /* other fields are initialized by fetch thread */
        URLFetchRequest(
            nameT,
            forceLoad? ULM_ALWAYS:ULM_CACHE,
            NullHandle,
            referer,
            oself,
            MSG_URL_TEXT_GRAPHIC_FETCHED,
            request,
        /* no loading progress if not desired, or if background bitmap
           or if image is fairly short (allow unsized ones to try
           loading progress, will be rejected by http module if small) */
            (!progressDisplay || (p->pos >= HTML_IMAGE_POS_RESERVED) ||
                (p->size.XYS_height && (p->size.XYS_height < progressMinHeight)) ?
                NULL : &loadProgressData)) ;
#else
        URLFetchRequest(
            nameT,
            forceLoad? ULM_ALWAYS:ULM_CACHE,
            NullHandle,
            referer,
            oself,
            MSG_URL_TEXT_GRAPHIC_FETCHED,
            request) ;
#endif
        ret = TRUE;
    }
    else
        NamePoolReleaseToken(namePool, nameT);

    return ret;
}

/* Resolve image URLs and process cached or fetched graphics in two passes. */
@extern method URLTextClass, MSG_URL_TEXT_PROCESS_GRAPHICS
{
    word n,i,j,size;
    TCHAR name[HTML_STATIC_BUF], *nP;
    HTMLimageData *p, image, image2;
    Boolean objCache;
    optr imageArray = pself->HTI_imageArray;
    optr textPool = pself->HTI_namePool;
    optr frame = pself->UTI_frame;
    word pass;
    NameToken referer = NAME_POOL_NONE;
    optr realFrame = NullOptr;
    dword generation = pself->UTI_imageGeneration;

    @call self::MSG_URL_TEXT_INC_PENDING();

    if(!imageArray)                     /* avoid indenting all this stuff... */
    {
        @call self::MSG_URL_TEXT_DEC_PENDING();
        return;                           /* INC/DEC may generate a "frame complete" message */
    }

    if (frame) {
        realFrame = @call frame::MSG_URL_FRAME_FIND_REAL_FRAME();
        /* set up referer (marked in-use by GET_URL) */
        referer = @call realFrame::MSG_URL_FRAME_GET_URL();
    }

    objCache = (@call SettingsBoolGroup::
        MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS() & HTMLV_OBJECT_CACHE);
    /* object cache enabled? */

    MemLock(OptrToHandle(imageArray));
    n = ChunkArrayGetCount(imageArray);

    /*
     * Resolve all image URLs at once to allow for fast compares further down.
     */
    for(i=0; i<n; i++)
    {
        p = ChunkArrayElementToPtr(imageArray, i, &size);

        if(!p->HID_resolvedURL)           /* name not resolved yet */
        {
            NamePoolCopy(textPool, name, sizeof(name),
                (p->flags & HTML_IDF_INLINE_SVG) ? p->svgFile : p->imageURL, &nP);

            if(!(p->flags & HTML_IDF_INLINE_SVG))
                @call frame::MSG_URL_FRAME_COMPLETE_URL(&nP);
            /* make it an absolute canonical name */

            p->HID_resolvedURL = NamePoolTokenize(namePool, nP, FALSE);
            NamePoolDestroyIfDynamic(nP);
        }
    }

    MemUnlock(OptrToHandle(imageArray));

    /* A synchronous format failure can start a picture fallback. Never
       call the loader with the image array locked. */
    /*
     * Check all images and get them from the cache or initiate loading.
     */
    for(pass=1; pass<=2; pass++)
    {
        for(i=0; i<n; i++)
        {
            if(((URLTextInstance *)ObjDerefVis(oself))->UTI_imageGeneration !=
               generation || !@call oself::MSG_HTML_TEXT_GET_IMAGE(i, &image))
                break;
            p = &image;
            if((p->flags & (HTML_IDF_RESOLVED|HTML_IDF_RESOLVING)))
                continue;                     // Skip graphics that have been handled

            if(ProcessSingleGraphic(p, oself, referer, i,
                (pass==2), forceLoad, objCache, TRUE))
            {
                /* Mark this and all similar graphics further down */
                for (j=i; j<n; j++)  {
                    if(((URLTextInstance *)ObjDerefVis(oself))->UTI_imageGeneration !=
                       generation || !@call oself::MSG_HTML_TEXT_GET_IMAGE(j, &image2))
                        break;

                    /* Only check images that are not resolved or are resolving */
                    if((image2.flags & (HTML_IDF_RESOLVED|HTML_IDF_RESOLVING))==0)  {
                        if (image2.HID_resolvedURL == p->HID_resolvedURL)
                            @call self::MSG_HTML_TEXT_MARK_IMAGE_RESOLVING(j);
                    }
                }
            }
        }
    }

    @call self::MSG_URL_TEXT_DEC_PENDING() ;

    /* When the frame is done, we can start the animations */
    @send,forceQueue oself::MSG_HTML_TEXT_ANIMATIONS_ON() ;

    /* release referer */
    if (referer != NAME_POOL_NONE)
        NamePoolReleaseToken(namePool, referer);
}

/* Acknowledge the fetch and retain the existing import/cancellation cleanup. */
@extern method URLTextClass, MSG_URL_TEXT_GRAPHIC_FETCHED
{
    URLTextRequestGraphic *p_request ;
    URLTextRequestGraphic request ;
    URLFetchResult *p_result ;
    URLFetchResult result ;
    Boolean importQueued;
    Boolean temporary;
    word ret;
    extern Boolean G_stopped;
#ifdef CACHE_VALIDATION
    ObjCacheToken oct ;
#endif

    /* Copy over the result data so we don't have to deal with */
    /* memory deref problems. */
    p_result = MemLock(urlFetchMem) ;
    memcpy(&result, p_result, sizeof(result)) ;
    MemUnlock(urlFetchMem) ;
    MemFree(urlFetchMem) ;

    /* since we know this came from IMG tag, assume graphic */
    AssumeGraphic(result.mimeType);

    /* Copy over the request data to avoid lock/unlock/deref problems. */
    URLFetchExtraMemoryLock(result.extraData) ;
    p_request = URLFetchExtraMemoryDeref(result.extraData) ;
    memcpy(&request, p_request, sizeof(request)) ;
    URLFetchExtraMemoryUnlock(result.extraData) ;
    URLFetchExtraMemoryFree(result.extraData) ;
    EC( NamePoolIsTokenValid(namePool, request.nameT, TRUE) ; )

    temporary = (result.retType & URB_RF_NOCACHE)
@ifdef CACHE_ALL
    && !G_cacheAll
@endif
    ;
    ret = URLRequestGetRet(result.retType);

    /* A fetch acknowledgement can arrive after the import abort barrier. */
#if PROGRESS_DISPLAY
    if(request.progressCanceled ||
       ((G_stopped || pself->UTI_doomed ||
         request.imageGeneration != pself->UTI_imageGeneration) &&
        ret != URL_RET_PROGRESS && ret != URL_RET_PROGRESS_ABORT))
#else
    if(G_stopped || pself->UTI_doomed ||
       request.imageGeneration != pself->UTI_imageGeneration)
#endif
    {
        if(ret == URL_RET_MESSAGE && OptrToHandle(result.htmlMsg) &&
            OptrToChunk(result.htmlMsg) == 0)
            MemFree(OptrToHandle(result.htmlMsg));
        if(temporary &&
            (ret == URL_RET_FILE || ret == URL_RET_PROGRESS))
            FileDelete(result.curHTML);
        if(request.imageGeneration == pself->UTI_imageGeneration)
            @call oself::MSG_URL_TEXT_INTERNAL_CANCEL_LIKE_GRAPHICS(
                request.nameT);
        else
            NamePoolReleaseToken(namePool, request.nameT);
        @call oself::MSG_URL_TEXT_DEC_PENDING();
        NamePoolReleaseToken(namePool, result.url);
        return;
    }

#ifdef CACHE_VALIDATION
    /* If the item has not been modified on the server, we can still
       try to get it from the object cache rather than importing it
       once again. */
    if(URLRequestGetRet(result.retType) == URL_RET_FILE &&
        result.retType & URB_RF_UNTOUCHED)// "Not modified"
    {
        /* Find out if object was cached. This time, we don't care about
           expiration since we have an authoritative statement from the
           server. */
        oct = ObjCacheFindURL(OCT_GSTRING, request.nameT, TRUE, FALSE);
    }
    else
        oct = OCT_NULL;                   // No existing item to reuse

    if(oct)
    {
        /* Replace the images. Cache and Name token are released by receiver */
        @call oself::MSG_URL_TEXT_INTERNAL_REPLACE_LIKE_GRAPHICS(oct,
            request.nameT, 0, 0xFFFF);
        @call oself::MSG_URL_TEXT_DEC_PENDING() ;
    }
    else
#endif
        if(URLRequestGetRet(result.retType) == URL_RET_FILE)
        {                                   /* loaded image successfully */
            /* Put in a request to import the image */
#if PROGRESS_DISPLAY
            /* URL_RET_FILE is returned for non-loading progress graphics, just
               import without loading progress */
            importQueued = ImportThreadRequestImportGraphic(
                oself,
                request.nameT,
                result.mimeType,
                result.curHTML,
                ((result.retType & URB_RF_NOCACHE)
@ifdef CACHE_ALL
                    && !G_cacheAll
@endif
                    ), OCT_NULL, NULL) ;
            if(!importQueued)
            {
                if(temporary)
                    FileDelete(result.curHTML);
                @call oself::MSG_URL_TEXT_INTERNAL_GRAPHIC_FAILED(
                    request.nameT, request.imageGeneration);
                @call oself::MSG_URL_TEXT_DEC_PENDING();
            }
        } else if (URLRequestGetRet(result.retType) == URL_RET_PROGRESS ||
            URLRequestGetRet(result.retType) == URL_RET_PROGRESS_ABORT) {
            /* nothing to do here */
#else
            importQueued = ImportThreadRequestImportGraphic(
                oself,
                request.nameT,
                result.mimeType,
                result.curHTML,
                ((result.retType & URB_RF_NOCACHE)
@ifdef CACHE_ALL
                    && !G_cacheAll
@endif
                    ), OCT_NULL) ;
            if(!importQueued)
            {
                if(temporary)
                    FileDelete(result.curHTML);
                @call oself::MSG_URL_TEXT_INTERNAL_GRAPHIC_FAILED(
                    request.nameT, request.imageGeneration);
                @call oself::MSG_URL_TEXT_DEC_PENDING();
            }
#endif
        } else {
            /* Does not appear to have come in correctly.  Release it */
            /* If a message make sure we free the message block. We should */
            /* NOT free a message that isn't located at the start of its own */
            /* memory block, because it is stored in one of our string table */
            /* resources, where message are held in localizable LMem chunks. */
            if (ret == URL_RET_MESSAGE)
                if (OptrToHandle(result.htmlMsg) && OptrToChunk(result.htmlMsg)==0)
                    MemFree(OptrToHandle(result.htmlMsg)) ;
            if(ret == URL_RET_ABORTED ||
                (ret == URL_RET_MESSAGE && result.htmlMsg == NullOptr))
                @call oself::MSG_URL_TEXT_INTERNAL_CANCEL_LIKE_GRAPHICS(
                    request.nameT);
            else
                @call oself::MSG_URL_TEXT_INTERNAL_GRAPHIC_FAILED(
                    request.nameT, request.imageGeneration);
            @call oself::MSG_URL_TEXT_DEC_PENDING() ;
        }

    /* finished with URL */
    NamePoolReleaseToken(namePool, result.url);
}

/* Derive native image geometry and transforms from authored and decoded sizes. */
void _pascal URLTextInitializeImage(
    optr oself,
    HTMLimageData *p,
    ImageAdditionalData *iad)
{
    HTMLTextInstance *textP;
    dword horizontalSpace;
    word maxWidth;
    WWFixedAsDWord maxScale, fitScale;

    p->HID_IADType = iad->IAD_type;

    /*
     * rescale image in horizontal direction if required, by
     * putting the appropriate scaling factor into the
     * transformation matrix for the GString
     */
    if(p->size.XYS_width && iad->IAD_size.XYS_width)
    {
        *(WWFixedAsDWord *)&p->HID_tmatrixE11 =
            GrUDivWWFixed(
                MakeWWFixed(p->size.XYS_width),
                MakeWWFixed(iad->IAD_size.XYS_width));

#ifdef COMPILE_OPTION_LIMIT_SCALING
        /* Maximum scaling */
        if (p->HID_tmatrixE11.WWF_int>=32)  {
            p->HID_tmatrixE11.WWF_int = 32 ;
            p->HID_tmatrixE11.WWF_frac = 0 ;
        }
#endif
    }
    else
    {
        *(WWFixedAsDWord *)&p->HID_tmatrixE11 = MakeWWFixed(1);
    }

    /*
     * rescale image in vertical direction if required
     */
    if(p->size.XYS_height && iad->IAD_size.XYS_height)
    {
        *(WWFixedAsDWord *)&p->HID_tmatrixE22 =
            GrUDivWWFixed(
                MakeWWFixed(p->size.XYS_height),
                MakeWWFixed(iad->IAD_size.XYS_height));

#ifdef COMPILE_OPTION_LIMIT_SCALING
        /* Maximum scaling */
        if (p->HID_tmatrixE22.WWF_int>=32)  {
            p->HID_tmatrixE22.WWF_int = 32 ;
            p->HID_tmatrixE22.WWF_frac = 0 ;
        }
#endif
    }
    else                                /* no height given, maintain aspect */
    {
        p->HID_tmatrixE22 = p->HID_tmatrixE11;
    }

    if(!p->size.XYS_width)              /* no width given, maintain aspect */
        p->HID_tmatrixE11 = p->HID_tmatrixE22;

    /* Fit inline images before deriving both layout and drawing geometry. */
    if (p->pos < HTML_IMAGE_POS_RESERVED &&
        @call NavigateFitToWindow::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS()) {
        textP = ObjDerefVis(oself);
        if (!(textP->HTI_state & HTS_VIEW_NOT_OPENED) &&
            textP->HTI_viewWidth && iad->IAD_size.XYS_width) {
            horizontalSpace = (dword)textP->HTI_pageLeftMargin + 1 +
                2L * p->hspace;
            /* ATTENTION: margins/spacing can exceed the viewport themselves.
             * Keep a one-pixel image; fixing that requires layout changes.
             */
            maxWidth = horizontalSpace < textP->HTI_viewWidth ?
                textP->HTI_viewWidth - horizontalSpace : 1;
            /* Compare scales: a height-only width can overflow WWFixed. */
            maxScale = GrUDivWWFixed(MakeWWFixed(maxWidth),
                MakeWWFixed(iad->IAD_size.XYS_width));
            if (*(WWFixedAsDWord *)&p->HID_tmatrixE11 > maxScale) {
                fitScale = GrUDivWWFixed(maxScale,
                    *(WWFixedAsDWord *)&p->HID_tmatrixE11);
                *(WWFixedAsDWord *)&p->HID_tmatrixE11 = GrMulWWFixed(
                    *(WWFixedAsDWord *)&p->HID_tmatrixE11, fitScale);
                *(WWFixedAsDWord *)&p->HID_tmatrixE22 = GrMulWWFixed(
                    *(WWFixedAsDWord *)&p->HID_tmatrixE22, fitScale);
                /* Keep inverse scales representable at the one-pixel floor. */
                if (*(WWFixedAsDWord *)&p->HID_tmatrixE11 < 2)
                    p->HID_tmatrixE11.WWF_frac = 2;
                if (*(WWFixedAsDWord *)&p->HID_tmatrixE22 < 2)
                    p->HID_tmatrixE22.WWF_frac = 2;
            }
        }
    }

    /*
     * actual size follows from scaling factor and raw image size
     */
    p->HID_size.XYS_width =
        RoundWWF(GrMulWWFixed(
            MakeWWFixed(iad->IAD_size.XYS_width),
            *(WWFixedAsDWord *)
            &p->HID_tmatrixE11));
    if (p->HID_size.XYS_width == 0)
        p->HID_size.XYS_width = 1 ;

    p->HID_size.XYS_height =
        RoundWWF(GrMulWWFixed(
            MakeWWFixed(iad->IAD_size.XYS_height),
            *(WWFixedAsDWord *)
            &p->HID_tmatrixE22));
    if (p->HID_size.XYS_height == 0)
        p->HID_size.XYS_height = 1 ;

    /*
     * set origin of image
     */
    p->HID_drawOffset.XYO_x = -RoundWWF(GrMulWWFixed(
        MakeWWFixed(iad->IAD_origin.P_x),
        *(WWFixedAsDWord *)
        &p->HID_tmatrixE11));

    p->HID_drawOffset.XYO_y = -RoundWWF(GrMulWWFixed(
        MakeWWFixed(iad->IAD_origin.P_y),
        *(WWFixedAsDWord *)
        &p->HID_tmatrixE22));

    /*
     * set animation related fields
     */
    p->HID_frame = HTML_ANIMATION_VAR_FRAME_NOT_STARTED ;
    p->HID_loopCount = 0 ;              /* Not looped any */
}

/* Attach the cached graphic and initialize native image geometry. */
void IReplaceGraphic(optr oself, ObjCacheToken oct, HTMLimageData *p, word i,
    word invalFrom, word invalTo)
{
    VMFileHandle vmf;
    VMChain vmc;
    ImageAdditionalData iad;

    /* Add reference to entry in cache */
    ObjCacheLockItem(oct, &vmf, &vmc, &iad, sizeof(iad));

    p->HID_cacheToken = (dword)oct;
    p->HID_vmf = vmf;
    p->HID_vmb = VMCHAIN_GET_VM_BLOCK(vmc);

    URLTextInitializeImage(oself, p, &iad) ;
    @call oself::MSG_HTML_TEXT_RESOLVE_IMAGE(i, p, invalFrom, invalTo);
@ifdef JAVASCRIPT_SUPPORT
    @call oself::MSG_HTML_TEXT_FIRE_EVENT(HTML_EVENT_LOAD,
        HTML_EVENT_OBJECT_IMAGE, i);
@endif
}

/* Only final failures carry this request-generation check. Progress has a
   cache token and cancellation uses its separate cleanup message. */
@extern method URLTextClass, MSG_URL_TEXT_INTERNAL_GRAPHIC_FAILED
{
    extern Boolean G_stopped;

    if(generation != pself->UTI_imageGeneration || pself->UTI_doomed)
        NamePoolReleaseToken(namePool, url);
    else if(G_stopped)
        @call oself::MSG_URL_TEXT_INTERNAL_CANCEL_LIKE_GRAPHICS(url);
    else
        @call oself::MSG_URL_TEXT_INTERNAL_REPLACE_LIKE_GRAPHICS(
          OCT_NULL, url, 0, 0xFFFF);
}

/* Replace matching image records and release the supplied cache/name references. */
@extern method URLTextClass, MSG_URL_TEXT_INTERNAL_REPLACE_LIKE_GRAPHICS
{
    word i, j, n, size;
    HTMLimageData p, other, *imageP;
    optr imageArray = pself->HTI_imageArray;
    optr textPool = pself->HTI_namePool;
    optr frame = pself->UTI_frame;
    optr realFrame;
    dword generation = pself->UTI_imageGeneration;
    TCHAR name[1], *nameP;
    NameToken fallback, referer;
    Boolean retry, loading, objCache;
    extern Boolean G_stopped;

    n = @call oself::MSG_HTML_TEXT_GET_IMAGE_COUNT();
    for(i=0; i<n; i++) {
        if(((URLTextInstance *)ObjDerefVis(oself))->UTI_imageGeneration !=
           generation || !@call oself::MSG_HTML_TEXT_GET_IMAGE(i, &p))
            break;
        if(url != p.HID_resolvedURL)
            continue;

        /* Drop this image's previous (possibly progressive) cache reference.
           Clear the live handles before any synchronous replacement/retry. */
        MemLock(OptrToHandle(imageArray));
        imageP = ChunkArrayElementToPtr(imageArray, i, &size);
        imageP->HID_cacheToken = OCT_NULL;
        imageP->HID_vmf = imageP->HID_vmb = 0;
        MemUnlock(OptrToHandle(imageArray));
        if(p.HID_cacheToken)
            ObjCacheUnlockItem((ObjCacheToken)p.HID_cacheToken);
        p.HID_cacheToken = OCT_NULL;
        p.HID_vmf = p.HID_vmb = 0;

        if(oct != OCT_NULL) {
            IReplaceGraphic(oself, oct, &p, i, invalFrom, invalTo);
        } else {
            retry = FALSE;
            if(!G_stopped && frame &&
               !((URLTextInstance *)ObjDerefVis(oself))->UTI_doomed &&
               (p.flags & HTML_IDF_PICTURE_FALLBACK) && p.svgFile &&
               !(p.flags & (HTML_IDF_INLINE_SVG |
                            HTML_IDF_PICTURE_FALLBACK_USED))) {
                NamePoolCopy(textPool, name, sizeof(name), p.svgFile, &nameP);
                @call frame::MSG_URL_FRAME_COMPLETE_URL(&nameP);
                fallback = NamePoolTokenize(namePool, nameP, FALSE);
                NamePoolDestroyIfDynamic(nameP);
                p.flags |= HTML_IDF_PICTURE_FALLBACK_USED;
                if(fallback && fallback != url) {
                    p.HID_resolvedURL = fallback;
                    p.flags &= ~(HTML_IDF_RESOLVED | HTML_IDF_BROKEN |
                                 HTML_IDF_SIZE_DIRTY);
                    p.flags |= HTML_IDF_RESOLVING;
                    retry = TRUE;
                } else if(fallback) {
                    NamePoolReleaseToken(namePool, fallback);
                }
                MemLock(OptrToHandle(imageArray));
                imageP = ChunkArrayElementToPtr(imageArray, i, &size);
                *imageP = p;
                MemUnlock(OptrToHandle(imageArray));

                if(retry) {
                    /* The failure message still owns url while other images
                       sharing the primary are considered independently. */
                    NamePoolReleaseToken(namePool, url);
                    loading = FALSE;
                    for(j=0; j<n; j++) {
                        if(j != i &&
                           @call oself::MSG_HTML_TEXT_GET_IMAGE(j, &other) &&
                           other.HID_resolvedURL == fallback &&
                           (other.flags & HTML_IDF_RESOLVING)) {
                            loading = TRUE;
                            break;
                        }
                    }
                    if(!loading) {
                        realFrame = @call frame::MSG_URL_FRAME_FIND_REAL_FRAME();
                        referer = @call realFrame::MSG_URL_FRAME_GET_URL();
                        objCache = (@call SettingsBoolGroup::
                          MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS() &
                            HTMLV_OBJECT_CACHE);
                        /* INC_PENDING occurs before the primary's DEC. Cache
                           hits and synchronous failures need no new pending. */
                        ProcessSingleGraphic(&p, oself, referer, i,
                                             TRUE, FALSE, objCache, TRUE);
                        if(referer)
                            NamePoolReleaseToken(namePool, referer);
                    }
                }
            }
            if(!retry) {
                @call oself::MSG_HTML_TEXT_MARK_IMAGE_BROKEN(i);
@ifdef JAVASCRIPT_SUPPORT
                @call self::MSG_HTML_TEXT_FIRE_EVENT(HTML_EVENT_ERROR,
                  HTML_EVENT_OBJECT_IMAGE, i);
@endif
            }
        }
    }

    if(oct != OCT_NULL)
        ObjCacheUnlockItem(oct);
    NamePoolReleaseToken(namePool, url);
}

/* Retain complete images and reset incomplete matches before releasing the name. */
@extern method URLTextClass, MSG_URL_TEXT_INTERNAL_CANCEL_LIKE_GRAPHICS
{
    word i, n, size;
    HTMLimageData *imageP;
    optr imageArray;
    ImageAdditionalData iad;
    Boolean complete;

    imageArray = pself->HTI_imageArray;
    if(imageArray)
    {
        MemLock(OptrToHandle(imageArray));
        n = ChunkArrayGetCount(imageArray);
        for(i=0; i<n; i++)
        {
            imageP = ChunkArrayElementToPtr(imageArray, i, &size);
            if(url == imageP->HID_resolvedURL)
            {
                complete = FALSE;
                if(imageP->HID_cacheToken)
                {
                    ObjCacheLockItem(
                        (ObjCacheToken)imageP->HID_cacheToken,
                        (void *)0, (void *)0, &iad, sizeof(iad));
                    complete = iad.IAD_completeGraphic;
                    ObjCacheUnlockItem(
                        (ObjCacheToken)imageP->HID_cacheToken);
                }
                if(!complete &&
                    ((imageP->flags & HTML_IDF_RESOLVING) ||
                        imageP->HID_cacheToken))
                {
                    if(imageP->HID_cacheToken)
                        ObjCacheUnlockItem(
                            (ObjCacheToken)imageP->HID_cacheToken);
                    imageP->HID_cacheToken = OCT_NULL;
                    imageP->HID_vmf = 0;
                    imageP->HID_vmb = 0;
                    @call oself::MSG_HTML_TEXT_MARK_IMAGE_UNRESOLVED(i);
                    @call oself::MSG_HTML_TEXT_INVALIDATE_IMAGE(
                        (void *)0, i, 0, 0xFFFF);
                }
            }
        }
        MemUnlock(OptrToHandle(imageArray));
    }

    NamePoolReleaseToken(namePool, url);
}

@ifdef COMPILE_OPTION_PARENTAL_CONTROL

extern void PCAddRemoveHostFromURL(TCHAR *url, ParentalControlFlags *, Boolean add);

/* Apply parental-control additions to the page image URLs. */
@extern method URLTextClass, MSG_URL_TEXT_PC_ADD_EMBEDDED_SITES
{
    TCHAR url[HTML_STATIC_BUF], *p;
    optr imageArray = pself->HTI_imageArray;
    HTMLimageData *imageArrayElement;
    int i;
    word size;

    if (imageArray) {
        MemLock(OptrToHandle(imageArray));
        for (i = 0; i < ChunkArrayGetCount(imageArray); i++) {
            imageArrayElement = ChunkArrayElementToPtr(imageArray, i, &size);
            /* get image URL */
            NamePoolCopy(pself->HTI_namePool, url, sizeof(url),
                imageArrayElement->imageURL, &p);
            PCAddRemoveHostFromURL(p, pcFlags, TRUE);
            NamePoolDestroyIfDynamic(p);
        }
        MemUnlock(OptrToHandle(imageArray));
    }
}

/* Apply parental-control removals to the page image URLs. */
@extern method URLTextClass, MSG_URL_TEXT_PC_REMOVE_EMBEDDED_SITES
{
    TCHAR url[HTML_STATIC_BUF], *p;
    optr imageArray = pself->HTI_imageArray;
    HTMLimageData *imageArrayElement;
    int i;
    word size;

    if (imageArray) {
        MemLock(OptrToHandle(imageArray));
        for (i = 0; i < ChunkArrayGetCount(imageArray); i++) {
            imageArrayElement = ChunkArrayElementToPtr(imageArray, i, &size);
            /* get image URL */
            NamePoolCopy(pself->HTI_namePool, url, sizeof(url),
                imageArrayElement->imageURL, &p);
            PCAddRemoveHostFromURL(p, pcFlags, FALSE);
            NamePoolDestroyIfDynamic(p);
        }
        MemUnlock(OptrToHandle(imageArray));
    }
}

@endif

@ifdef JAVASCRIPT_SUPPORT
/* Replace a script-updated image through the ordinary near request helper. */
@extern method URLTextClass, MSG_URL_TEXT_CHANGE_GRAPHIC
{
    word size;
    TCHAR name[HTML_STATIC_BUF], *nP;
    HTMLimageData image, *p;
    ObjCacheToken previous;
    Boolean objCache;
    optr imageArray = pself->HTI_imageArray;
    optr frame = pself->UTI_frame;
    NameToken referer = NAME_POOL_NONE;
    optr realFrame = NullOptr;

    if(!imageArray || !@call oself::MSG_HTML_TEXT_GET_IMAGE(i, &image)) {
        NamePoolReleaseToken(namePool, url);
        return;
    }
    p = &image;

    if (frame) {
        realFrame = @call frame::MSG_URL_FRAME_FIND_REAL_FRAME();
    }

    /* Explicit source assignment disables this attachment's old fallback. */
    if(p->flags & HTML_IDF_PICTURE_FALLBACK)
        p->flags |= HTML_IDF_PICTURE_FALLBACK_USED;

    NamePoolCopy(namePool, name, sizeof(name), url, &nP);

    @call frame::MSG_URL_FRAME_COMPLETE_URL(&nP);
    /* make it an absolute canonical name */

    /* Did the URL change? Otherwise we don't have to reload it */
    if(!NamePoolTestEqual(namePool, p->HID_resolvedURL, nP))
    {
        NamePoolReleaseToken(namePool, p->HID_resolvedURL);
        p->HID_resolvedURL = NamePoolTokenize(namePool, nP, FALSE);
        previous = (ObjCacheToken)p->HID_cacheToken;
        p->HID_cacheToken = OCT_NULL;
        p->HID_vmf = p->HID_vmb = 0;
        p->flags &= ~(HTML_IDF_RESOLVED | HTML_IDF_BROKEN | HTML_IDF_SIZE_DIRTY);
        p->flags |= HTML_IDF_RESOLVING;
        MemLock(OptrToHandle(imageArray));
        *(HTMLimageData *)ChunkArrayElementToPtr(imageArray, i, &size) = *p;
        MemUnlock(OptrToHandle(imageArray));
        if(previous)
            ObjCacheUnlockItem(previous);

        /* set up referer (marked in-use by GET_URL) */
        if(frame)
            referer = @call realFrame::MSG_URL_FRAME_GET_URL();

        /* object cache enabled? */
        objCache = (@call SettingsBoolGroup::
            MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS() & HTMLV_OBJECT_CACHE);

        /* load graphic or get it from cache */
        ProcessSingleGraphic(p, oself, referer, i,  TRUE, FALSE, objCache, FALSE);

        /* release referer */
        if (referer != NAME_POOL_NONE)
            NamePoolReleaseToken(namePool, referer);
    } else {
        MemLock(OptrToHandle(imageArray));
        *(HTMLimageData *)ChunkArrayElementToPtr(imageArray, i, &size) = *p;
        MemUnlock(OptrToHandle(imageArray));
    }
    NamePoolDestroyIfDynamic(nP);

    /* We release this token here so the message can be safely sent */
    NamePoolReleaseToken(namePool, url);
}

/* Preload a script-requested image while retaining pending-count ownership. */
@extern method URLTextClass, MSG_URL_TEXT_PRELOAD_GRAPHIC
{
    TCHAR name[HTML_STATIC_BUF], *nP;
    Boolean objCache;
    optr frame = pself->UTI_frame;
    NameToken referer = NAME_POOL_NONE, fullURL;
    ObjCacheToken oct = NULL;
    optr realFrame = NullOptr;
    optr request;
    URLTextRequestGraphic *p_request;

    if (frame) {
        realFrame = @call frame::MSG_URL_FRAME_FIND_REAL_FRAME();
    }

    NamePoolCopy(namePool, name, sizeof(name), url, &nP);

    /* make it an absolute canonical name */
    @call frame::MSG_URL_FRAME_COMPLETE_URL(&nP);

    /* Did the URL change? Otherwise we don't have to reload it */
    fullURL = NamePoolTokenize(namePool, nP, FALSE);

    /* set up referer (marked in-use by GET_URL) */
    if(frame)
        referer = @call realFrame::MSG_URL_FRAME_GET_URL();

    /* object cache enabled? */
    objCache = (@call SettingsBoolGroup::
        MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS() & HTMLV_OBJECT_CACHE);
    /* load graphic if not already in cache */
    if (objCache) {
        /* non-locking so there is a chance that the item will be
           pushed out of the cache, or that the user will clear the
           cache before the image is used, oh well */
        oct = ObjCacheFindURL(OCT_GSTRING, fullURL, FALSE, TRUE);
    }
    if (oct == NULL) {
        /* decremented from acknowledge message handler */
        @call oself::MSG_URL_TEXT_INC_PENDING();
        request = URLFetchExtraMemoryAlloc(sizeof(URLTextRequestGraphic));
        URLFetchExtraMemoryLock(request);
        p_request = URLFetchExtraMemoryDeref(request);
        p_request->index = 0;  /* not used */
        p_request->imageGeneration =
            ((URLTextInstance *)ObjDerefVis(oself))->UTI_imageGeneration;
        p_request->nameT = fullURL;
        p_request->objCache = objCache;
#if PROGRESS_DISPLAY
        p_request->progressCanceled = FALSE;
#endif
        URLFetchExtraMemoryUnlock(request);
        URLFetchRequest(
            fullURL,
            ULM_CACHE,  /* use src cache */
            NullHandle,
            referer,
            oself,
            MSG_URL_TEXT_GRAPHIC_PRELOADED,
            request,
            NULL);
    } else {
        NamePoolReleaseToken(namePool, fullURL);
    }

    /* release referer */
    if (referer != NAME_POOL_NONE)
        NamePoolReleaseToken(namePool, referer);

    NamePoolDestroyIfDynamic(nP);

    /* We release this token here so the message can be safely sent */
    NamePoolReleaseToken(namePool, url);
}

/* Acknowledge a preload and perform its original import or abort cleanup. */
@extern method URLTextClass, MSG_URL_TEXT_GRAPHIC_PRELOADED
{
    URLTextRequestGraphic *p_request ;
    URLTextRequestGraphic request ;
    URLFetchResult *p_result ;
    URLFetchResult result ;
    Boolean importQueued;
    Boolean temporary;
    extern Boolean G_stopped;

    /* get result locally */
    p_result = MemLock(urlFetchMem);
    memcpy(&result, p_result, sizeof(result));
    MemFree(urlFetchMem);

    /* since we know this came from IMG tag, assume graphic */
    AssumeGraphic(result.mimeType);

    /* Copy over the request data to avoid lock/unlock/deref problems. */
    URLFetchExtraMemoryLock(result.extraData) ;
    p_request = URLFetchExtraMemoryDeref(result.extraData) ;
    memcpy(&request, p_request, sizeof(request)) ;
    URLFetchExtraMemoryUnlock(result.extraData) ;
    URLFetchExtraMemoryFree(result.extraData);

    temporary = (result.retType & URB_RF_NOCACHE)
@ifdef CACHE_ALL
    && !G_cacheAll
@endif
    ;

    /* import */
    if(G_stopped || pself->UTI_doomed ||
       request.imageGeneration != pself->UTI_imageGeneration)
    {
        if(temporary && URLRequestGetRet(result.retType) == URL_RET_FILE)
            FileDelete(result.curHTML);
        NamePoolReleaseToken(namePool, request.nameT);
        @call oself::MSG_URL_TEXT_DEC_PENDING();
    }
    else if(URLRequestGetRet(result.retType) == URL_RET_FILE &&
        !(result.retType & URB_RF_UNTOUCHED)) {
        importQueued = ImportThreadRequestImportGraphic(
            oself,
            request.nameT,
            result.mimeType,
            result.curHTML,
            ((result.retType & URB_RF_NOCACHE)
@ifdef CACHE_ALL
                && !G_cacheAll
@endif
                ), OCT_NULL, NULL) ;
        if(!importQueued)
        {
            if(temporary)
                FileDelete(result.curHTML);
            NamePoolReleaseToken(namePool, request.nameT);
            @call oself::MSG_URL_TEXT_DEC_PENDING();
        }
    } else {
        NamePoolReleaseToken(namePool, request.nameT);
        @call oself::MSG_URL_TEXT_DEC_PENDING();
    }

    /* clean up some error messages */
    if (URLRequestGetRet(result.retType) == URL_RET_MESSAGE) {
        if (OptrToHandle(result.htmlMsg) && OptrToChunk(result.htmlMsg)==0)
            MemFree(OptrToHandle(result.htmlMsg));
    }

    /* all done */
    NamePoolReleaseToken(namePool, result.url);
}

@endif
