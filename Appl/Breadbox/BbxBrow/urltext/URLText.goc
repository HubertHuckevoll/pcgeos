@extern method URLTextClass, MSG_URL_TEXT_GET_IMAGE_SOURCE_WIDTH;

/* Hold the shared cache file while native text storage is initialized. */
@method URLTextClass, MSG_HTML_TEXT_INIT_STORAGE
{
    AddCacheFileReference();            /* we're using the shared cache file */
    @callsuper();
}

/* Release the cache reference after native text storage is detached. */
@method URLTextClass, MSG_HTML_TEXT_DEINIT_STORAGE
{
    @callsuper();
    RemoveCacheFileReference();         /* detach from cache file */
}

