/*
 * Asynchronous image-decoding API implemented by mime/GraphicImport.goc.
 *
 * URLText submits a fetched file or loading-progress stream, together with
 * the destination text object and optional source-page cache owner. Workers
 * report progress/replacement back to URLText and release request resources.
 * The engine calls here start, abort and stop those workers; image fetching
 * uses the separate urlfetch.goh interface.
 */

/***********************************************************************
 *
 * PROJECT:	  HTMLView
 * FILE:      importg.goh
 *
 * AUTHOR:	  Lysle Shields
 *
 ***********************************************************************/

/* Private queued snapshot; no decoder or request pointers escape. */
typedef struct {
    optr textObj;
    NameToken name;
    ObjCacheToken cacheItem;
    VMFileHandle vmFile;
    VMBlockHandle bitmap;
    word firstLine, lastLine;
} ImportGraphicProgress;

word _pascal _export ImportGraphicInputCallback(void *clientDataP,
    ImageInputOperation operation, void *bufferP, word size);

/* Routines: */
Boolean ImportThreadEngineStart(void) ;
void ImportThreadEngineStop(void) ;
void ImportThreadAbortAll(void) ;
void ImportRemoveProgressDataFromQueue(MemHandle progressData);

/* NOTE:  The following thread does not block! */

Boolean ImportThreadRequestImportGraphic(
            optr textObj,
            NameToken name,
            TCHAR *mimeType,
            TCHAR *curHTML,
            Boolean temporary,
            ObjCacheToken pageOwner,
	    _LoadProgressParams_) ;
