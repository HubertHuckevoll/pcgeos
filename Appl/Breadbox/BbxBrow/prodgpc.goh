/*
 * Historical GPC browser feature selection, included by prodbbx.goh.
 *
 * These GOC options select that product's single-document UI, toolbar and
 * optional browser features. The current build uses consolidated options.goh.
 * GOC and C defines have different preprocessing behavior, which is why the
 * older configuration kept product-specific GOC commands in separate files.
 */

/***********************************************************************
 *
 * PROJECT:       HTMLView
 * FILE:          prodGPC.goh
 *
 * AUTHOR:        Martin Turon
 *
 ***********************************************************************/

#ifndef __PROD_GPC_H__
#define __PROD_GPC_H__

// Only used to define product specific goc @<commands>.

/* Turns off new/open/close from the file menu */
@define COMPILE_OPTION_CONTINUOUS_SINGLE_DOCUMENT
//@define COMPILE_OPTION_NO_NEW_OPEN_DIALOG
@define COMPILE_OPTION_FILE_OPEN_MENU

/* Always starts the browser with a new document. */
//@define COMPILE_OPTION_START_WITH_NEW

#endif

