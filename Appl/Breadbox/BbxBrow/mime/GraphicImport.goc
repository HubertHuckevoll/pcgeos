/*
 * Decode page images on worker threads while the browser stays responsive.
 *
 * URLTextImages.goc submits downloaded files; URLTextImageProgress.goc submits
 * streams that can be decoded during download. Requests rotate among import
 * workers, which call native MIME drivers and report progress or replacement
 * images to URLText. Each completion, including cancellation, releases request
 * resources and the fetch/import synchronization barrier. Page-cache references
 * keep source data alive even if the displayed page is detached.
 */


#ifdef __BORLANDC__
#pragma codeseg ImportG_TEXT
#endif
#ifdef __WATCOMC__
#pragma code_seg("ImportG_TEXT")
#endif

