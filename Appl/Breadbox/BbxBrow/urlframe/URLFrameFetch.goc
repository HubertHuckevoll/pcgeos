/*
 * URLFrameClass fetch/parser entrypoint. URLFRAME.goc owns the class and
 * registers these external methods; htmlview.goh declares the interface.
 * This file handles URL requests and post-data caching, owns pending external
 * files and fetch acknowledgements, and supplies parsing/error helpers plus
 * script callbacks and document.write parsing. Cleanup and token references
 * stay with the existing handlers. LOCAL helpers remain with their callers
 * to preserve their _near _pascal calling convention.
 *
 * Fetch/parser helpers use FRFETCH_TEXT. MSG_URL_FRAME_URL_FETCHED alone uses
 * FRFETCH2_TEXT because its code stays on the call stack throughout parsing.
 *
 * URLFramePage.goc handles received-page metadata, presentation, completion
 * and frame-view geometry in FRFETCH3_TEXT. Its embedded-audio completion
 * handler retains FRFETCH_TEXT and shares its string pool with the requester.
 * URLFrameNavigation.goc prepares URLs and initiates requests; URLFrameTree.goc
 * builds/restores frame trees; URLFrameScript.goc owns script contexts/events
 * and timers. Their external methods are also registered in URLFRAME.goc.
 */

/* we need this for the callbacks... */
#pragma option -WDE

/**************************************************************************
 *        Include files
 **************************************************************************/

