/*
 * Dynamic menu of recently visited pages or framesets.
 *
 * HTMLViewNavigation.goc supplies item labels and restores the selected
 * frame-tree snapshot. This list is shared recent history; each document's
 * Back/Forward stacks are managed separately by URLDocumentHistory.goc.
 */

@object GenInteractionClass HistoryMenu = {
@ifdef COMPILE_OPTION_HISTORY_ON_MENU_BAR
    GI_visMoniker = 'H',"History";
@else
    GI_visMoniker = 't',"History";
@endif
    GII_visibility = GIV_POPUP;
    GI_comp = @HistoryList;
}

@object GenDynamicListClass HistoryList = {
    GDLI_numItems = 0;
    GDLI_queryMsg = MSG_HMLVP_HISTORY_QUERY;
    GIGI_applyMsg = MSG_HMLVP_HISTORY_SELECT;
    GIGI_destination = process;
}
@visMoniker HistoryEmpty = "(none)";
