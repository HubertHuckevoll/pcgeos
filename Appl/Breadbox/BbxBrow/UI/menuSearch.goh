/*
 * Shortcuts to configured web search services.
 *
 * Each trigger sends its numbered search choice to HTMLViewNavigation.goc,
 * which reads the corresponding searchURL setting and loads it. These are
 * web destinations; finding text within the page uses the Edit menu controls.
 */

@object GenTriggerClass Search1 = {
    GI_visMoniker = 'G', "General Search" ;
    GTI_destination = process;
    GTI_actionMsg = MSG_HMLVP_SEARCH;
    ATTR_GEN_TRIGGER_ACTION_DATA = { 1 };
}

@object GenTriggerClass Search2 = {
    GI_visMoniker = 'P', "Person Search" ;
    GTI_destination = process;
    GTI_actionMsg = MSG_HMLVP_SEARCH;
    ATTR_GEN_TRIGGER_ACTION_DATA = { 2 };
}

@object GenTriggerClass Search3 = {
    GI_visMoniker = 'B', "Business Search" ;
    GTI_destination = process;
    GTI_actionMsg = MSG_HMLVP_SEARCH;
    ATTR_GEN_TRIGGER_ACTION_DATA = { 3 };
}

@object GenTriggerClass Search4 = {
    GI_visMoniker = 'H', "Search History" ;
    GTI_destination = process;
    GTI_actionMsg = MSG_HMLVP_SEARCH;
    ATTR_GEN_TRIGGER_ACTION_DATA = { 4 };
}
