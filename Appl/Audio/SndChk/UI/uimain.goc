/* Keep new data after the existing resources to preserve their IDs. */
@start SoundCheckStrings, data;

@chunk char TEXT_FOUND_SB_MONO[] = "Mono Sound Blaster found at address %X";
@localize { "Sound card detection result. Preserve %X: the hexadecimal base address (up to four digits)." 0-77 };

@chunk char TEXT_FOUND_SB_PRO[] = "Sound Blaster Pro found at address %X";
@localize { "Sound card detection result. Preserve %X: the hexadecimal base address (up to four digits)." 0-77 };

@chunk char TEXT_FOUND_SB_16[] = "Sound Blaster 16 found at address %X";
@localize { "Sound card detection result. Preserve %X: the hexadecimal base address (up to four digits)." 0-77 };

@chunk char TEXT_FOUND_SB_NONE[] = "No Sound Blaster-compatible sound card found.";
@localize { "Sound card detection failure; keep within the 80-byte display buffer." 0-79 };

@chunk char SCThreadError[] = "Cannot create the playback thread.";
@localize "Error when system resources are insufficient for sound testing.";

@chunk char SCStopText[] = "STOP";
@localize "Button that stops the repeated test sound.";

@chunk char completeString[] = "A .WAV file with the name \x01 was created in the Document folder.";
@localize "WAV file creation confirmation. Preserve the character with code 0x01: the filename substitution.";

@chunk char errorString[] = "An error occurred while creating the .WAV file.";
@localize "WAV test file creation error.";

@chunk char SCProgressFormat[] = "%d%%";
@localize { "WAV file creation progress. Preserve %d and %% in this order." 0-28 };

@chunk char TEXT_PLAY_ENDLESS[] = "Play Repeatedly";
@localize "Button label restored after a repeated test sound stops; match the Play Repeatedly button in the main window.";

@end SoundCheckStrings;
