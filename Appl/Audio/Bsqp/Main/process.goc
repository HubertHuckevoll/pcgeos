/////////////// Textchunks ////////////////////

@start  TEXTCHUNKRESOURCE,data;

@chunk  char    category[] = "QuickPlayer";
@localize not;
@chunk  char    optionsKey[] = "options";
@localize not;
@chunk  char    displayKey[] = "timeDisplay";
@localize not;

@chunk char BQOpenError[] = "Cannot open the audio file. It may be missing, in use, or inaccessible.";
@localize "Audio Player error: Cannot open a track.";
@chunk char BQThreadError[] = "Cannot start audio playback. There are not enough system resources.";
@localize "Audio Player error: Cannot create the playback thread.";
@chunk char BQDriverError[] = "A BestSound driver is required. Install or select BSD16 or BSD8ST.";
@localize "Audio Player error: No compatible audio driver. Preserve the BSD16 and BSD8ST driver names.";
@chunk char BQMemoryError[] = "There is not enough memory to open or play this audio file.";
@localize "Audio Player error: Insufficient memory to play a track.";
@chunk char BQBusyError[] = "Audio playback is busy. Stop other audio playback and try again.";
@localize "Audio Player error: Another playback request owns the sound device.";
@chunk char BQHardwareError[] = "Cannot configure the sound device for audio playback.";
@localize "Audio Player error: The sound device could not be configured.";
@chunk char BQReadError[] = "Cannot read the audio file. Check that its disk is available and try again.";
@localize "Audio Player error: The track could not be read from disk.";
@chunk char BQTruncatedError[] = "The audio data ends unexpectedly. The file may be incomplete or invalid.";
@localize "Audio Player error: The audio data ends before expected.";
@chunk char BQDataError[] = "The file contains no playable audio data, or its audio data is damaged or unsupported.";
@localize "Audio Player error: The input contains no supported audio data.";
@chunk char BQChangedError[] = "The MP3 sample rate or channel count changes within the file. This is not supported.";
@localize "Audio Player error: An MP3 changes its rate or channel count during playback.";
@chunk char BQFormatError[] = "This audio format or playback sample rate is not supported.";
@localize "Audio Player error: The audio format or sample rate cannot be played.";
@chunk char BQTimeoutError[] = "The previous audio playback did not stop in time. Try again.";
@localize "Audio Player error: Previous playback did not stop within the timeout.";
@chunk char BQFolderError[] = "Cannot read this folder or create the temporary track list.";
@localize "Audio Player error: Cannot read the selected folder or create its temporary track list.";
@chunk char BQLimitError[] = "This folder has too many audio files for the track list.";
@localize "Audio Player error: The folder contains more tracks than the track list can hold.";
@chunk char BQPathError[] = "The audio folder or filename is invalid or too long.";
@localize "Audio Player error: The selected audio path or filename is invalid.";
@chunk char BQPlaybackError[] = "Cannot play this audio file because of an unexpected audio error.";
@localize "Audio Player error: Unexpected playback failure.";

@chunk char BQBitsFormat[] = "%u Bit";
@localize { "Audio sample bit depth. Preserve %u: an unsigned number of up to five digits." 0-76 };
@chunk char BQMonoText[] = " MONO";
@localize { "One audio channel; the leading space is display padding." 0-79 };
@chunk char BQStereoText[] = "STEREO";
@localize { "Two audio channels, left and right." 0-79 };

@end    TEXTCHUNKRESOURCE;

/*%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %      Class & Message Definitions
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/

/*
 *  Class declarations
 */

@classdecl  BSQPProcessClass, neverSaved;
@extern method BSQPProcessClass, MSG_BSQP_LOAD_FOLDER;
@extern method BSQPProcessClass, MSG_BSQP_SCAN_FOLDER;
@extern method BSQPProcessClass, MSG_BSQP_READ_TAGS;
@extern method BSQPProcessClass, MSG_BSQP_TRACK_MONIKER;
@extern method BSQPProcessClass, MSG_BSQP_TRACK_ACTIVATE;

/***********************************************************************
 * MESSAGE:     MSG_PROCESS_BSQP_FINISHED
 * DESCRIPTION: Restore idle controls and report an audio error.
 * PARAMETERS:  result = playback/open result; serial = playback request.
 * STRATEGY:    The worker closes its file and releases playback first.
 *              Ignore stale results and advance only after a natural end.
 * KNOWN BUGS/SIDE EFFECTS/CAVEATS/IDEAS:
 *              Worker resources are released before this message.
 * REVISION HISTORY:
 *      Codex/MeyerK  11/05/26  Initial version
 ***********************************************************************/
@method BSQPProcessClass, MSG_PROCESS_BSQP_FINISHED
{
    optr text;

    if (!BQ_FinishPlayback(result, serial)) return;
    if (!playFlag) {
        @send PLAYTrigger::MSG_GEN_REPLACE_VIS_MONIKER_OPTR(@PlayMoniker, VUM_NOW);
        rmsValue = 0;
        RedrawStatus(0);
        RedrawRMS(0);
    }
    text = 0;
    switch (result) {
    case BSNW_STATUS_OK:
    case BSNW_ABORT: break;
    case BQ_ERROR_OPEN: text = @BQOpenError; break;
    case BQ_ERROR_THREAD: text = @BQThreadError; break;
    case BQ_ERROR_FOLDER: text = @BQFolderError; break;
    case BQ_ERROR_LIMIT: text = @BQLimitError; break;
    case BQ_ERROR_PATH: text = @BQPathError; break;
    case BSNW_WRONG_DRIVER: text = @BQDriverError; break;
    case BSNW_MEMORY_ERROR: text = @BQMemoryError; break;
    case BSNW_NOT_FREE: text = @BQBusyError; break;
    case BSNW_HARDWARE_NOT_READY: text = @BQHardwareError; break;
    case BSNW_READ_ERROR: text = @BQReadError; break;
    case BSNW_TRUNCATED: text = @BQTruncatedError; break;
    case BSNW_INVALID_DATA: text = @BQDataError; break;
    case BSNW_FORMAT_CHANGED: text = @BQChangedError; break;
    case BSNW_UNKNOWN_WAVE_FORMAT: text = @BQFormatError; break;
    case BSNW_TIMEOUT: text = @BQTimeoutError; break;
    default: text = @BQPlaybackError; break;
    }
    if (text)
        (void)UserStandardDialogOptr((char *)0, (void *)0, 0, 0, text,
                    (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
                    (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET));
}

/********************************************************

    MSG_GEN_PROCESS_OPEN_APPLICATION

 IN:     AppAttachFlags     attachFlags
         MemHandle      launchBlock
         MemHandle      extraState
 ********************************************************/

@method BSQPProcessClass, MSG_GEN_PROCESS_OPEN_APPLICATION
{
    MemHandle requestH;
    char *cat;
    DisplayScheme displayScheme;

    @callsuper();

    // Overwrite old Filename in Primary
    @call BSQPPrimary::MSG_GEN_REPLACE_VIS_MONIKER_TEXT("Audio Player",VUM_NOW);/**/

    ///////////// Loading settings from INI ////////////////////
    MemLock(HandleOf(@category));
    cat = LMemDeref(@category);

    // Options
    if (!InitFileReadInteger(cat,LMemDeref(@optionsKey),&bqOptions))
    {
        @call OptionsBooleans::MSG_GEN_BOOLEAN_GROUP_SET_GROUP_STATE(bqOptions,FALSE);
    };

    // Display
    if (!InitFileReadInteger(cat,LMemDeref(@displayKey),&bqDispStyle))
    {
        @call TimeDispList::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(bqDispStyle,FALSE);
    };

    MemUnlock(HandleOf(@category));

    @call FolderGlyph::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
        "Open a folder to list its MP3 and WAV files.", VUM_NOW);
    @call EmptyGlyph::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    @call TrackList::MSG_GEN_DYNAMIC_LIST_INITIALIZE(0);
    @call PLAYTrigger::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    if (launchBlock) {
        requestH = BQ_CopyLaunch(launchBlock);
        @send, forceQueue process::MSG_BSQP_LOAD_FOLDER(requestH);
    }

    // Backgroundcolor
    @call BSQPApp::MSG_GEN_APPLICATION_GET_DISPLAY_SCHEME( &displayScheme );
    if( ((byte)(displayScheme.DS_displayType) & DT_DISP_CLASS) > DC_GRAY_8)
    {
        backGroundColor = C_BLUE;
    }
    else
    {
        backGroundColor = C_BLACK;
    };

    // Start timer for display
    tih=TimerStart( TIMER_EVENT_CONTINUAL,
                    oself,
                    20,
                    MSG_PROCESS_TIMER_EVENT,
                    10,
                    &tid);

}

/************************************************************

    MSG_GEN_PROCESS_CLOSE_APPLICATION

    Function:

    IN:     -

    OUT:    -

 -----------------------------------------------------------*/

@method BSQPProcessClass, MSG_GEN_PROCESS_CLOSE_APPLICATION
{
    BQ_CloseFolder();
    BQ_StopPlayback();

    // wait until playing finished
    // ATTENTION: Could be reason for deadlock
    // if the playFlag will not be resetted by
    // the Play-Thread
    while (playFlag)
    {
        TimerSleep(10);
    };

    // Stop timer
    if (tih)
    {
        TimerStop(tih,tid);
    };

    return (@callsuper());
}

/***********************************************************************
    MSG_PROCESS_TIMER_EVENT for BSQPProcessClass

typedef struct {
    dword       BWPS_current;       // played Bytes
    dword       BWPS_full;      // Bytes to play
    byte        BWPS_level;     // "Levelmeter"
} BSWavPlayStates;

 ***********************************************************************/

@method BSQPProcessClass, MSG_PROCESS_TIMER_EVENT
{
    BSWavPlayStates states;
    word        level;

    BQ_PollPending();

    // request data about playing from library
    if (playFlag)
    {
        (void)BSNWaveGetPlayState(&states);
    }
    else
    {
        states.BWPS_level = 0;
        states.BWPS_current = 0;
        states.BWPS_full = 0;
    }

    // Timedisplay
    if (bqSampleBytes != states.BWPS_current)
    {
        bqSampleBytes = states.BWPS_current;
//            bqAllBytes = states.BWPS_full;

        if (bqSampleBytes>bqAllBytes)
        {
            bqSampleBytes = bqAllBytes;
        };

        RedrawTime(0);
    };

    // Levelmeter
    if (bqOptions & BQ_OPTION_LEVELMETER)
    {
        level = states.BWPS_level;
        if (level != rmsValue)
        {
            rmsValue = level<<1;
            RedrawRMS(0);
        };
    };
}

/***********************************************************************

    MSG_PROCESS_BSQP_STOP for BSQPProcessClass

    called by STOP-Trigger

 ***********************************************************************/

@method BSQPProcessClass, MSG_PROCESS_BSQP_STOP
{
    BQ_StopPlayback();
}

/**********************************************

    MSG_META_CONTENT_VIEW_WIN_OPENED

 Function:  store WindowHandle for display

 IN:     viewWin

 OUT:    winHan

 **********************************************/

@method BSQPProcessClass, MSG_META_CONTENT_VIEW_WIN_OPENED
{
    winHan = viewWindow;
}

/**********************************************

    MSG_META_CONTENT_VIEW_WIN_CLOSED

    Function:  delete WindowHandle

    IN:     -

    OUT:    -

 **********************************************/

@method BSQPProcessClass, MSG_META_CONTENT_VIEW_WIN_CLOSED
{
    winHan = 0;
}

/**********************************************

    MSG_META_EXPOSED

 Function:  redraw content of GenView

 IN:     -

 OUT:    -

 **********************************************/

@method BSQPProcessClass, MSG_META_EXPOSED
{
    GStateHandle gstate;

    gstate = GrCreateState(win);
    GrBeginUpdate(gstate);

    (void)RedrawSettings (gstate);
    RedrawRMS (gstate) ;
    RedrawTime (gstate);
    RedrawStatus(gstate);
    RedrawFileName(gstate);

    GrEndUpdate(gstate);
    GrDestroyState(gstate);
}

/**********************************************

    MSG_PROCESS_BSQP_PLAY

    Handler for PLAY/PAUSE-Trigger


 IN:    (glob)  playFlag
        1 = PLAY
                2 = PAUSE

 **********************************************/

@method BSQPProcessClass, MSG_PROCESS_BSQP_PLAY
{
    optr moniker = @PlayMoniker;

    if (playFlag)
    {
        if (bqStopRequested || !BSEXBSSTATUS(BSNWaveGetStatus())) return;

        // PAUSE on/off
        // the value of the playFlag is identically
        // to the mode parameter so we can use
        // the playflag for switching on/off
        (void)BSNWaveSetPause(playFlag);

        // toggle state
        if (playFlag == BQ_PLAYFLAG_PLAY)
        {
            // PLAY --> PAUSE
            playFlag = BQ_PLAYFLAG_PAUSE;
            moniker = @PlayMoniker;
        }
        else
        {
            // PAUSE --> PLAY
            playFlag = BQ_PLAYFLAG_PLAY;
            moniker = @PauseMoniker;
        };

        // Update the icon and text together.
        @send PLAYTrigger::MSG_GEN_REPLACE_VIS_MONIKER_OPTR(moniker,VUM_NOW);

        // update display
        RedrawStatus(0);
    }
    else
    {
        // Start playing
        BQ_PlaySelected();
    };
}

/**********************************************

    MSG_PROCESS_BSQP_OPEN

        Handler for "Open..." trigger

 **********************************************/

@method BSQPProcessClass, MSG_PROCESS_BSQP_OPEN
{
    MemHandle requestH;
    BQFolderRequest *requestP;

    requestH = MemAlloc(sizeof(BQFolderRequest), HF_DYNAMIC, HAF_ZERO_INIT);
    if (!requestH) {
        @send process::MSG_PROCESS_BSQP_FINISHED(BSNW_MEMORY_ERROR, bqPlaySerial);
        return;
    }
    requestP = MemLock(requestH);
    if (@call WavFileSelector::MSG_GEN_PATH_GET(requestP->path,
                                              sizeof(requestP->path))) {
        MemUnlock(requestH);
        MemFree(requestH);
        @send process::MSG_PROCESS_BSQP_FINISHED(BQ_ERROR_PATH, bqPlaySerial);
        return;
    }
    requestP->disk = @call WavFileSelector::MSG_GEN_PATH_GET_DISK_HANDLE();
    MemUnlock(requestH);
    @call FileSelectorBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    @send, forceQueue process::MSG_BSQP_LOAD_FOLDER(requestH);
}

/**********************************************

    MSG_BSQP_TIME_DISP_LIST_APPLY

    IN: word    selection
        word    numSelections
        byte    stateFlags

 **********************************************/

@method BSQPProcessClass, MSG_BSQP_TIME_DISP_LIST_APPLY
{
    bqDispStyle = selection;

    RedrawTime(0);
}

/**********************************************

    MSG_BSQP_OPTIONS_APPLY

 IN:    word    selectedBoolean
        word    indeterminateBooleans
        word    modifiedBooleans

 **********************************************/

@method BSQPProcessClass, MSG_BSQP_OPTIONS_APPLY
{
    word oldOptions;

    oldOptions = bqOptions;
    bqOptions = selectedBooleans;
    if ((bqOptions & BQ_OPTION_SHUFFLE) && !(oldOptions & BQ_OPTION_SHUFFLE))
        BQ_ResetShuffle();
}

/**********************************************

    MSG_META_SAVE_OPTIONS

 **********************************************/

@method BSQPProcessClass, MSG_META_SAVE_OPTIONS
{
    char    *cat;
    char    *key;

    MemLock(HandleOf(@category));

    // Options
    cat = LMemDeref(@category);
    key = LMemDeref(@optionsKey);
    InitFileWriteInteger(cat,key,bqOptions);

    // Timedisplay
    InitFileWriteInteger(cat,LMemDeref(@displayKey),bqDispStyle);

    MemUnlock(HandleOf(@category));

    InitFileSave();
}

