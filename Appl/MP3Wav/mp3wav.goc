/* Thin MP3Dec client for PC/GEOS Ensemble. No decoder internals belong here. */
@include <stdapp.goh>
@include <Objects/gFSelC.goh>
#include <file.h>
#include <heap.h>
#include <timer.h>
#include <Ansi/stdio.h>
#include <Ansi/string.h>
#include <bsnaudio.h>

#define CONVERT_PCM_BYTES 2048
#include "wavwriter.h"

@class Mp3WavProcessClass, GenProcessClass;
@message void MSG_MP3WAV_CONVERT();
@message void MSG_MP3WAV_CANCEL();
@message void MSG_MP3WAV_STEP(word generation);
@endc;
@classdecl Mp3WavProcessClass, neverSaved;

@start AppResource;
@object GenApplicationClass Mp3WavApp = {
    GI_visMoniker = "MP3 to WAV";
    GI_comp = @Mp3WavPrimary;
    gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) = @Mp3WavPrimary;
}
@end AppResource;

@start Interface;
@object GenPrimaryClass Mp3WavPrimary = {
    GI_comp = @SourceSelector, @OutputName, @Progress, @Status, @Timing, @Buttons;
    HINT_SIZE_WINDOW_AS_DESIRED;
}
@object GenFileSelectorClass SourceSelector = {
    ATTR_GEN_FILE_SELECTOR_NAME_MASK = { "*.MP3" };
    HINT_FILE_SELECTOR_NUMBER_OF_FILES_TO_SHOW = 8;
    HINT_FILE_SELECTOR_FILE_LIST_WIDTH = 40;
}
@object GenTextClass OutputName = {
    GI_visMoniker = "WAV filename (DOS 8.3, in the selected folder):";
    GTXI_text = "convert.wav";
    GTXI_attrs = @default | GTA_SINGLE_LINE_TEXT;
    GTXI_maxLength = 12;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}
@object GenValueClass Progress = {
    GI_visMoniker = "Progress (%):";
    GVLI_maximum = MakeWWFixed(100);
    GI_attrs = @default | GA_READ_ONLY;
}
@object GenTextClass Status = {
    GTXI_text = "Select an MP3 file and a new WAV filename.";
    GI_attrs = @default | GA_READ_ONLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}
@object GenTextClass Timing = {
    GI_visMoniker = "Conversion time versus audio duration:";
    GTXI_text = "-- / --";
    GI_attrs = @default | GA_READ_ONLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}
@object GenInteractionClass Buttons = {
    GI_comp = @Convert, @Cancel;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
}
@object GenTriggerClass Convert = {
    GI_visMoniker = "Convert";
    GTI_destination = process;
    GTI_actionMsg = MSG_MP3WAV_CONVERT;
}
@object GenTriggerClass Cancel = {
    GI_visMoniker = "Cancel";
    GI_states = @default & ~GS_ENABLED;
    GTI_destination = process;
    GTI_actionMsg = MSG_MP3WAV_CANCEL;
}
@end Interface;

/* Process-class variables are globals. Only the process thread uses this job. */
static struct {
    FileHandle sourceH;
    FileHandle outputH;
    BSNMP3Dec decoder;
    MemHandle bufferH;
    DiskHandle diskH;
    PathName path;
    FileLongName sourceName;
    FileLongName outputName;
    WavWriter writer;
    dword startTicks;
    dword total;
    word active;
    word generation;
    word progress;
} job;

static void _pascal
SetStatus(const char *textP)
{
    @call Status::MSG_VIS_TEXT_REPLACE_ALL_PTR(textP, 0);
}

static void _pascal
Finish(word success, const char *textP)
{
    word deleteError;
    dword ticks, samples, rate;
    char timing[48];

    job.active = 0;
    if (success && (!job.writer.fileH || !job.writer.bytes ||
                    WavWriterFinish(&job.writer))) {
        success = 0;
        textP = "Unable to finalize WAV file.";
    }
    BSNMP3DecClose(&job.decoder);
    if (job.bufferH) MemFree(job.bufferH);
    job.bufferH = NullHandle;
    if (job.sourceH) FileClose(job.sourceH, FALSE);
    job.sourceH = NullHandle;
    if (job.outputH) {
        if (FileClose(job.outputH, FALSE)) {
            success = 0;
            textP = "Error closing WAV file.";
        }
        job.outputH = NullHandle;
        if (!success) {
            FilePushDir();
            deleteError = !FileSetCurrentPath(job.diskH, job.path);
            if (!deleteError) deleteError = FileDelete(job.outputName);
            FilePopDir();
            if (deleteError) textP = "Error: remove the incomplete WAV file manually.";
        }
    }
    if (success) {
        /* Include file I/O and queued UI work, through closing the WAV. */
        ticks = TimerGetCount() - job.startTicks;
        samples = job.writer.bytes / (job.writer.format.channels * 2);
        rate = job.writer.format.sampleRate;
        sprintf(timing, "%lu.%02u s / %lu.%02u s",
                ticks / 60UL, (word)((ticks % 60UL) * 100UL / 60UL),
                samples / rate, (word)((samples % rate) * 100UL / rate));
        @call Timing::MSG_VIS_TEXT_REPLACE_ALL_PTR(timing, 0);
        @call Progress::MSG_GEN_VALUE_SET_INTEGER_VALUE(100, FALSE);
    } else {
        @call Timing::MSG_VIS_TEXT_REPLACE_ALL_PTR("Incomplete", 0);
    }
    SetStatus(textP);
    @call Convert::MSG_GEN_SET_ENABLED(VUM_NOW);
    @call Cancel::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
}

@method Mp3WavProcessClass, MSG_MP3WAV_CONVERT
{
    dword selection;
    word length, i;
    int result;

    if (job.active) return;
    selection = @call SourceSelector::MSG_GEN_FILE_SELECTOR_GET_SELECTION(job.sourceName);
    if ((GFS_GET_ENTRY_FLAGS(selection) & GFSEF_NO_ENTRIES) ||
        GFS_GET_ENTRY_TYPE(GFS_GET_ENTRY_FLAGS(selection)) != GFSET_FILE) {
        SetStatus("Select an MP3 file first.");
        return;
    }
    length = @call OutputName::MSG_VIS_TEXT_GET_ALL_PTR(job.outputName);
    if (!length || job.outputName[length-1] == '.' || job.outputName[length-1] == ' ') {
        SetStatus("Enter a new WAV filename.");
        return;
    }
    for (i = 0; i < length; i++) {
        if ((byte)job.outputName[i] < 32 || strchr("\\/:*?\"<>|", job.outputName[i])) {
            SetStatus("Use a filename without a path or wildcard characters.");
            return;
        }
    }
    @call SourceSelector::MSG_GEN_PATH_GET(job.path, sizeof(job.path));
    job.diskH = @call SourceSelector::MSG_GEN_PATH_GET_DISK_HANDLE();
    memset(&job.writer, 0, sizeof(job.writer));
    @call Timing::MSG_VIS_TEXT_REPLACE_ALL_PTR("Converting...", 0);
    job.startTicks = TimerGetCount();
    FilePushDir();
    if (FileSetCurrentPath(job.diskH, job.path)) {
        job.sourceH = FileOpen(job.sourceName, FILE_ACCESS_R | FILE_DENY_W);
        if (job.sourceH) {
            /* Exclusive creation protects existing files, including the source. */
            job.outputH = FileCreate(job.outputName,
                         FCF_NATIVE | FILE_CREATE_ONLY | FILE_ACCESS_RW | FILE_DENY_RW, 0);
        }
    }
    FilePopDir();
    if (!job.sourceH || !job.outputH) {
        Finish(0, "Cannot open files. Use a new DOS 8.3 WAV filename.");
        return;
    }
    job.total = FileSize(job.sourceH);
    job.bufferH = MemAlloc(CONVERT_PCM_BYTES, HF_SWAPABLE, HAF_ZERO_INIT);
    if (!job.bufferH) {
        Finish(0, "Not enough memory.");
        return;
    }
    result = BSNMP3DecOpen(&job.decoder, job.sourceH);
    if (result != BSNW_STATUS_OK || job.decoder.damaged) {
        Finish(0, result == BSNW_MEMORY_ERROR ? "Not enough memory." :
               "Invalid or truncated MP3. Output removed.");
        return;
    }
    if (WavWriterBegin(&job.writer, job.outputH, &job.decoder.source.format)) {
        Finish(0, "Unable to write WAV header.");
        return;
    }
    job.active = 1;
    job.generation++;
    @call Convert::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    @call Cancel::MSG_GEN_SET_ENABLED(VUM_NOW);
    job.progress = 0;
    @call Progress::MSG_GEN_VALUE_SET_INTEGER_VALUE(0, FALSE);
    SetStatus("Converting...");
    @send, forceQueue process::MSG_MP3WAV_STEP(job.generation);
}

@method Mp3WavProcessClass, MSG_MP3WAV_STEP
{
    sword *bufferP;
    word count, error, progress;
    dword position;

    if (!job.active || generation != job.generation) return;
    bufferP = MemLock(job.bufferH);
    count = BSNMP3DecReadPCM(&job.decoder, bufferP, CONVERT_PCM_BYTES);
    error = 0;
    if (count != BSN_PCM_READ_ERROR && count && !job.decoder.damaged)
        error = WavWriterAppend(&job.writer, bufferP,
                  count / job.decoder.source.format.blockAlign,
                  &job.decoder.source.format);
    MemUnlock(job.bufferH);
    if (count == BSN_PCM_READ_ERROR || job.decoder.damaged) {
        Finish(0, "Invalid, truncated, or changing-format MP3. Output removed.");
        return;
    }
    if (error) {
        Finish(0, "File write error or WAV size limit reached.");
        return;
    }
    if (!count) {
        Finish(1, "Conversion complete.");
        return;
    }
    position = FilePos(job.sourceH, 0, FILE_POS_RELATIVE);
    if (position == 0xffffffffUL) {
        Finish(0, "File position error. Output removed.");
        return;
    }
    progress = (word)(position / (job.total / 100 + 1));
    if (progress != job.progress) {
        job.progress = progress;
        @call Progress::MSG_GEN_VALUE_SET_INTEGER_VALUE(progress, FALSE);
    }
    /* Unwind this handler before executing the next same-thread step. */
    @send, forceQueue process::MSG_MP3WAV_STEP(job.generation);
}

@method Mp3WavProcessClass, MSG_MP3WAV_CANCEL
{
    if (job.active) Finish(0, "Cancelled. Incomplete output removed.");
}

@method Mp3WavProcessClass, MSG_GEN_PROCESS_CLOSE_APPLICATION
{
    if (job.active) Finish(0, "Cancelled.");
    return @callsuper();
}
