@include <stdapp.goh>
@include <Objects/clipbrd.goh>
#include <vm.h>
#include <xlatLib.h>
#include <string.h>
#include <extgraph.h>
#include <pnglib.h>
#include "markdown.h"
@include <html4par.goh>

#define MD_EXPORT_LINE 2048
#define MD_EXPORT_OUTPUT 6656
#define MD_EXPORT_BUFFERS (MD_EXPORT_OUTPUT + 2 * MD_EXPORT_LINE)

#define MD_KIND_BOLD 0x01
#define MD_KIND_ITALIC 0x02
#define MD_KIND_CODE 0x04

typedef struct {
    optr textObj;
    FileHandle output;
    ExportFrame *frameP;
    MemHandle buffersH;
    char *renderedP;
    char *lineP;
    byte *kindsP;
    word unicode[256];
    VMFileHandle vmFile;
    MemHandle charElementsH;
    optr charElementArray;
    TextRunArrayElement *nextRunP;
    word currentToken;
    dword imageNumber;
    Boolean attrsValid;
    Boolean quote;
} MDExportState;

TransError MDWrite(FileHandle output, const char *dataP, word length)
{
    word written;

    written = FileWrite(output, dataP, length, FALSE);
    return (written == length) ? TE_NO_ERROR : TE_FILE_WRITE;
}

void MDAddUnicode(MDExportState *stateP, word unicode)
{
    int mapped;

    mapped = HTMLTranslateCharNum(unicode);
    if (mapped > 0 && mapped < 256 && stateP->unicode[mapped] == 0) {
        stateP->unicode[mapped] = unicode;
    }
}

void MDInitUnicode(MDExportState *stateP)
{
    static const word extra[] = {
        0x0152, 0x0153, 0x0160, 0x0161, 0x0178,
        0x2013, 0x2014, 0x2018, 0x2019, 0x201c, 0x201d,
        0x2020, 0x2021, 0x2022, 0x2026, 0x2030, 0x2122
    };
    word value;
    word index;

    for (value = 32; value < 128; ++value) {
        stateP->unicode[value] = value;
    }
    stateP->unicode[C_TAB] = C_TAB;
    for (value = 160; value < 256; ++value) {
        MDAddUnicode(stateP, value);
    }
    for (index = 0; index < sizeof(extra) / sizeof(extra[0]); ++index) {
        MDAddUnicode(stateP, extra[index]);
    }
    /* GEOS uses the universal currency slot for the euro. */
    stateP->unicode[C_CURRENCY] = 0x20ac;
}

Boolean MDPutByte(MDExportState *stateP, word *posP, byte value)
{
    if (*posP >= MD_EXPORT_OUTPUT) {
        return FALSE;
    }
    stateP->renderedP[(*posP)++] = value;
    return TRUE;
}

Boolean MDPutString(MDExportState *stateP, word *posP, const char *valueP)
{
    while (*valueP != C_NULL) {
        if (!MDPutByte(stateP, posP, *valueP++)) {
            return FALSE;
        }
    }
    return TRUE;
}

Boolean MDPutNumber(MDExportState *stateP, word *posP, dword value)
{
    char digits[10];
    word count;

    count = 0;
    do {
        digits[count++] = '0' + (byte)(value % 10);
        value /= 10;
    } while (value != 0);
    while (count != 0) {
        if (!MDPutByte(stateP, posP, digits[--count])) {
            return FALSE;
        }
    }
    return TRUE;
}

Boolean MDPutChar(MDExportState *stateP, word *posP, byte value)
{
    word unicode;

    unicode = stateP->unicode[value];
    if (unicode == 0) {
        unicode = '?';
    }
    if (unicode < 0x80) {
        return MDPutByte(stateP, posP, (byte)unicode);
    }
    if (unicode < 0x800) {
        return MDPutByte(stateP, posP, 0xc0 | (unicode >> 6)) &&
               MDPutByte(stateP, posP, 0x80 | (unicode & 0x3f));
    }
    return MDPutByte(stateP, posP, 0xe0 | (unicode >> 12)) &&
           MDPutByte(stateP, posP, 0x80 | ((unicode >> 6) & 0x3f)) &&
           MDPutByte(stateP, posP, 0x80 | (unicode & 0x3f));
}

TransError MDExtGraphError(EGError error)
{
    switch (error) {
    case EGE_BLOCK_LOCKING_FAILURE:
    case EGE_CANT_CREATE_BITMAP:
        return TE_OUT_OF_MEMORY;
    case EGE_ILLEGAL_BITMAP_SIZE:
        return TE_INVALID_FORMAT;
    default:
        return TE_EXPORT_ERROR;
    }
}

TransError MDPngError(PngError error)
{
    switch (error) {
    case PE_WRITE_PROBLEM:
        return TE_FILE_WRITE;
    case PE_BLOCK_LOCK_FAILURE:
    case PE_OUT_OF_MEMORY:
        return TE_OUT_OF_MEMORY;
    case PE_INVALID_BITMAP:
        return TE_EXPORT_ERROR;
    default:
        return TE_ERROR;
    }
}

Boolean MDMakeImageName(const char *documentNameP, dword number,
                        char *nameP)
{
    char digits[10];
    word digitCount;
    word documentLength;
    word stemLength;
    word lastDot;
    word prefixLimit;
    word source;
    word dest;
    byte value;

    digitCount = 0;
    do {
        digits[digitCount++] = '0' + (byte)(number % 10);
        number /= 10;
    } while (number != 0);
    /* ATTENTION: DOS 8.3 leaves six decimal digits when the name retains a
     * stem character and separator.  Use base-36 if a text object can ever
     * contain more than 999999 embedded GStrings.
     */
    if (digitCount > 6) {
        return FALSE;
    }

    documentLength = 0;
    lastDot = 0xffff;
    while (documentNameP[documentLength] != C_NULL) {
        if (documentNameP[documentLength] == '.') {
            lastDot = documentLength;
        }
        ++documentLength;
    }
    stemLength = (lastDot == 0xffff) ? documentLength : lastDot;
    prefixLimit = 8 - digitCount - 1;
    dest = 0;
    for (source = 0; source < stemLength && dest < prefixLimit; ++source) {
        value = (byte)documentNameP[source];
        if (!((value >= 'a' && value <= 'z') ||
              (value >= 'A' && value <= 'Z') ||
              (value >= '0' && value <= '9') ||
              value == '_' || value == '-')) {
            value = '_';
        }
        nameP[dest++] = value;
    }
    if (dest == 0) {
        nameP[dest++] = 'i';
    }
    nameP[dest++] = '-';
    while (digitCount != 0) {
        nameP[dest++] = digits[--digitCount];
    }
    nameP[dest++] = '.';
    nameP[dest++] = 'p';
    nameP[dest++] = 'n';
    nameP[dest++] = 'g';
    nameP[dest] = C_NULL;
    return TRUE;
}

TransError MDRasterizeGraphic(MDExportState *stateP,
                              VisTextGraphic *graphicP,
                              VMBlockHandle *bitmapP)
{
    dword chainSize;
    word vmBlocks;
    word dbItems;
    VMBlockHandle sourceBlock;
    VMBlockHandle renderedBlock;
    VMBlockHandle bitmapBlock;
    GStateHandle sourceGString;
    GStateHandle renderedGString;
    GStringErrorType endError;
    GSRetType drawResult;
    EGError bitmapError;
    word lastElement;
    TransError error;

    *bitmapP = NullHandle;
    sourceBlock = VMCHAIN_GET_VM_BLOCK(graphicP->VTG_vmChain);
    if (sourceBlock == NullHandle ||
        VMCHAIN_IS_DBITEM(graphicP->VTG_vmChain) ||
        graphicP->VTG_size.XYS_width == 0 ||
        graphicP->VTG_size.XYS_height == 0 ||
        VMInfoVMChain(stateP->vmFile, graphicP->VTG_vmChain,
                      &chainSize, &vmBlocks, &dbItems)) {
        return TE_INVALID_FORMAT;
    }

    sourceGString = GrLoadGString(stateP->vmFile, GST_VMEM, sourceBlock);
    if (sourceGString == NullHandle) {
        return TE_INVALID_FORMAT;
    }
    renderedBlock = NullHandle;
    renderedGString = GrCreateGString(stateP->vmFile, GST_VMEM,
                                      &renderedBlock);
    if (renderedGString == NullHandle || renderedBlock == NullHandle) {
        GrDestroyGString(sourceGString, 0, GSKT_LEAVE_DATA);
        if (renderedGString != NullHandle) {
            GrDestroyGString(renderedGString, 0, GSKT_KILL_DATA);
        } else if (renderedBlock != NullHandle) {
            VMFreeVMChain(stateP->vmFile,
                          VMCHAIN_MAKE_FROM_VM_BLOCK(renderedBlock));
        }
        return TE_OUT_OF_MEMORY;
    }

    GrSetGStringBounds(renderedGString, 0, 0,
                       graphicP->VTG_size.XYS_width,
                       graphicP->VTG_size.XYS_height);
    GrApplyTransform(renderedGString,
        &graphicP->VTG_data.VTGD_gstring.VTGG_tmatrix);
    GrRelMoveTo(renderedGString,
        MakeWWFixed(graphicP->VTG_data.VTGD_gstring.VTGG_drawOffset.XYO_x),
        MakeWWFixed(graphicP->VTG_data.VTGD_gstring.VTGG_drawOffset.XYO_y));
    lastElement = 0;
    drawResult = GrDrawGStringAtCP(renderedGString, sourceGString, 0,
                                  &lastElement);
    GrDestroyGString(sourceGString, 0, GSKT_LEAVE_DATA);
    if (drawResult == GSRT_FAULT) {
        GrDestroyGString(renderedGString, 0, GSKT_KILL_DATA);
        return TE_INVALID_FORMAT;
    }
    endError = GrEndGString(renderedGString);
    if (endError != GSET_NO_ERROR) {
        GrDestroyGString(renderedGString, 0, GSKT_KILL_DATA);
        return TE_DISK_FULL;
    }
    GrDestroyGString(renderedGString, 0, GSKT_LEAVE_DATA);

    bitmapError = EGE_NO_ERROR;
    bitmapBlock = BmpGStringToBitmap(stateP->vmFile, renderedBlock,
        stateP->vmFile, BMF_24BIT | BMT_MASK, &bitmapError);
    VMFreeVMChain(stateP->vmFile,
                  VMCHAIN_MAKE_FROM_VM_BLOCK(renderedBlock));
    if (bitmapError != EGE_NO_ERROR || bitmapBlock == NullHandle) {
        if (bitmapBlock != NullHandle) {
            VMFreeVMChain(stateP->vmFile,
                          VMCHAIN_MAKE_FROM_VM_BLOCK(bitmapBlock));
        }
        error = (bitmapError == EGE_NO_ERROR) ? TE_OUT_OF_MEMORY :
                                                MDExtGraphError(bitmapError);
        return error;
    }
    *bitmapP = bitmapBlock;
    return TE_NO_ERROR;
}

TransError MDWriteGraphicPNG(MDExportState *stateP,
                             VisTextGraphic *graphicP, const char *nameP)
{
    VMBlockHandle bitmapBlock;
    FileHandle fileH;
    PngError pngError;
    TransError error;
    Boolean directoryPushed;
    Boolean fileCreated;

    bitmapBlock = NullHandle;
    fileH = NullHandle;
    directoryPushed = FALSE;
    fileCreated = FALSE;
    MemUnlock(stateP->buffersH);
    stateP->renderedP = (void *)0;
    stateP->lineP = (void *)0;
    stateP->kindsP = (void *)0;
    error = MDRasterizeGraphic(stateP, graphicP, &bitmapBlock);
    if (error != TE_NO_ERROR) {
        goto cleanup;
    }

    FilePushDir();
    directoryPushed = TRUE;
    if (!FileSetCurrentPath(stateP->frameP->EF_outputPathDisk,
                            stateP->frameP->EF_outputPathName)) {
        error = TE_FILE_OPEN;
        goto cleanup;
    }
    fileH = FileCreate(nameP, FCF_NATIVE | FILE_CREATE_TRUNCATE |
                       FILE_ACCESS_RW | FILE_DENY_RW, FILE_ATTR_NORMAL);
    if (fileH == NullHandle) {
        error = (ThreadGetError() == ERROR_INSUFFICIENT_MEMORY) ?
                    TE_OUT_OF_MEMORY : TE_FILE_OPEN;
        goto cleanup;
    }
    fileCreated = TRUE;
    pngError = pngExportBitmapFHandle(stateP->vmFile, bitmapBlock, fileH);
    if (pngError != PE_NO_ERROR) {
        error = MDPngError(pngError);
    }
    if (FileClose(fileH, FALSE) != 0 && error == TE_NO_ERROR) {
        error = TE_FILE_WRITE;
    }
    fileH = NullHandle;

cleanup:
    if (fileH != NullHandle) {
        FileClose(fileH, FALSE);
    }
    if (bitmapBlock != NullHandle) {
        VMFreeVMChain(stateP->vmFile,
                      VMCHAIN_MAKE_FROM_VM_BLOCK(bitmapBlock));
    }
    stateP->renderedP = MemLock(stateP->buffersH);
    if (stateP->renderedP == (void *)0 && error == TE_NO_ERROR) {
        error = TE_OUT_OF_MEMORY;
    } else if (stateP->renderedP != (void *)0) {
        stateP->lineP = stateP->renderedP + MD_EXPORT_OUTPUT;
        stateP->kindsP = (byte *)(stateP->lineP + MD_EXPORT_LINE);
    }
    if (fileCreated && error != TE_NO_ERROR) {
        FileDelete(nameP);
    }
    if (directoryPushed) {
        FilePopDir();
    }
    return error;
}

TransError MDPutGraphic(MDExportState *stateP, word *posP, dword position)
{
    VisTextGraphic graphic;
    VisTextRange range;
    char name[13];
    dword number;
    TransError error;
    word nameLength;

    @call stateP->textObj::MSG_VIS_TEXT_GET_RUN_BOUNDS(
        &range, OFFSET_FOR_GRAPHIC_RUNS, position);
    if (range.VTR_start != position) {
        return TE_INVALID_FORMAT;
    }
    memset(&graphic, 0, sizeof(graphic));
    @call stateP->textObj::MSG_VIS_TEXT_GET_GRAPHIC_AT_POSITION(
        &graphic, position);
    if (graphic.VTG_type == VTGT_VARIABLE) {
        return MDPutString(stateP, posP, "[image]") ?
                   TE_NO_ERROR : TE_EXPORT_ERROR;
    }
    if (graphic.VTG_type != VTGT_GSTRING) {
        return TE_INVALID_FORMAT;
    }

    number = stateP->imageNumber + 1;
    if (number == 0 ||
        !MDMakeImageName(stateP->frameP->EF_outputFileName, number, name)) {
        return TE_FILE_TOO_LARGE;
    }
    error = MDWriteGraphicPNG(stateP, &graphic, name);
    if (error != TE_NO_ERROR) {
        return error;
    }
    for (nameLength = 0; name[nameLength] != C_NULL; ++nameLength) {
        if (name[nameLength] >= 'a' && name[nameLength] <= 'z') {
            name[nameLength] -= 'a' - 'A';
        }
    }
    if (!MDPutString(stateP, posP, "![image ") ||
        !MDPutNumber(stateP, posP, number) ||
        !MDPutString(stateP, posP, "](") ||
        !MDPutString(stateP, posP, name) ||
        !MDPutByte(stateP, posP, ')')) {
        return TE_EXPORT_ERROR;
    }
    stateP->imageNumber = number;
    return TE_NO_ERROR;
}

Boolean MDRunReached(TextRunArrayElement *runP, dword position)
{
    if (runP->TRAE_position.WAAH_high == -1) {
        return FALSE;
    }
    return runP->TRAE_position.WAAH_high < (byte)(position >> 16) ||
           (runP->TRAE_position.WAAH_high == (byte)(position >> 16) &&
            runP->TRAE_position.WAAH_low <= (word)position);
}

VisTextCharAttr *MDGetAttr(MDExportState *stateP, dword position)
{
    word count;
    word size;

    if (!stateP->attrsValid) {
        return (void *)0;
    }
    while (MDRunReached(stateP->nextRunP, position)) {
        stateP->currentToken = stateP->nextRunP->TRAE_token;
        count = HugeArrayNext((void **)&stateP->nextRunP, &size);
        if (count == 0) {
            stateP->attrsValid = FALSE;
            return (void *)0;
        }
    }
    return ChunkArrayElementToPtr(stateP->charElementArray,
                                  stateP->currentToken, (void *)0);
}

word MDAttrKind(VisTextCharAttr *attrP)
{
    word kind;

    kind = 0;
    if (attrP->VTCA_textStyles & TS_BOLD) {
        kind |= MD_KIND_BOLD;
    }
    if (attrP->VTCA_textStyles & TS_ITALIC) {
        kind |= MD_KIND_ITALIC;
    }
    if (attrP->VTCA_fontID == FID_DTC_URW_MONO) {
        kind |= MD_KIND_CODE;
    }
    return kind;
}

word MDHeadingFromSize(word size)
{
    switch (size) {
    case MD_HEADING_1_SIZE: return 1;
    case MD_HEADING_2_SIZE: return 2;
    case MD_HEADING_3_SIZE: return 3;
    case MD_HEADING_4_SIZE: return 4;
    case MD_HEADING_5_SIZE: return 5;
    case MD_HEADING_6_SIZE: return 6;
    }
    return 0;
}

Boolean MDRunSafe(const char *lineP, word start, word end, word kind)
{
    word index;
    char delimiter;

    if (start >= end || lineP[start] == ' ' || lineP[start] == C_TAB ||
        lineP[end - 1] == ' ' || lineP[end - 1] == C_TAB) {
        return FALSE;
    }
    delimiter = (kind == MD_KIND_CODE) ? '`' : '*';
    for (index = start; index < end; ++index) {
        if (lineP[index] == delimiter || lineP[index] == C_CR) {
            return FALSE;
        }
    }
    return TRUE;
}

Boolean MDPutDelimiter(MDExportState *stateP, word *posP, word kind)
{
    if (kind == MD_KIND_CODE) {
        return MDPutByte(stateP, posP, '`');
    }
    if (kind == MD_KIND_BOLD) {
        return MDPutByte(stateP, posP, '*') &&
               MDPutByte(stateP, posP, '*');
    }
    return MDPutByte(stateP, posP, '*');
}

Boolean MDRangeItalic(MDExportState *stateP, dword start, dword end)
{
    VisTextCharAttr attrs;
    VisTextCharAttrDiffs diffs;

    if (start == end) {
        return FALSE;
    }
    @call stateP->textObj::MSG_VIS_TEXT_GET_CHAR_ATTR(
        0, &diffs, &attrs, end, start);
    return (attrs.VTCA_textStyles & TS_ITALIC) &&
           !(diffs.VTCAD_textStyles & TS_ITALIC);
}

Boolean MDLineEndsQuote(const char *lineP, word length)
{
    while (length != 0 &&
           (lineP[length - 1] == ' ' || lineP[length - 1] == C_TAB)) {
        --length;
    }
    return length != 0 && lineP[length - 1] == '"';
}

Boolean MDQuoteRegionValid(MDExportState *stateP, dword base,
                           word length, dword size)
{
    TextReference reference;
    dword end;
    dword pulled;

    if (!MDRangeItalic(stateP, base, base + length)) {
        return FALSE;
    }
    if (MDLineEndsQuote(stateP->lineP, length)) {
        return TRUE;
    }
    base += length;
    if (base < size) {
        ++base;
    }
    reference.TR_type = TRT_POINTER;
    reference.TR_ref.TRU_pointer.TRP_pointer = stateP->renderedP;
    while (base < size) {
        end = base + MD_EXPORT_LINE - 1;
        if (end > size) {
            end = size;
        }
        pulled = @call stateP->textObj::MSG_VIS_TEXT_GET_TEXT_RANGE(
            0, reference, end, base);
        if (pulled == 0) {
            return FALSE;
        }
        length = 0;
        while (length < (word)pulled && stateP->renderedP[length] != C_CR) {
            ++length;
        }
        if (length == 0 ||
            !MDRangeItalic(stateP, base, base + length)) {
            return FALSE;
        }
        if (MDLineEndsQuote(stateP->renderedP, length)) {
            return TRUE;
        }
        if (length == (word)pulled && base + pulled < size) {
            return FALSE;
        }
        base += length;
        if (base < size) {
            ++base;
        }
    }
    return FALSE;
}

TransError MDRenderLine(MDExportState *stateP, dword base, word length,
                        dword size)
{
    VisTextCharAttr *attrP;
    word heading;
    word headingSize;
    word textEnd;
    word inPos;
    word outPos;
    word runEnd;
    word kind;
    word nextKind;
    Boolean quoteEnd;
    TransError error;

    headingSize = 0;
    heading = (length != 0);
    for (inPos = 0; inPos < length; ++inPos) {
        attrP = MDGetAttr(stateP, base + inPos);
        stateP->kindsP[inPos] =
            (attrP && (byte)stateP->lineP[inPos] != C_GRAPHIC) ?
                MDAttrKind(attrP) : 0;
        if ((byte)stateP->lineP[inPos] == C_GRAPHIC || !attrP ||
            !(attrP->VTCA_textStyles & TS_BOLD) ||
            attrP->VTCA_pointSize.WBF_frac != 0) {
            heading = 0;
        } else if (headingSize == 0) {
            headingSize = attrP->VTCA_pointSize.WBF_int;
        } else if (headingSize != attrP->VTCA_pointSize.WBF_int) {
            heading = 0;
        }
    }
    heading = heading ? MDHeadingFromSize(headingSize) : 0;
    outPos = 0;
    for (inPos = 0; inPos < heading; ++inPos) {
        if (!MDPutByte(stateP, &outPos, '#')) return TE_EXPORT_ERROR;
    }
    if (heading && !MDPutByte(stateP, &outPos, ' ')) return TE_EXPORT_ERROR;

    inPos = 0;
    if (!heading && length >= 2 &&
        (byte)stateP->lineP[0] == 0xa5 && stateP->lineP[1] == ' ') {
        if (!MDPutByte(stateP, &outPos, '-') ||
            !MDPutByte(stateP, &outPos, ' ')) return TE_EXPORT_ERROR;
        inPos = 2;
    }
    textEnd = length;
    quoteEnd = FALSE;
    if (!heading && inPos == 0 && !stateP->quote) {
        while (inPos < length &&
               (stateP->lineP[inPos] == ' ' ||
                stateP->lineP[inPos] == C_TAB)) {
            ++inPos;
        }
        if (inPos < length && stateP->lineP[inPos] == '"' &&
            MDQuoteRegionValid(stateP, base, length, size)) {
            stateP->quote = TRUE;
            ++inPos;
            if (inPos < length && stateP->lineP[inPos] == ' ') {
                ++inPos;
            }
        } else {
            inPos = 0;
        }
    } else if (stateP->quote) {
        while (inPos < length &&
               (stateP->lineP[inPos] == ' ' ||
                stateP->lineP[inPos] == C_TAB)) {
            ++inPos;
        }
    }
    if (stateP->quote) {
        if (!MDPutByte(stateP, &outPos, '>') ||
            !MDPutByte(stateP, &outPos, ' ')) return TE_EXPORT_ERROR;
        while (textEnd > inPos &&
               (stateP->lineP[textEnd - 1] == ' ' ||
                stateP->lineP[textEnd - 1] == C_TAB)) {
            --textEnd;
        }
        if (textEnd > inPos && stateP->lineP[textEnd - 1] == '"') {
            --textEnd;
            while (textEnd > inPos &&
                   (stateP->lineP[textEnd - 1] == ' ' ||
                    stateP->lineP[textEnd - 1] == C_TAB)) {
                --textEnd;
            }
            quoteEnd = TRUE;
        }
    }
    while (inPos < textEnd) {
        kind = stateP->kindsP[inPos];
        if (stateP->quote) kind &= ~MD_KIND_ITALIC;
        if (heading) kind &= ~MD_KIND_BOLD;
        runEnd = inPos + 1;
        while (runEnd < textEnd) {
            nextKind = stateP->kindsP[runEnd];
            if (stateP->quote) nextKind &= ~MD_KIND_ITALIC;
            if (heading) nextKind &= ~MD_KIND_BOLD;
            if (nextKind != kind) break;
            ++runEnd;
        }
        if (kind != MD_KIND_BOLD && kind != MD_KIND_ITALIC &&
            kind != MD_KIND_CODE) {
            kind = 0;
        }
        if (kind && !MDRunSafe(stateP->lineP, inPos, runEnd, kind)) {
            kind = 0;
        }
        if (kind && !MDPutDelimiter(stateP, &outPos, kind)) {
            return TE_EXPORT_ERROR;
        }
        while (inPos < runEnd) {
            if ((byte)stateP->lineP[inPos] == C_GRAPHIC) {
                error = MDPutGraphic(stateP, &outPos, base + inPos);
                if (error != TE_NO_ERROR) {
                    return error;
                }
            } else if (!MDPutChar(stateP, &outPos,
                                  (byte)stateP->lineP[inPos])) {
                    return TE_EXPORT_ERROR;
            }
            ++inPos;
        }
        if (kind && !MDPutDelimiter(stateP, &outPos, kind)) {
            return TE_EXPORT_ERROR;
        }
    }
    if (!MDPutByte(stateP, &outPos, C_CR) ||
        !MDPutByte(stateP, &outPos, C_LF)) {
        return TE_EXPORT_ERROR;
    }
    if (quoteEnd) {
        stateP->quote = FALSE;
    }
    return MDWrite(stateP->output, stateP->renderedP, outPos);
}

TransError MDExportObject(MDExportState *stateP)
{
    TextReference reference;
    dword size;
    dword base;
    dword end;
    dword pulled;
    word length;
    TransError error;

    size = @call stateP->textObj::MSG_VIS_TEXT_GET_TEXT_SIZE();
    base = 0;
    reference.TR_type = TRT_POINTER;
    while (base < size) {
        end = base + MD_EXPORT_LINE - 1;
        if (end > size) {
            end = size;
        }
        reference.TR_ref.TRU_pointer.TRP_pointer = stateP->lineP;
        pulled = @call stateP->textObj::MSG_VIS_TEXT_GET_TEXT_RANGE(
            0, reference, end, base);
        if (pulled == 0) return TE_EXPORT_ERROR;
        length = 0;
        while (length < (word)pulled && stateP->lineP[length] != C_CR) {
            ++length;
        }
        if (length == (word)pulled && base + pulled < size) {
            return TE_EXPORT_ERROR;
        }
        error = MDRenderLine(stateP, base, length, size);
        if (error != TE_NO_ERROR) return error;
        base += length;
        if (base < size && stateP->lineP[length] == C_CR) ++base;
    }
    return TE_NO_ERROR;
}

TransError _far _pascal MDExport(ExportFrame *frameP)
{
    MemHandle stateH;
    MDExportState *stateP;
    optr textObj;
    TransError error;
    TextTransferBlockHeader *headerP;
    LMemBlockHeader *elementsP;
    MemHandle headerH;
    VMBlockHandle charRuns;
    VMBlockHandle charElements;
    word count;
    word size;

    stateH = MemAlloc(sizeof(MDExportState), HF_DYNAMIC,
                      HAF_ZERO_INIT | HAF_LOCK);
    if (stateH == NullHandle) return TE_OUT_OF_MEMORY;
    stateP = (MDExportState *)MemDeref(stateH);
    textObj = TextAllocClipboardObject(frameP->EF_transferVMFile,
        VTSF_MULTIPLE_CHAR_ATTRS | VTSF_MULTIPLE_PARA_ATTRS |
        VTSF_GRAPHICS, 0);
    if (!textObj) {
        MemUnlock(stateH);
        MemFree(stateH);
        return TE_OUT_OF_MEMORY;
    }
    @call textObj::MSG_VIS_TEXT_REPLACE_WITH_TEXT_TRANSFER_FORMAT(
        VMCHAIN_GET_VM_BLOCK(frameP->EF_transferVMChain),
        frameP->EF_transferVMFile, 0, 0, 0);
    stateP->buffersH = MemAlloc(MD_EXPORT_BUFFERS, HF_DYNAMIC,
                                HAF_ZERO_INIT | HAF_LOCK);
    if (stateP->buffersH == NullHandle) {
        TextFinishWithClipboardObject(textObj, TCO_RETURN_NOTHING,
            HandleToOptr(GeodeGetProcessHandle()), "");
        MemUnlock(stateH);
        MemFree(stateH);
        return TE_OUT_OF_MEMORY;
    }
    stateP->renderedP = MemDeref(stateP->buffersH);
    stateP->lineP = stateP->renderedP + MD_EXPORT_OUTPUT;
    stateP->kindsP = (byte *)(stateP->lineP + MD_EXPORT_LINE);
    stateP->textObj = textObj;
    stateP->output = frameP->EF_outputFile;
    stateP->frameP = frameP;
    stateP->vmFile = frameP->EF_transferVMFile;
    headerP = VMLock(stateP->vmFile,
        VMCHAIN_GET_VM_BLOCK(frameP->EF_transferVMChain), &headerH);
    charRuns = VMCHAIN_GET_VM_BLOCK(headerP->TTBH_charAttrRuns);
    charElements = VMCHAIN_GET_VM_BLOCK(headerP->TTBH_charAttrElements);
    VMUnlock(headerH);
    if (charRuns != NullHandle && charElements != NullHandle) {
        elementsP = VMLock(stateP->vmFile, charElements,
                           &stateP->charElementsH);
        stateP->charElementArray =
            ConstructOptr(stateP->charElementsH, elementsP->LMBH_offset);
        count = HugeArrayLock(stateP->vmFile, charRuns, 0,
                              (void **)&stateP->nextRunP, &size);
        if (count != 0) {
            stateP->currentToken = stateP->nextRunP->TRAE_token;
            count = HugeArrayNext((void **)&stateP->nextRunP, &size);
            stateP->attrsValid = (count != 0);
        }
    }
    MDInitUnicode(stateP);
    error = MDExportObject(stateP);
    if (stateP->nextRunP != (void *)0) {
        HugeArrayUnlock(stateP->nextRunP);
    }
    if (stateP->charElementsH != NullHandle) {
        VMUnlock(stateP->charElementsH);
    }
    TextFinishWithClipboardObject(textObj, TCO_RETURN_NOTHING,
        HandleToOptr(GeodeGetProcessHandle()), "");
    if (stateP->renderedP != (void *)0) {
        MemUnlock(stateP->buffersH);
    }
    MemFree(stateP->buffersH);
    MemUnlock(stateH);
    MemFree(stateH);
    return error;
}
