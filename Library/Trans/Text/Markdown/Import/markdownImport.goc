@include <stdapp.goh>
#include <file.h>
#include <gstring.h>
#include <graphics.h>
#include <impgraph.h>
#include <library.h>
#include <resource.h>
#include <xlatLib.h>
@include <html4par.goh>
#include <string.h>
#include <vm.h>

#define MD_MAX_LINE 2048
#define MD_MAX_INPUT (MD_MAX_LINE - 5)
#define MD_MAX_OUTPUT 4096
#define MD_READ_SIZE 512
#define MD_MAX_RUNS 96
#define MD_MAX_IMAGES 32
/* ATTENTION: these bounds keep oversized decoded images out of the document;
 * pre-decode IHDR validation is the upgrade path for tighter resource limits.
 */
#define MD_MAX_IMAGE_DIMENSION 2048
#define MD_MAX_IMAGE_PIXELS 1048576UL

#if ERROR_CHECK
#define MD_IMPGRAPH_FILE_NAME "EC Breadbox Graphics Imp Library"
#else
#define MD_IMPGRAPH_FILE_NAME "Breadbox Graphics Imp Library"
#endif

#define MD_STYLE_BOLD 0x0001
#define MD_STYLE_ITALIC 0x0002
#define MD_STYLE_CODE 0x0004

typedef enum {
    MD_WARNING_BAD_IMAGE_PATH = 1,
    MD_WARNING_SOURCE_PATH_FAILED,
    MD_WARNING_IMAGE_DECODE_FAILED,
    MD_WARNING_IMAGE_RESULT_INVALID,
    MD_WARNING_GSTRING_CREATION_FAILED,
    MD_WARNING_GSTRING_RECORD_FAILED,
    MD_WARNING_IMPGRAPH_FILE_NOT_FOUND,
    MD_WARNING_IMPGRAPH_PROTOCOL_ERROR,
    MD_WARNING_IMPGRAPH_LIBRARY_LOAD_ERROR,
    MD_WARNING_IMPGRAPH_LIBRARY_INIT_ERROR,
    MD_WARNING_IMPGRAPH_LOAD_FAILED,
    MD_WARNING_IMPGRAPH_ENTRY_MISSING
} Warnings;

/* Force the warning names into the EC symbols for Swat's why-warning. */
#if ERROR_CHECK
Warnings markdownWarnings;
#endif

typedef struct {
    word start;
    word end;
    word style;
} MDRun;

typedef struct {
    word outputPos;
    VMBlockHandle gstring;
    XYSize size;
} MDImage;

typedef struct {
    FileHandle source;
    ImportFrame *frameP;
    optr textObj;
    VMFileHandle transferFile;
    GeodeHandle imageLibrary;
    word readPos;
    word readSize;
    byte pushed[3];
    word pushCount;
    byte pending;
    Boolean pendingValid;
    Boolean eof;
    char input[MD_MAX_LINE];
    char output[MD_MAX_OUTPUT];
    byte readBuffer[MD_READ_SIZE];
    MDRun runs[MD_MAX_RUNS];
    word runCount;
    MDImage images[MD_MAX_IMAGES];
    word imageCount;
    word heading;
    word headingStart;
    Boolean quote;
    word textEnd;
} MDState;

int MDRawRead(MDState *stateP)
{
    word count;

    if (stateP->pushCount != 0) {
        return stateP->pushed[--stateP->pushCount];
    }
    if (stateP->readPos == stateP->readSize) {
        count = FileRead(stateP->source, stateP->readBuffer,
                         MD_READ_SIZE, FALSE);
        if (count == (word)-1) {
            return -2;
        }
        stateP->readPos = 0;
        stateP->readSize = count;
        if (count == 0) {
            return -1;
        }
    }
    return stateP->readBuffer[stateP->readPos++];
}

void MDRawPush(MDState *stateP, byte value)
{
    if (stateP->pushCount < 3) {
        stateP->pushed[stateP->pushCount++] = value;
    }
}

TransError MDSkipBOM(MDState *stateP)
{
    int first;
    int second;
    int third;

    first = MDRawRead(stateP);
    if (first == -2) {
        return TE_FILE_READ;
    }
    if (first < 0) {
        return TE_NO_ERROR;
    }
    if (first != 0xef) {
        MDRawPush(stateP, (byte)first);
        return TE_NO_ERROR;
    }
    second = MDRawRead(stateP);
    if (second < 0) {
        MDRawPush(stateP, (byte)first);
        return (second == -2) ? TE_FILE_READ : TE_NO_ERROR;
    }
    if (second != 0xbb) {
        MDRawPush(stateP, (byte)second);
        MDRawPush(stateP, (byte)first);
        return TE_NO_ERROR;
    }
    third = MDRawRead(stateP);
    if (third < 0) {
        MDRawPush(stateP, (byte)second);
        MDRawPush(stateP, (byte)first);
        return (third == -2) ? TE_FILE_READ : TE_NO_ERROR;
    }
    if (third != 0xbf) {
        MDRawPush(stateP, (byte)third);
        MDRawPush(stateP, (byte)second);
        MDRawPush(stateP, (byte)first);
    }
    return TE_NO_ERROR;
}

int MDReadChar(MDState *stateP)
{
    int value;
    int c2;
    int c3;
    int c4;
    unsigned int unicode;
    int mapped;

    if (stateP->pendingValid) {
        stateP->pendingValid = FALSE;
        return stateP->pending;
    }
    value = MDRawRead(stateP);
    if (value < 0 || value < 0x80) {
        return value;
    }
    if (value >= 0xc2 && value <= 0xdf) {
        c2 = MDRawRead(stateP);
        if (c2 < 0) {
            return (c2 == -2) ? -2 : '?';
        }
        if ((c2 & 0xc0) != 0x80) {
            MDRawPush(stateP, (byte)c2);
            return '?';
        }
        unicode = ((value & 0x1f) << 6) | (c2 & 0x3f);
    } else if (value >= 0xe0 && value <= 0xef) {
        c2 = MDRawRead(stateP);
        if (c2 < 0) {
            return (c2 == -2) ? -2 : '?';
        }
        if ((c2 & 0xc0) != 0x80 ||
            (value == 0xe0 && c2 < 0xa0) ||
            (value == 0xed && c2 >= 0xa0)) {
            if ((c2 & 0xc0) != 0x80) {
                MDRawPush(stateP, (byte)c2);
            }
            return '?';
        }
        c3 = MDRawRead(stateP);
        if (c3 < 0) {
            return (c3 == -2) ? -2 : '?';
        }
        if ((c3 & 0xc0) != 0x80) {
            MDRawPush(stateP, (byte)c3);
            return '?';
        }
        unicode = ((value & 0x0f) << 12) |
                  ((c2 & 0x3f) << 6) | (c3 & 0x3f);
    } else if (value >= 0xf0 && value <= 0xf4) {
        c2 = MDRawRead(stateP);
        c3 = MDRawRead(stateP);
        c4 = MDRawRead(stateP);
        if (c2 == -2 || c3 == -2 || c4 == -2) {
            return -2;
        }
        if (c2 >= 0 && (c2 & 0xc0) != 0x80) {
            MDRawPush(stateP, (byte)c2);
        } else if (c3 >= 0 && (c3 & 0xc0) != 0x80) {
            MDRawPush(stateP, (byte)c3);
        } else if (c4 >= 0 && (c4 & 0xc0) != 0x80) {
            MDRawPush(stateP, (byte)c4);
        }
        return '?';
    } else {
        return '?';
    }
    mapped = HTMLTranslateCharNum(unicode);
    return mapped ? mapped : '?';
}

TransError MDReadLine(MDState *stateP, word *lengthP)
{
    word length;
    int value;
    int next;

    length = 0;
    for (;;) {
        value = MDReadChar(stateP);
        if (value == -2) {
            return TE_FILE_READ;
        }
        if (value == -1) {
            if (length == 0) {
                stateP->eof = TRUE;
                *lengthP = 0;
                return TE_NO_ERROR;
            }
            break;
        }
        if (value == C_CR || value == C_LF) {
            next = MDReadChar(stateP);
            if (next == -2) {
                return TE_FILE_READ;
            }
            if (next >= 0 && !((value == C_CR && next == C_LF) ||
                               (value == C_LF && next == C_CR))) {
                stateP->pending = (byte)next;
                stateP->pendingValid = TRUE;
            }
            break;
        }
        if (length >= MD_MAX_INPUT) {
            return TE_IMPORT_ERROR;
        }
        stateP->input[length++] = (char)value;
    }
    stateP->input[length++] = C_CR;
    stateP->input[length] = C_NULL;
    *lengthP = length;
    return TE_NO_ERROR;
}

Boolean MDPut(MDState *stateP, word *posP, char value)
{
    if (*posP >= MD_MAX_OUTPUT - 1) {
        return FALSE;
    }
    stateP->output[(*posP)++] = value;
    return TRUE;
}

void MDAddRun(MDState *stateP, word start, word end, word style)
{
    MDRun *runP;

    if (start >= end || stateP->runCount == MD_MAX_RUNS) {
        return;
    }
    runP = &stateP->runs[stateP->runCount++];
    runP->start = start;
    runP->end = end;
    runP->style = style;
}

Boolean MDHasClosing(const char *textP, word pos,
                                  char delimiter, word width)
{
    pos += width;
    while (textP[pos] != C_CR) {
        if (textP[pos] == delimiter &&
            (width == 1 || textP[pos + 1] == delimiter)) {
            return TRUE;
        }
        ++pos;
    }
    return FALSE;
}

Boolean MDHasLink(const char *textP, word pos)
{
    ++pos;
    while (textP[pos] != C_CR && textP[pos] != ']') {
        ++pos;
    }
    if (textP[pos] != ']' || textP[pos + 1] != '(') {
        return FALSE;
    }
    pos += 2;
    while (textP[pos] != C_CR && textP[pos] != ')') {
        ++pos;
    }
    return textP[pos] == ')';
}

Boolean MDFindImage(const char *textP, word pos, word *endP,
                    word *pathStartP, word *pathEndP)
{
    if (textP[pos] != '!' || textP[pos + 1] != '[') {
        return FALSE;
    }
    pos += 2;
    while (textP[pos] != C_CR && textP[pos] != ']') {
        ++pos;
    }
    if (textP[pos] != ']' || textP[pos + 1] != '(') {
        return FALSE;
    }
    *pathStartP = pos + 2;
    pos += 2;
    while (textP[pos] != C_CR && textP[pos] != ')') {
        ++pos;
    }
    if (textP[pos] != ')' || pos == *pathStartP) {
        return FALSE;
    }
    *pathEndP = pos;
    *endP = pos + 1;
    return TRUE;
}

Boolean MDMakeImagePath(const char *textP, word start, word end,
                        PathName pathP)
{
    word index;
    word length;
    char value;

    length = end - start;
    if (length == 0 || length >= sizeof(PathName)) {
        return FALSE;
    }
    for (index = 0; index < length; ++index) {
        value = textP[start + index];
        if (value == '/') {
            value = '\\';
        }
        if (index == 0 && (value == '\\' || value == ':')) {
            return FALSE;
        }
        if (value == ':') {
            return FALSE;
        }
        pathP[index] = value;
    }
    pathP[length] = C_NULL;
    return TRUE;
}

void *MDGetImpGraphImportEntry(MDState *stateP)
{
    GeodeLoadError loadError;
    void *entryP;

    if (stateP->imageLibrary == NullHandle) {
        /* ImpGraph remains in system/impex for MIME-driver enumeration.
         * Load it lazily by its GEOS long filename instead of adding a
         * forwarding library.
         */
        FilePushDir();
        FileSetStandardPath(SP_IMPORT_EXPORT_DRIVERS);
        stateP->imageLibrary = GeodeUseLibrary(
            MD_IMPGRAPH_FILE_NAME,
            IMP_GRAPH_PROTO_MAJOR,
            IMP_GRAPH_PROTO_MINOR,
            &loadError);
        FilePopDir();
        if (stateP->imageLibrary == NullHandle) {
            switch (loadError) {
            case GLE_FILE_NOT_FOUND:
            case GLE_LIBRARY_NOT_FOUND:
                EC_WARNING(MD_WARNING_IMPGRAPH_FILE_NOT_FOUND);
                break;
            case GLE_LIBRARY_PROTOCOL_ERROR:
            case GLE_PROTOCOL_IMPORTER_TOO_RECENT:
            case GLE_PROTOCOL_IMPORTER_TOO_OLD:
                EC_WARNING(MD_WARNING_IMPGRAPH_PROTOCOL_ERROR);
                break;
            case GLE_LIBRARY_LOAD_ERROR:
                EC_WARNING(MD_WARNING_IMPGRAPH_LIBRARY_LOAD_ERROR);
                break;
            case GLE_LIBRARY_INIT_ERROR:
                EC_WARNING(MD_WARNING_IMPGRAPH_LIBRARY_INIT_ERROR);
                break;
            default:
                EC_WARNING(MD_WARNING_IMPGRAPH_LOAD_FAILED);
                break;
            }
            return (void *)0;
        }
    }

    entryP = ProcGetLibraryEntry(stateP->imageLibrary,
                                 IMP_GRAPH_ENTRY_IMPORT_FILE);
    if (entryP == (void *)0) {
        EC_WARNING(MD_WARNING_IMPGRAPH_ENTRY_MISSING);
    }
    return entryP;
}

Boolean MDImportImage(MDState *stateP, word pathStart, word pathEnd,
                      VMBlockHandle *gstringP, XYSize *sizeP)
{
    PathName imagePath;
    ImpGraphImportParams params;
    XYValueAsDWord bitmapSize;
    VMBlockHandle bitmapBlock;
    VMBlockHandle gstringBlock;
    GStateHandle gstate;
    GStringErrorType gstringError;
    void *entryP;

    if (!MDMakeImagePath(stateP->input, pathStart, pathEnd, imagePath)) {
        EC_WARNING(MD_WARNING_BAD_IMAGE_PATH);
        return FALSE;
    }

    memset(&params, 0, sizeof(params));
    params.IGIP_size = IMP_GRAPH_IMPORT_PARAMS_V1_SIZE;
    params.IGIP_format = IG_FORMAT_AUTO;
    params.IGIP_optionMask = IGIO_COMPRESS;
    params.IGIP_status = NullOptr;

    entryP = MDGetImpGraphImportEntry(stateP);
    if (entryP == (void *)0) {
        return FALSE;
    }

    FilePushDir();
    if (!FileSetCurrentPath(stateP->frameP->IF_sourcePathDisk,
                            stateP->frameP->IF_sourcePathName)) {
        EC_WARNING(MD_WARNING_SOURCE_PATH_FAILED);
        FilePopDir();
        return FALSE;
    }
    bitmapBlock =
        ((pcfm_ImpGraphImportFile *)ProcCallFixedOrMovable_pascal)(
            imagePath, stateP->transferFile, &params, entryP);
    FilePopDir();

    if (bitmapBlock == NullHandle) {
        EC_WARNING(MD_WARNING_IMAGE_DECODE_FAILED);
        return FALSE;
    }
    bitmapSize = GrGetHugeBitmapSize(stateP->transferFile, bitmapBlock);
    sizeP->XYS_width = (word)bitmapSize;
    sizeP->XYS_height = (word)(bitmapSize >> 16);
    if (sizeP->XYS_width == 0 || sizeP->XYS_height == 0 ||
        sizeP->XYS_width > MD_MAX_IMAGE_DIMENSION ||
        sizeP->XYS_height > MD_MAX_IMAGE_DIMENSION ||
        (dword)sizeP->XYS_width * (dword)sizeP->XYS_height >
            MD_MAX_IMAGE_PIXELS) {
        EC_WARNING(MD_WARNING_IMAGE_RESULT_INVALID);
        VMFreeVMChain(stateP->transferFile,
                      VMCHAIN_MAKE_FROM_VM_BLOCK(bitmapBlock));
        return FALSE;
    }

    gstate = GrCreateGString(stateP->transferFile, GST_VMEM,
                             &gstringBlock);
    if (!gstate || gstringBlock == NullHandle) {
        EC_WARNING(MD_WARNING_GSTRING_CREATION_FAILED);
        if (bitmapBlock != NullHandle) {
            VMFreeVMChain(stateP->transferFile,
                          VMCHAIN_MAKE_FROM_VM_BLOCK(bitmapBlock));
        }
        return FALSE;
    }
    GrSetGStringBounds(gstate, 0, 0, sizeP->XYS_width,
                       sizeP->XYS_height);
    GrDrawHugeBitmap(gstate, 0, 0, stateP->transferFile, bitmapBlock);
    gstringError = GrEndGString(gstate);
    if (gstringError != GSET_NO_ERROR) {
        GrDestroyGString(gstate, 0, GSKT_KILL_DATA);
        VMFreeVMChain(stateP->transferFile,
                      VMCHAIN_MAKE_FROM_VM_BLOCK(bitmapBlock));
        EC_WARNING(MD_WARNING_GSTRING_RECORD_FAILED);
        return FALSE;
    }
    GrDestroyGString(gstate, 0, GSKT_LEAVE_DATA);
    VMFreeVMChain(stateP->transferFile,
                  VMCHAIN_MAKE_FROM_VM_BLOCK(bitmapBlock));
    *gstringP = gstringBlock;
    return TRUE;
}

void MDDiscardImages(MDState *stateP)
{
    word index;

    for (index = 0; index < stateP->imageCount; ++index) {
        if (stateP->images[index].gstring != NullHandle) {
            VMFreeVMChain(stateP->transferFile,
                VMCHAIN_MAKE_FROM_VM_BLOCK(stateP->images[index].gstring));
        }
    }
    stateP->imageCount = 0;
}

void MDInsertImages(MDState *stateP, dword base)
{
    word index;
    word insertedCount = 0;
    VisTextGraphic graphic;
    dword insertPos;
    dword textSizeBefore;

    for (index = 0; index < stateP->imageCount; ++index) {
        memset(&graphic, 0, sizeof(graphic));
        graphic.VTG_type = VTGT_GSTRING;
        graphic.VTG_size = stateP->images[index].size;
        graphic.VTG_vmChain = VMCHAIN_MAKE_FROM_VM_BLOCK(
            stateP->images[index].gstring);
        graphic.VTG_data.VTGD_gstring.VTGG_tmatrix.TM_e11.WWF_int = 1;
        graphic.VTG_data.VTGD_gstring.VTGG_tmatrix.TM_e22.WWF_int = 1;
        /* REPLACE_WITH_GRAPHIC inserts C_GRAPHIC itself.  Each earlier image
         * has shifted the insertion point by one character.
         */
        insertPos = base + stateP->images[index].outputPos + insertedCount;
        textSizeBefore =
            @call stateP->textObj::MSG_VIS_TEXT_GET_TEXT_SIZE();
        @call stateP->textObj::MSG_VIS_TEXT_REPLACE_WITH_GRAPHIC(
            graphic, stateP->transferFile, 0, insertPos, insertPos);
        if (@call stateP->textObj::MSG_VIS_TEXT_GET_TEXT_SIZE() ==
            textSizeBefore + 1) {
            ++insertedCount;
        }
        VMFreeVMChain(stateP->transferFile,
            VMCHAIN_MAKE_FROM_VM_BLOCK(stateP->images[index].gstring));
        stateP->images[index].gstring = NullHandle;
    }
    stateP->imageCount = 0;
}

Boolean MDPutInputRange(MDState *stateP, word *outPosP,
                        word start, word end)
{
    while (start < end) {
        if (!MDPut(stateP, outPosP, stateP->input[start++])) {
            return FALSE;
        }
    }
    return TRUE;
}

Boolean MDIsRule(const char *textP)
{
    word pos;
    word count;
    char marker;
    char value;

    pos = 0;
    count = 0;
    marker = 0;
    while ((value = textP[pos++]) != C_CR) {
        if (value == ' ' || value == C_TAB) {
            continue;
        }
        if (marker == 0) {
            if (value != '-' && value != '_' && value != '*') {
                return FALSE;
            }
            marker = value;
        } else if (value != marker) {
            return FALSE;
        }
        ++count;
    }
    return count >= 3;
}

TransError MDParseLine(MDState *stateP, word *lengthP)
{
    word inPos;
    word outPos;
    word start;
    word savedIn;
    word savedOut;
    word width;
    word style;
    word imageEnd;
    word pathStart;
    word pathEnd;
    char delimiter;
    char value;
    MDImage *imageP;

    inPos = 0;
    outPos = 0;
    stateP->runCount = 0;
    stateP->heading = 0;
    stateP->quote = FALSE;
    if (MDIsRule(stateP->input)) {
        while (outPos < 40) {
            stateP->output[outPos++] = '-';
        }
        stateP->output[outPos++] = C_CR;
        stateP->output[outPos] = C_NULL;
        *lengthP = outPos;
        return TE_NO_ERROR;
    }
    savedIn = inPos;
    while (stateP->input[inPos] == '#' && stateP->heading < 6) {
        ++inPos;
        ++stateP->heading;
    }
    if (stateP->heading == 0 || stateP->input[inPos] != ' ') {
        stateP->heading = 0;
        inPos = savedIn;
    } else {
        ++inPos;
    }
    if (stateP->heading == 0 && stateP->input[inPos] == '>') {
        ++inPos;
        if (stateP->input[inPos] == ' ') {
            ++inPos;
        }
        if (!MDPut(stateP, &outPos, '"') ||
            !MDPut(stateP, &outPos, ' ')) {
            return TE_IMPORT_ERROR;
        }
        stateP->quote = TRUE;
    } else if (stateP->heading == 0 &&
               (stateP->input[inPos] == '-' ||
                stateP->input[inPos] == '*' ||
                stateP->input[inPos] == '+') &&
               stateP->input[inPos + 1] == ' ') {
        inPos += 2;
        if (!MDPut(stateP, &outPos, (char)0xa5) ||
            !MDPut(stateP, &outPos, ' ')) {
            return TE_IMPORT_ERROR;
        }
    } else if (stateP->heading == 0) {
        savedIn = inPos;
        savedOut = outPos;
        while (stateP->input[inPos] >= '0' &&
               stateP->input[inPos] <= '9') {
            if (!MDPut(stateP, &outPos, stateP->input[inPos++])) {
                return TE_IMPORT_ERROR;
            }
        }
        if (inPos == savedIn || stateP->input[inPos] != '.' ||
            stateP->input[inPos + 1] != ' ') {
            inPos = savedIn;
            outPos = savedOut;
        } else {
            inPos += 2;
            if (!MDPut(stateP, &outPos, '.') ||
                !MDPut(stateP, &outPos, ' ')) {
                return TE_IMPORT_ERROR;
            }
        }
    }
    stateP->headingStart = outPos;
    while ((value = stateP->input[inPos]) != C_CR) {
        delimiter = value;
        width = 0;
        style = 0;
        if (value == '`') {
            width = 1;
            style = MD_STYLE_CODE;
        } else if (value == '*' || value == '_') {
            width = (stateP->input[inPos + 1] == value) ? 2 : 1;
            style = (width == 2) ? MD_STYLE_BOLD : MD_STYLE_ITALIC;
        }
        if (width != 0 &&
            MDHasClosing(stateP->input, inPos, delimiter, width)) {
            inPos += width;
            start = outPos;
            while (stateP->input[inPos] != C_CR &&
                   !(stateP->input[inPos] == delimiter &&
                     (width == 1 ||
                      stateP->input[inPos + 1] == delimiter))) {
                if (!MDPut(stateP, &outPos, stateP->input[inPos++])) {
                    return TE_IMPORT_ERROR;
                }
            }
            if (stateP->input[inPos] == delimiter) {
                inPos += width;
            }
            MDAddRun(stateP, start, outPos, style);
            continue;
        }
        if (value == '!' && stateP->input[inPos + 1] == '[') {
            if (MDFindImage(stateP->input, inPos, &imageEnd,
                            &pathStart, &pathEnd)) {
                if (stateP->imageCount < MD_MAX_IMAGES &&
                    MDImportImage(stateP, pathStart, pathEnd,
                                  &stateP->images[stateP->imageCount].gstring,
                                  &stateP->images[stateP->imageCount].size)) {
                    imageP = &stateP->images[stateP->imageCount++];
                    imageP->outputPos = outPos;
                } else if (!MDPutInputRange(stateP, &outPos,
                                            inPos, imageEnd)) {
                    return TE_IMPORT_ERROR;
                }
                inPos = imageEnd;
            } else if (!MDPut(stateP, &outPos, stateP->input[inPos++]) ||
                       !MDPut(stateP, &outPos, stateP->input[inPos++])) {
                return TE_IMPORT_ERROR;
            }
            continue;
        }
        if (value == '[' && MDHasLink(stateP->input, inPos)) {
            ++inPos;
            while (stateP->input[inPos] != ']') {
                if (!MDPut(stateP, &outPos, stateP->input[inPos++])) {
                    return TE_IMPORT_ERROR;
                }
            }
            inPos += 2;
            if (!MDPut(stateP, &outPos, ' ') ||
                !MDPut(stateP, &outPos, '(')) {
                return TE_IMPORT_ERROR;
            }
            while (stateP->input[inPos] != ')') {
                if (!MDPut(stateP, &outPos, stateP->input[inPos++])) {
                    return TE_IMPORT_ERROR;
                }
            }
            ++inPos;
            if (!MDPut(stateP, &outPos, ')')) {
                return TE_IMPORT_ERROR;
            }
            continue;
        }
        if (!MDPut(stateP, &outPos, value)) {
            return TE_IMPORT_ERROR;
        }
        ++inPos;
    }
    if (stateP->quote && !MDPut(stateP, &outPos, '"')) {
        return TE_IMPORT_ERROR;
    }
    stateP->textEnd = outPos;
    if (!MDPut(stateP, &outPos, C_CR)) {
        return TE_IMPORT_ERROR;
    }
    stateP->output[outPos] = C_NULL;
    if (stateP->heading != 0) {
        MDAddRun(stateP, stateP->headingStart, stateP->textEnd,
                 MD_STYLE_BOLD);
    }
    *lengthP = outPos;
    return TE_NO_ERROR;
}

void MDSetStyle(optr textObj, dword start, dword end, word style)
{
    TextStyle bits;

    bits = 0;
    if (style & MD_STYLE_BOLD) {
        bits |= TS_BOLD;
    }
    if (style & MD_STYLE_ITALIC) {
        bits |= TS_ITALIC;
    }
    @call textObj::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, 0, bits, end, start);
}

void MDApplyFormatting(MDState *stateP, dword base,
                                    word lineLength)
{
    word index;
    word size;
    MDRun *runP;
    WWFixed pointSize;

    for (index = 0; index < stateP->runCount; ++index) {
        runP = &stateP->runs[index];
        if (runP->style & MD_STYLE_CODE) {
            @call stateP->textObj::MSG_VIS_TEXT_SET_FONT_ID(
                FID_DTC_URW_MONO, base + runP->end, base + runP->start);
        }
        if (runP->style & (MD_STYLE_BOLD | MD_STYLE_ITALIC)) {
            MDSetStyle(stateP->textObj, base + runP->start,
                       base + runP->end, runP->style);
        }
    }
    if (stateP->heading != 0) {
        switch (stateP->heading) {
        case 1: size = 24; break;
        case 2: size = 18; break;
        case 3: size = 14; break;
        case 4: size = 12; break;
        case 5: size = 10; break;
        default: size = 9; break;
        }
        pointSize.WWF_int = size;
        pointSize.WWF_frac = 0;
        @call stateP->textObj::MSG_VIS_TEXT_SET_POINT_SIZE(
            pointSize, base + lineLength - 1, base);
    }
    if (stateP->quote) {
        MDSetStyle(stateP->textObj, base, base + lineLength - 1,
                   MD_STYLE_ITALIC);
    }
    /* Range changes also become the insertion attributes.  Restore the body
     * attributes before the next line is appended without changing its CR.
     */
    pointSize.WWF_int = 12;
    pointSize.WWF_frac = 0;
    @call stateP->textObj::MSG_VIS_TEXT_SET_FONT_ID(
        FID_DTC_URW_ROMAN, TEXT_ADDRESS_PAST_END, TEXT_ADDRESS_PAST_END);
    @call stateP->textObj::MSG_VIS_TEXT_SET_POINT_SIZE(
        pointSize, TEXT_ADDRESS_PAST_END, TEXT_ADDRESS_PAST_END);
    @call stateP->textObj::MSG_VIS_TEXT_SET_TEXT_STYLE(
        0, 0, TS_BOLD | TS_ITALIC, 0,
        TEXT_ADDRESS_PAST_END, TEXT_ADDRESS_PAST_END);
}

TransError _far _pascal MDReadAndImport(ImportFrame *frameP, optr textObj)
{
    MemHandle stateH;
    MDState *stateP;
    TransError error;
    word inputLength;
    word outputLength;
    dword base;

    stateH = MemAlloc(sizeof(MDState), HF_DYNAMIC,
                      HAF_ZERO_INIT | HAF_LOCK);
    if (stateH == NullHandle) {
        return TE_OUT_OF_MEMORY;
    }
    stateP = (MDState *)MemDeref(stateH);
    stateP->source = frameP->IF_sourceFile;
    stateP->frameP = frameP;
    stateP->textObj = textObj;
    stateP->transferFile = frameP->IF_transferVMFile;
    error = MDSkipBOM(stateP);
    while (error == TE_NO_ERROR && !stateP->eof) {
        error = MDReadLine(stateP, &inputLength);
        if (error != TE_NO_ERROR || stateP->eof) {
            break;
        }
        error = MDParseLine(stateP, &outputLength);
        if (error != TE_NO_ERROR) {
            break;
        }
        base = @call textObj::MSG_VIS_TEXT_GET_TEXT_SIZE();
        /* TextAllocClipboardObject creates this object on the import thread.
         * @call therefore copies the pointer data before this block is reused.
         */
        @call textObj::MSG_VIS_TEXT_APPEND_PTR(stateP->output, outputLength);
        MDApplyFormatting(stateP, base, outputLength);
        MDInsertImages(stateP, base);
    }
    if (error != TE_NO_ERROR) {
        MDDiscardImages(stateP);
    }
    if (stateP->imageLibrary != NullHandle) {
        GeodeFreeLibrary(stateP->imageLibrary);
    }
    MemUnlock(stateH);
    MemFree(stateH);
    return error;
}
