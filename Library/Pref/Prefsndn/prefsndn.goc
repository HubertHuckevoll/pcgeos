	ATTR_GEN_INIT_FILE_KEY ="aid";
        ATTR_GEN_ITEM_GROUP_STATUS_MSG = MSG_GEN_ITEM_GROUP_MM_STATE_2;

	HINT_FULL_JUSTIFY_CHILDREN_HORIZONTALLY;
        HINT_EXPAND_WIDTH_TO_FIT_PARENT;
