@localize "completes the sentence 'The system software will shut down and restart to change the ...' - keep it a lower case noun phrase";

@end REBOOTSTRINGRESOURCE;

@start  BASEINTERFACE, notDetachable;

/***********************

	BaseBox

 ***********************/

@object PrefDialogMMClass BaseBox = {
        GI_visMoniker = "Sound";
	GI_states = @default & ~GS_USABLE;
	GI_comp = @TitleGroup,
                  @SoundSubGroup,
		  @DriverEditGroup,
		  @SettingsBox;
	PDMMC_tocList = @TocList;

	HINT_INTERACTION_COMPLEX_PROPERTIES;
	HINT_ORIENT_CHILDREN_VERTICALLY;
	HINT_FULL_JUSTIFY_CHILDREN_HORIZONTALLY;
	HINT_CENTER_CHILDREN_HORIZONTALLY;
/*	ATTR_GEN_HELP_FILE = "prefsndn";	/**/
	ATTR_GEN_HELP_CONTEXT = "dbSound";
	ATTR_GEN_INIT_FILE_CATEGORY ="sound";
}

/**************
 * TitleGroup *
 **************/

@object GenInteractionClass TitleGroup = {
	GI_comp = @TitleGlyph,
		  @TitleHelpText;
	HINT_ORIENT_CHILDREN_HORIZONTALLY;
	HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object TitledGlyphClass TitleGlyph = {
	GI_visMoniker = list {@PrefTextMoniker,@Moniker0,@Moniker1,@Moniker2,@Moniker3};
}

@chunk char TEXT_TITLE_HELP[] = "The sounds produced by applications for errors, alarms, and other reasons can be turned on and off, and a sound driver can be selected.";
@localize "help text at the top of the Sound preferences panel";

@object GenTextClass TitleHelpText = {
    GI_attrs = @default |GA_READ_ONLY;
    GTXI_text = @TEXT_TITLE_HELP;

    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

/*****************
 * SoundSubGroup *
 *****************/

@object PrefInteractionClass SoundSubGroup = {
	GI_comp = @SoundEnableList, @StartupShutdownSoundList;
	HINT_ORIENT_CHILDREN_VERTICALLY;
	HINT_EXPAND_WIDTH_TO_FIT_PARENT;
        HINT_LEFT_JUSTIFY_CHILDREN;
}

@object PrefItemGroupClass SoundEnableList =
{
	GI_visMoniker = 'S',"Sound:";
	GI_comp = @SoundEnable,
		  @SoundDisable;
        GIGI_numSelections = 1;
	GIGI_selection =  TRUE;
	HINT_ORIENT_CHILDREN_HORIZONTALLY;
	ATTR_GEN_ITEM_GROUP_INIT_FILE_BOOLEAN;
	ATTR_GEN_INIT_FILE_CATEGORY = "ui";
	ATTR_GEN_INIT_FILE_KEY = "sound";
    ATTR_PREF_ITEM_GROUP_ENABLE = {
        TRUE, ChunkOf(@StartupShutdownSoundList), 0
    };
}

@visMoniker OnMoniker = "Yes";
@localize "generic affirmative answer, used for the Sound on/off choice and the sound card settings on/off choice";

@visMoniker OffMoniker = "No";
@localize "generic negative answer, used for the Sound on/off choice and the sound card settings on/off choice";


@object	GenItemClass SoundEnable =
{
 	GI_visMoniker = @OnMoniker;
	GII_identifier = TRUE;
}

@object	GenItemClass SoundDisable =
{
 	GI_visMoniker = @OffMoniker;
	GII_identifier = FALSE;
}

@object PrefBooleanGroupClass StartupShutdownSoundList = {
    GI_comp = @StartupShutdownSoundBoolean;
    GBGI_selectedBooleans = TRUE;
    ATTR_GEN_INIT_FILE_CATEGORY = "ui";
    ATTR_GEN_INIT_FILE_KEY = "startupShutdownSounds";
    ATTR_GEN_BOOLEAN_GROUP_INIT_FILE_BOOLEAN;
}

@object GenBooleanClass StartupShutdownSoundBoolean = {
    GI_visMoniker = 't', "Play startup and shutdown sounds";
    /* INI true is 0xffff; unchecking must clear every loaded bit. */
    GBI_identifier = TRUE;
}

