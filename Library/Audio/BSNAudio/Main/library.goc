/**************************************************

        BSNWavGetMaxProperties

        Requesting Maxrate, channels, bits

  IN:   *maxRate    Pointer Rate
        *maxChannels    Pointer channels
        *maxBits    Pointer Bits
  OUT:  maxRate, maxChannels, maxBits
        reverseFlag TRUE -> channels must be toggled (SBPro)

 *************************************************/

Boolean _pascal _export BSNWavGetMaxProperties(word *maxRate, byte *maxChannels, byte *maxBits)
{
    byte    reverseByte;
    word    rate = 22050;
    byte    channels = 1;
    byte    bits = 8;

    reverseByte = 0;

    // Is driver New-Wave compatible ?
    if (compatFlag)
    {
        BSNWAsmGetMaxProperties(BSNW_FARPTR(word, &rate),
                                BSNW_FARPTR(byte, &channels),
                                BSNW_FARPTR(byte, &bits),
                                BSNW_FARPTR(byte, &reverseByte));
    };

    // retVal
    *maxRate = rate;
    *maxChannels = channels;
    *maxBits = bits;

    return (reverseByte > 0);
}

/*************************************
 *
 *      BSNWaveStopRecOrPlay
 *
 *  Stopping Rec/Play
 *
 * IN:
 * OUT: TRUE    = Error
 *
 *************************************/

Boolean _pascal _export BSNWaveStopRecOrPlay(void *secPtr)
{
    Boolean back;
    word    back2;

    back2 = 0;

    // Clear Secondarybuffer
    if (secPtr)
    {
        BSNWFillSilence(secPtr,secBufLen);
    };

    if ( (simFlags == 0) && (compatFlag) )
    {
        back2 = BSNWAsmStopRecOrPlay();
    };

    // Errorflag
    back = (back2 > 0);

    return (back);
}

/* Legacy WAV playback adapter; the caller retains the file handle. */
int _pascal _export BSNWavePlayFile(FileHandle fh, word playFlags, optr parent)
{
    BSNWav wav;
    BSWavPlayPositions *posP;
    dword start, stop, frames, rate, fraction;
    int result;

    result = BSNWPreCheck(playFlags);
    if (result != BSNW_STATUS_OK)
        return result;
    playStatus = BSNW_STATUS_PLAY_FILE;
    result = BSNWavOpen(&wav, fh);
    if (result == BSNW_STATUS_OK)
    {
        lastFormat = wav.source.format;
        lastLength = wav.source.pcmBytes;
        rate = lastFormat.sampleRate;
        if (rate <= 5000 || rate >= 44200)
            result = BSNW_UNKNOWN_WAVE_FORMAT;
        if (result == BSNW_STATUS_OK && (playFlags & BSNW_PLAY_POS) &&
            !(playFlags & BSNW_SHOW_STATUS) && parent)
        {
            posP = (BSWavPlayPositions *)parent;
            frames = wav.remaining / lastFormat.blockAlign;
            /* Bound seconds before multiplication; clamp positions to EOF. */
            start = posP->BWPP_start / 1000;
            if (start > frames / rate)
                start = frames;
            else
            {
                start *= rate;
                fraction = (posP->BWPP_start % 1000) * rate / 1000;
                if (fraction > frames - start) start = frames;
                else start += fraction;
            }
            stop = posP->BWPP_stop / 1000;
            if (stop > frames / rate)
                stop = frames;
            else
            {
                stop *= rate;
                fraction = (posP->BWPP_stop % 1000) * rate / 1000;
                if (fraction > frames - stop) stop = frames;
                else stop += fraction;
            }
            if (stop <= start) stop = frames;
            start *= lastFormat.blockAlign;
            stop *= lastFormat.blockAlign;
            if (FilePos(fh, wav.dataOffset + start, FILE_POS_START) !=
                wav.dataOffset + start)
                result = BSNW_MEMORY_ERROR;
            wav.remaining = stop - start;
            wav.source.pcmBytes = wav.remaining;
            lastLength = wav.remaining;
        }
        if (result == BSNW_STATUS_OK && !(playFlags & BSNW_TEST_ONLY))
            result = BSNWRunPCM(&wav.source, playFlags, parent);
        BSNWavClose(&wav);
    }
    else
    {
        lastLength = 0;
    }
    if (result == BSNW_UNKNOWN_WAVE_FORMAT &&
        (playFlags & BSNW_SHOW_ERROR_MSG))
        BSNWaveDialogUnknownFormat(0);
    playStatus = BSNW_STATUS_OK;
    return result;
}

