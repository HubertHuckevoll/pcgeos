/**********************************************************

    BSNWaveCheckDriver

    Checking driver for NewWave-capability

  IN:   flags   BSNW_SHOW_ERROR_MSG
  OUT:  TRUE    NewWave will be support by the driver

 **********************************************************/

#ifndef DRE_SOUND_QUERY_DEVICE_CAPABILITY
#define DRE_SOUND_QUERY_DEVICE_CAPABILITY   12
#endif

// #define TEXT_WRONG_DRIVER   "Der Soundkartentreiber ist nicht NewWave-kompatibel !\rBitte einen geeigneten BestSound-Treiber installieren oder per eMail anfordern (dlausecker\x40snafu.de)."
#define TEXT_WRONG_DRIVER "The sound driver is not compatible with this program!"

Boolean _pascal _export BSNWaveCheckDriver(word flags, word testValue)
{
    word    state;
    word    numOfDACs;
    Boolean respond;

    state = 0;
    numOfDACs = 0;
    respond = FALSE;

    if (sampleDriver == NullHandle) {
        return respond;
    }

    // TestValue = 0 --> BSNW_DRIVER_TEST_VALUE (5)
    if (!testValue)
    {
        testValue = BSNW_DRIVER_TEST_VALUE;
    };

    numOfDACs = BSNWAsmQueryDeviceCapability();
    if (numOfDACs > 0)
    {
        state = BSNWAsmCheckSampleRate(testValue);
        respond = (state == testValue);
    }
    else
    {
        // The driver has no DAC-Channel
        // We clear the respond-Flag so the routine
        // will report -> "Driver doesn't support BSNWAV"
        respond = FALSE;
    };

    // Errormessage
@ifndef BSNWAV_NO_UI
    if ((!respond) && (flags & BSNW_SHOW_ERROR_MSG) )
    {
        (void)UserStandardDialog(   0,              //helpContext,
                                    0,              //customTriggers,
                                    0,              //arg2,
                                    0,              //arg1,
                                    TEXT_WRONG_DRIVER,
                                    (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)
                                    | (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET)      //dia
                                );
    };
@endif

    return (respond);
}

/************************************************************

    BSNWaveGetStatus

    Request State of soundcard

 IN:    -
 OUT:   word    high Byte = dacStatus
        low Byte = bsStatus

 dacStatus:
 Old flag used by old WAV-Output functions
 0 = idle (OK)

 bsStatus:
 NewWave-Play and Recording using the variable bsStatus
 for indicating status of the soundcard
 0 = idle (OK)

 for extracting use the macro BSEXDACSTATUS and BSEXBSSTATUS

 ***********************************************************/

word _pascal _export BSNWaveGetStatus(void)
{
    word    state = 0;

    if (compatFlag)
    {
        state = BSNWAsmGetStatus();
    };

    return (state);
}


/******************************************************************

    BSNWavePlayCallback

        Main function for playing sample data over callback

 Descr:
        use this function if you want create or load the
        sample data by yourself (for example decoded MP3 data ;-)
        Can be stopped by calling  BSNWaveStop()

 IN:    (BSWavFormChunk)*bfc    Sampleformat
        word                    playFlags

 ******************************************************************/

typedef word _pascal BSNLegacyReadCall(void *destP, word capacity,
                                     void *readerP);

word _pascal _export BSNWLegacyPCM(void *contextP, void *destP,
                                           word capacity)
{
    return ((BSNLegacyReadCall *)ProcCallFixedOrMovable_pascal)(
        destP, capacity, contextP) ? BSN_PCM_READ_ERROR : capacity;
}

int _pascal _export BSNWavePlayCallback(BSWavFormChunk *bfc, dword bytes,
                                        word playFlags, optr parent,
                                        PCB(word,routine,(void *,word)))
{
    if (!routine)
        return BSNW_SOURCE_ERROR;
    return BSNWavePlayPCM(bfc, bytes, playFlags, parent, routine,
                          BSNWLegacyPCM);
}

/*
 * General PCM producer interface. The source can be WAV, MP3, or any
 * other producer that delivers interleaved 8/16-bit PCM samples.
 */

int _pascal _export BSNWavePlayPCM(BSWavFormChunk *fmt, dword pcmBytes,
                                   word playFlags, optr parent, void *context,
                                   PCB(word,reader,(void *,void *,word)))
{
    BSNPcmSource source;

    if (!fmt || fmt->BWFC_dataFormat != BSWN_FORMAT_PCM)
        return BSNW_UNKNOWN_WAVE_FORMAT;
    source.format.sampleRate = fmt->BWFC_sampleRate;
    source.format.channels = fmt->BWFC_channels;
    source.format.bitsPerSample = fmt->BWFC_bitsPerSample;
    source.format.blockAlign = fmt->BWFC_blockAlign;
    source.format.avgBytesPerSecond = fmt->BWFC_avgRate;
    source.pcmBytes = pcmBytes;
    source.readP = reader;
    source.contextP = context;
    return BSNPcmPlay(&source, playFlags, parent);
}

