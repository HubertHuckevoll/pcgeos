void BSNWDebugNotifyWord(const char *label, word value)
{
    const char hex[] = "0123456789ABCDEF";
    char      buf[32] = {0};
    char     *ptr = buf;

    if (label != NULL)
    {
        while (*label && ptr < (buf + 24))
        {
            *ptr++ = *label++;
        }
        *ptr++ = '=';
    }

    *ptr++ = '0';
    *ptr++ = 'x';
    *ptr++ = hex[(value >> 12) & 0xF];
    *ptr++ = hex[(value >> 8) & 0xF];
    *ptr++ = hex[(value >> 4) & 0xF];
    *ptr++ = hex[value & 0xF];
    *ptr   = '\0';

    SysNotify(SNF_CONTINUE, buf, 0);
}

