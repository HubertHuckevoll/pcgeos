/**********************************************************
    Internal Functions
 **********************************************************/

int _pascal BSNWPrepare(BSNPcmFormat *bfc,word playFlags,optr parent);
int _pascal BSNWPlay(BSNPcmFormat *bfc,word playFlags,optr parent);

// from subcode.goc
extern void BSNWDebugNotifyWord(const char *label, word value);

/*
 * All playback entry points converge here. The source has already been
 * selected, and bytesToPlay specifies its remaining PCM byte budget.
 * BSNWPlay owns the prepared buffers until playback finishes.
 */
static int _pascal BSNWRunPCM(BSNPcmSource *sourceP, word playFlags, optr parent)
{
    int result;
    word configuredCacheLen = playCacheLen;

    playSourceP = sourceP;
    pcmBlockAlign = sourceP->format.blockAlign;
    pcmUnknownLength = (sourceP->pcmBytes == BSN_PCM_LENGTH_UNKNOWN);
    bytesToPlay = sourceP->pcmBytes;
    if (!bytesToPlay)
    {
        playStatus = BSNW_STATUS_OK;
        playSourceP = (void *)0;
        return BSNW_STATUS_OK;
    }
    result = BSNWPrepare(&sourceP->format, playFlags, parent);
    if (result == BSNW_STATUS_OK)
    {
        result = BSNWPlay(&sourceP->format, playFlags, parent);
    }
    else
    {
        /* A failed prepare never reaches BSNWPlay's ordinary cleanup. */
        if (secondPtr)
        {
            (void)BSNWaveStopRecOrPlay(secondPtr);
        }
        if (playCachePtr)
        {
            MemUnlock(playCacheHandle);
            MemFree(playCacheHandle);
            playCachePtr = 0;
        }
        playStatus = BSNW_STATUS_OK;
    }

    /* Short sources shrink the active cache, not the next playback's default. */
    playCacheLen = configuredCacheLen;
    playSourceP = (void *)0;
    return result;
}


