#include <Ansi/string.h>

typedef MemHandle ImpGIFHandle ;
extern void _pascal ImpGIFDestroy(ImpGIFHandle mem) ;


/*****************************************************************************
 *  Global variables set by library initalization                            *
 *****************************************************************************/

Boolean initGlobals = FALSE;
Boolean doCompress = TRUE;
Boolean useSysPal = TRUE;
Boolean allowAnimations = TRUE;

void InitGlobals(void)
{
  DisplayClass displayClass ;
  DisplayScheme display ;

  if(!initGlobals)                      // init global variables only once
  {
    initGlobals = TRUE;

    /* if TRUE, we'll compress bitmap */
    InitFileReadBoolean("impgraph", "compress", &doCompress);

    /* Only use the system palette if we are in a video mode that is */
    /* 256 or less. */
    @call application::MSG_GEN_APPLICATION_GET_DISPLAY_SCHEME(&display) ;
    displayClass = (display.DS_displayType & DT_DISP_CLASS) ;

    if (displayClass <= DC_COLOR_8)
        useSysPal = TRUE ;
    else
        useSysPal = FALSE ;

    /* Ini will override */
    InitFileReadBoolean("impgraph", "useSysPalForGIF", &useSysPal);

  }
}


/*****************************************************************************
 *  GIF import - main routine                                                *
 *****************************************************************************/

ImpBmpStatus ImpGIF(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          ImpBmpParams *params, Boolean *isAnimation, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, VMFileHandle destFile,
          ImportState *importProgressDataP,
		  Boolean locAllowAnimations)
{
    ImpBmpStatus status;
    MemHandle mem ;
    AnimationHeader *p_header ;
    VMChain *p_chain ;

  params->IBP_bitmap = NullHandle ;
  params->IBP_dest = vmf;
  params->IBP_status = 0;              /* no status object */
  /* destination file for animated GIFs, they are written directly
     to destination file, not copied there later */
  params->IBP_animDest = destFile;
  /* point to import progress data */
  params->IBP_importProgressDataP = importProgressDataP;

  if (!locAllowAnimations)  {
      /* ATTENTION: This path is file-only. Use the animation-capable
       * importer for streaming, including single-frame GIFs. */
      if (importProgressDataP && importProgressDataP->IPD_inputP)
          return IBS_WRONG_FILE;
      params->IBP_source = FileOpen(file, FILE_ACCESS_R|FILE_DENY_W);

      if(!params->IBP_source)              /* error opening file: abort */
        return 0;

      status = ImpGIFProcessFile(
                   params,
                   watcher,
                   usedMem,
                   resolution,
                   useSysPal,
                   MSG_SB_SET_STATUS_VALUE);

      /* Note if we got the whole graphic */
      if (status == IBS_IMPORT_STOPPED)
          iad->IAD_completeGraphic = FALSE ;
      else
          iad->IAD_completeGraphic = TRUE ;

      if (params->IBP_source)
          FileClose(params->IBP_source,TRUE);  /* close source file */

      *isCompacted = FALSE ;
  } else {
      status = ImpGIFProcessAnimationFile(
                   params,
                   file,
                   watcher,
                   usedMem,
                   resolution,
                   useSysPal,
                   MSG_SB_SET_STATUS_VALUE,
                   isAnimation,
                   &iad->IAD_completeGraphic);
      *isCompacted = TRUE ;
  }
  /* Load up to the abort point. */
  if ((status == IBS_IMPORT_STOPPED) && (params->IBP_bitmap != NullHandle))  {
      /* If we don't even have a first frame, then delete the whole thing */
      if (!*isAnimation)  {
          /* Only dump if we are not progressive */
          if (!importProgressDataP->keepPartial)  {
              FreeViaProgress(importProgressDataP, params->IBP_dest, params->IBP_bitmap);

              /* Destroy the bitmap, but return the used memory count */
              AllocWatcherFree(watcher, *usedMem) ;
              *usedMem = 0 ;
              params->IBP_width = params->IBP_height = 1 ;
              params->IBP_bitmap = NullHandle ;
          }
      } else {
          /* We have at least one frame of this graphic.  Convert it to a single */
          /* frame image */
          VMBlockHandle originalBitmap = params->IBP_bitmap ;
          dword amountUsed ;
          int i ;

          /* Get access to each frame's animation */
          p_header = VMLock(params->IBP_animDest, params->IBP_bitmap, &mem) ;
          p_chain = (VMChain *)(((byte *)p_header) + p_header->AH_tree.VMCT_offset) ;

          /* Keep the first one */
          params->IBP_bitmap = VMCHAIN_GET_VM_BLOCK(*(p_chain++)) ;

          /* Delete the rest */
          for (i=1; i<p_header->AH_tree.VMCT_count; i++, p_chain++)
              VMFreeVMChain(params->IBP_animDest, *p_chain) ;

          /* Now delete the no longer needed header */
          VMUnlock(mem) ;
          VMFree(params->IBP_animDest, originalBitmap) ;

          /* Sorry, not an animation anymore */
          *isAnimation = FALSE ;

          /* Free up what we said we were using in memory */
          AllocWatcherFree(watcher, *usedMem) ;
          *usedMem = 0 ;

          /* Now allocate the lesser amount (ensuring we get it) */
          amountUsed = params->IBP_width ;
          amountUsed *= params->IBP_height ;
          if (AllocWatcherAllocate(watcher, amountUsed))
              *usedMem = amountUsed ;
      }
  }

  iad->IAD_size.XYS_width = params->IBP_width;
  iad->IAD_size.XYS_height = params->IBP_height;

  if (params->IBP_mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT)
      status = IBS_IMPORT_STOPPED;

  if ((status == IBS_NO_ERROR) || (status == IBS_IMPORT_STOPPED))
    *bmVMBlock = params->IBP_bitmap;
  else
    *bmVMBlock = 0;

    return status;
}


/*****************************************************************************
 *  JPEG import - main routine                                               *
 *****************************************************************************/

ImpBmpStatus ImpJPG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, ImportState *importProgressDataP,
          MimeStatus *mimeStatus)
{
    ImpBmpStatus status;
#if SCANLINE_COMPRESS
    Boolean scanlineCompress = TRUE;
#endif

    /* we don't override scanlineCompress even if no progress display
       as it still seems faster than GrCompactBitmap */
#if SCANLINE_COMPRESS
    if (doCompress) {
	/* if TRUE, we'll compress per-scanline */
	InitFileReadBoolean("impgraph", "scanlineCompress", &scanlineCompress);
    } else {
	scanlineCompress = FALSE;
    }
#endif

    iad->IAD_completeGraphic = FALSE ;

@ifdef PRODUCT_FJPEG
    *bmVMBlock =
        FJpegImport(file, vmf, &(iad->IAD_size), resolution, watcher, usedMem,
#if SCANLINE_COMPRESS
	        scanlineCompress,
#endif
            &iad->IAD_completeGraphic
	        , importProgressDataP
            , mimeStatus
           );

    /* if fast import failed, try using IJGJPEG library */
    /* Probe rejection can replay retained input; consumed stream data cannot. */
    if (!*bmVMBlock && !importProgressDataP->streamStarted &&
        !(mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT))
    {
@endif
        *bmVMBlock =
            JpegImport(file, vmf, &(iad->IAD_size), resolution, watcher, usedMem,
#if SCANLINE_COMPRESS
	            scanlineCompress,
#endif
                &iad->IAD_completeGraphic
	            , importProgressDataP
                , mimeStatus
           );
@ifdef PRODUCT_FJPEG
    }
@endif

#if SCANLINE_COMPRESS
    if (scanlineCompress) *isCompacted = TRUE;
#endif
    if (*bmVMBlock) {
      status = IBS_NO_ERROR;
      params->IBP_bitmap = *bmVMBlock;
    }
    else
      status = (mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT) ?
          IBS_IMPORT_STOPPED : (importProgressDataP->recognized ?
          IBS_WRONG_FILE : IBS_UNKNOWN_FORMAT);

    return status;
}

/********************************************************************
 ImpPNG
 *******************************************************************/

ImpBmpStatus ImpPNG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, ImportState *importProgressDataP,
          MimeStatus *mimeStatus)
{
    ImpBmpStatus status = IBS_NO_ERROR;

    if (importProgressDataP->IPD_inputP)
        return IBS_UNKNOWN_FORMAT;

    *bmVMBlock = PngImport(file, vmf, &(iad->IAD_size), resolution, watcher, usedMem,
    &iad->IAD_completeGraphic
	, importProgressDataP
    , mimeStatus
    );

/*
    FIXME: SCANLINE_COMPRESS
    We don't do the improved scanline compression as of now
    (see "doCompress" in ImpJPG).
    So we return false in "isCompacted" and at least the
    (painfully slow) GrCompactBitmap will be called on
    the bitmap in our caller...
*/
    *isCompacted = FALSE;

    if (*bmVMBlock)
    {
      status = IBS_NO_ERROR;
      params->IBP_bitmap = *bmVMBlock;
    }
    else
    {
      status = (mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT) ?
          IBS_IMPORT_STOPPED : IBS_UNKNOWN_FORMAT;
      params->IBP_bitmap = NullHandle;
    }

    return status;
}

/*****************************************************************************
 *  SVG import - main routine                                                *
 *****************************************************************************/

ImpBmpStatus _pascal ImpSVG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, ImportState *importProgressDataP,
          MimeStatus *mimeStatus)
{
    FileHandle srcFile;
    VMChain gstringChain;
    RectDWord bounds;
    sdword width;
    sdword height;
    TransError error;

    (void)resolution;
    (void)watcher;
    (void)doCompress;
    (void)importProgressDataP;

    params->IBP_bitmap = NullHandle;
    params->IBP_dest = vmf;
    params->IBP_status = 0;
    *bmVMBlock = NullHandle;
    *isCompacted = FALSE;
    iad->IAD_completeGraphic = FALSE;
    *usedMem = 0;

    if (importProgressDataP->IPD_inputP)
        return IBS_UNKNOWN_FORMAT;

    srcFile = FileOpen(file, FILE_ACCESS_R | FILE_DENY_W);
    if (!srcFile)
    {
        return IBS_UNKNOWN_FORMAT;
    }

    /* ATTENTION: Boolean is sword; MS_mimeFlags is word with only ABORT.
     * If other flags are added, supply a separate live Boolean. */
    error = SvgImport(srcFile, vmf, &gstringChain, &bounds,
                      (SvgProgressCallback *)0,
                      (const volatile Boolean *)&mimeStatus->MS_mimeFlags);
    if (error != TE_NO_ERROR)
    {
        FileClose(srcFile, TRUE);
        if (mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT)
            return IBS_IMPORT_STOPPED;
        return (error == TE_OUT_OF_MEMORY) ? IBS_NO_MEMORY : IBS_UNKNOWN_FORMAT;
    }

    width = bounds.RD_right - bounds.RD_left;
    height = bounds.RD_bottom - bounds.RD_top;
    if (bounds.RD_left < -32768L || bounds.RD_left > 32767L ||
        bounds.RD_top < -32768L || bounds.RD_top > 32767L ||
        width <= 0 || width > 32767L ||
        height <= 0 || height > 32767L)
    {
        VMFreeVMChain(vmf, gstringChain);
        FileClose(srcFile, TRUE);
        return IBS_UNKNOWN_FORMAT;
    }

    iad->IAD_size.XYS_width = (word)width;
    iad->IAD_size.XYS_height = (word)height;

    FileClose(srcFile, TRUE);
    *bmVMBlock = VMCHAIN_GET_VM_BLOCK(gstringChain);
    params->IBP_bitmap = *bmVMBlock;
    iad->IAD_type = IAD_TYPE_GSTRING;
    iad->IAD_origin.P_x = (sword)bounds.RD_left;
    iad->IAD_origin.P_y = (sword)bounds.RD_top;
    iad->IAD_completeGraphic = TRUE;

    return IBS_NO_ERROR;
}


/*****************************************************************************
 *  Common code for GIF and JPEG formats                                     *
 *****************************************************************************/

/* Publication records outlive every decoder/fallback and compaction. */
static Boolean _pascal ImportWasPublished(ImportState *stateP,
    VMFileHandle fileH, VMBlockHandle imageH)
{
    MemHandle blockH, nextH;
    ImportPublications *blockP;
    word i;

    for (blockH = stateP->publicationsH; blockH; blockH = nextH) {
        blockP = MemLock(blockH);
        for (i = 0; i < blockP->count; i++) {
            if (blockP->images[i].fileH == fileH &&
                blockP->images[i].imageH == imageH) {
                MemUnlock(blockH);
                return TRUE;
            }
        }
        nextH = blockP->nextH;
        MemUnlock(blockH);
    }
    return FALSE;
}

void _pascal ImportPublish(_ImportStateParams_)
{
    ImportState *stateP = importProgressDataP;
    ImportPublications *blockP;
    MemHandle blockH;
    ImageImportUpdate update;

    if (!stateP->updatesP || !stateP->IPD_vmFile || !stateP->IPD_bitmap ||
        !stateP->IPD_iad.IAD_size.XYS_width ||
        !stateP->IPD_iad.IAD_size.XYS_height ||
        stateP->IPD_firstLine > stateP->IPD_lastLine ||
        stateP->IPD_lastLine >= stateP->IPD_iad.IAD_size.XYS_height)
        return;
    if (!ImportWasPublished(stateP, stateP->IPD_vmFile, stateP->IPD_bitmap)) {
        blockH = stateP->publicationsH;
        blockP = blockH ? MemLock(blockH) : (void*)0;
        if (!blockP || blockP->count == IMPORT_PUBLICATIONS_PER_BLOCK) {
            if (blockP)
                MemUnlock(blockH);
            blockH = MemAlloc(sizeof(ImportPublications), HF_DYNAMIC,
                HAF_ZERO_INIT);
            /* No ownership transfer if we cannot remember it. */
            if (!blockH)
                return;
            blockP = MemLock(blockH);
            blockP->nextH = stateP->publicationsH;
            stateP->publicationsH = blockH;
        }
        blockP->images[blockP->count].fileH = stateP->IPD_vmFile;
        blockP->images[blockP->count++].imageH = stateP->IPD_bitmap;
        MemUnlock(blockH);
    }
    update.vmFile = stateP->IPD_vmFile;
    update.bitmap = stateP->IPD_bitmap;
    update.info = stateP->IPD_iad;
    update.firstLine = stateP->IPD_firstLine;
    update.lastLine = stateP->IPD_lastLine;
    ((pcfm_ImageImportUpdate *)ProcCallFixedOrMovable_pascal)(
        stateP->updatesP->clientDataP, &update, stateP->updatesP->callback);
}

void _pascal FreeViaProgress(_ImportStateParams_, VMFileHandle fileH,
    VMBlockHandle imageH)
{
    if (imageH && !ImportWasPublished(importProgressDataP, fileH, imageH))
        VMFreeVMChain(fileH, VMCHAIN_MAKE_FROM_VM_BLOCK(imageH));
}

static void _pascal ImportForgetPublications(ImportState *stateP)
{
    MemHandle blockH;
    ImportPublications *blockP;

    while ((blockH = stateP->publicationsH) != 0) {
        blockP = MemLock(blockH);
        stateP->publicationsH = blockP->nextH;
        MemUnlock(blockH);
        MemFree(blockH);
    }
}

/*
 *  Import file whose name is specified in *file, assume it has the MIME
 *  type that is passed in *mimeType. The file is converted to a VMChain
 *  in the file specified by vmf. The size of the objects bounding box is
 *  passed back in *size.
 */
ImageImportStatus _pascal _export MimeDrvGraphicEx(_MimeGraphicParams_)
{
	Boolean locAllowAnimations;
	Boolean locCompress;
    ImpBmpParams params;
    ImpBmpStatus status;
    VMBlockHandle dataVMBlock,bmVMBlock = NullHandle;
    Boolean isAnimation = FALSE ;
    Boolean isCompacted = FALSE ;
    ImportState state;
    ImportState *importProgressDataP = &state;
    MimeStatus noCancel = {0};
    MimeStatus *mimeStatus;
    VMFileHandle vmf = destinationH, destFile = destinationH;
    TCHAR *file, *mimeType;
    MimeRes resolution;
    AllocWatcherHandle watcher;
    Boolean ownWatcher;
    ImageAdditionalData *iad;
    dword *usedMem;
    dword extFlags;
    ImageImportStatus outcome;

    if (!resultP)
        return IMAGE_IMPORT_INVALID;
    memset(resultP, 0, sizeof(*resultP));
    if (!sourceP || !destinationH || !optionsP || !optionsP->mimeTypeP ||
        (updatesP && !updatesP->callback) ||
        (optionsP->flags & ~(MIME_GREX_NO_ANIMATIONS |
                            MIME_GREX_NO_SCANLINE_COMPRESS)))
        return IMAGE_IMPORT_INVALID;
    memset(&state, 0, sizeof(state));
    memset(&params, 0, sizeof(params));
    if (sourceP->type == IIS_FILE) {
        if (!sourceP->data.filenameP || !*sourceP->data.filenameP)
            return IMAGE_IMPORT_INVALID;
        file = (TCHAR *)sourceP->data.filenameP;
    } else if (sourceP->type == IIS_STREAM) {
        if (!sourceP->data.inputP || !sourceP->data.inputP->callback)
            return IMAGE_IMPORT_INVALID;
        state.IPD_inputP = sourceP->data.inputP;
        file = (TCHAR *)_TEXT("");
        if (!strcmp(optionsP->mimeTypeP, _TEXT("image/png")) ||
            !strcmp(optionsP->mimeTypeP, _TEXT("image/webp")) ||
            !strcmp(optionsP->mimeTypeP, _TEXT("image/svg+xml")) ||
            ((optionsP->flags & MIME_GREX_NO_ANIMATIONS) &&
             !strcmp(optionsP->mimeTypeP, _TEXT("image/gif"))))
            return IMAGE_IMPORT_UNSUPPORTED;
    } else {
        return IMAGE_IMPORT_INVALID;
    }
    mimeType = (TCHAR *)optionsP->mimeTypeP;
    resolution = optionsP->resolution;
    extFlags = optionsP->flags;
    watcher = optionsP->watcherH;
    ownWatcher = !watcher;
    if (ownWatcher) {
        watcher = AllocWatcherCreate(0xffffffffUL);
        if (!watcher)
            return IMAGE_IMPORT_FAILURE;
    }
    mimeStatus = optionsP->cancelP ? optionsP->cancelP : &noCancel;
    state.updatesP = updatesP;
    state.keepPartial = optionsP->keepPartial;
    state.IPD_vmFile = vmf;
    state.IPD_iad.IAD_type = IAD_TYPE_BITMAP;
    iad = &resultP->info;
    usedMem = &resultP->usedMem;
    status = IBS_UNKNOWN_FORMAT;

    InitGlobals();                      /* Handled cached INI entries */

    iad->IAD_type = IAD_TYPE_BITMAP;
    iad->IAD_origin.P_x = iad->IAD_origin.P_y = 0;

	locAllowAnimations = allowAnimations;
	locCompress = doCompress;

	if(extFlags & MIME_GREX_NO_ANIMATIONS) {

		locAllowAnimations = FALSE;
	}
	if(extFlags & MIME_GREX_NO_SCANLINE_COMPRESS) {

		locCompress = FALSE;
	}

    params.IBP_mimeStatus = mimeStatus ;
    if (mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT) {
        if (ownWatcher)
            AllocWatcherDestroy(watcher);
        return IMAGE_IMPORT_CANCELED;
    }
  #define IMP_DESTFILE_PARAM , destFile
  #define IMP_PROGRESS_PARAM , importProgressDataP

#define IMP_GIF_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          &params, &isAnimation, &isCompacted, &bmVMBlock \
          IMP_DESTFILE_PARAM IMP_PROGRESS_PARAM, locAllowAnimations
#define IMP_JPG_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          locCompress, &params, &isCompacted, &bmVMBlock IMP_PROGRESS_PARAM \
          , mimeStatus
#define IMP_PNG_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          locCompress, &params, &isCompacted, &bmVMBlock IMP_PROGRESS_PARAM \
          , mimeStatus
#define IMP_WEBP_PARAMS file, vmf, iad, watcher, usedMem, &params, \
          &isCompacted, &bmVMBlock IMP_PROGRESS_PARAM, mimeStatus
#define IMP_SVG_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          locCompress, &params, &isCompacted, &bmVMBlock IMP_PROGRESS_PARAM \
          , mimeStatus



    if (!*mimeType || strcmp(mimeType, _TEXT("image/gif")) == 0)
    {
        status = ImpGIF(IMP_GIF_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpPNG(IMP_PNG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpWebP(IMP_WEBP_PARAMS);
    }
    else if (strcmp(mimeType, _TEXT("image/jpeg")) == 0 ||
	     strcmp(mimeType, _TEXT("image/jpg")) == 0)
    {
        status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpGIF(IMP_GIF_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpPNG(IMP_PNG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpWebP(IMP_WEBP_PARAMS);
    }
    else if (strcmp(mimeType, _TEXT("image/png")) == 0)
    {
        status = ImpPNG(IMP_PNG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpGIF(IMP_GIF_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpWebP(IMP_WEBP_PARAMS);
    }
    else if (strcmp(mimeType, _TEXT("image/webp")) == 0)
    {
        status = ImpWebP(IMP_WEBP_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpPNG(IMP_PNG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpGIF(IMP_GIF_PARAMS);
    }
    else if (strcmp(mimeType, _TEXT("image/svg+xml")) == 0)
    {
        status = ImpSVG(IMP_SVG_PARAMS);
    }


    if (bmVMBlock)                       /* check if import successful */
    {
      /* Compact static bitmaps. GStrings are already ready for the cache. */
      if (!isAnimation)  {
	  /* Compact the bitmap if not already */
	  if (iad->IAD_type == IAD_TYPE_BITMAP &&
	      !isCompacted && locCompress)  {
	      VMBlockHandle bmCompacted;

	      bmCompacted = GrCompactBitmap(vmf, bmVMBlock, vmf);
	      if(bmCompacted)
	      {
		  FreeViaProgress(importProgressDataP, vmf, bmVMBlock);
		  bmVMBlock = bmCompacted;
	      }
	  }

	  dataVMBlock = bmVMBlock;
      } else {
          iad->IAD_type = IAD_TYPE_ANIMATION; /* returned data is an animation */
          dataVMBlock = bmVMBlock ;
      }
    }
    else
      dataVMBlock = 0;                  /* import did not succeed */

    if (dataVMBlock && !iad->IAD_completeGraphic && !state.keepPartial) {
        FreeViaProgress(&state, vmf, dataVMBlock);
        AllocWatcherFree(watcher, *usedMem);
        dataVMBlock = 0;
    }
    if (mimeStatus->MS_mimeFlags & MIME_STATUS_ABORT)
        outcome = IMAGE_IMPORT_CANCELED;
    else if (dataVMBlock)
        outcome = iad->IAD_completeGraphic ? IMAGE_IMPORT_SUCCESS : IMAGE_IMPORT_PARTIAL;
    else
        outcome = IMAGE_IMPORT_FAILURE;
    resultP->bitmap = dataVMBlock;
    if (!dataVMBlock)
        memset(resultP, 0, sizeof(*resultP));
    ImportForgetPublications(&state);
    if (ownWatcher)
        AllocWatcherDestroy(watcher);
    return outcome;
}

char * _pascal _export MimeDrvInfo(_MimeInfoParams_)
{
    #define FORMATS _TEXT("image/gif\0")       /* MIME type of supported format */ \
                      _TEXT("GIF\0")           /* primary suggested extension */ \
                      _TEXT("\0")              /* end of extension list */ \
                    _TEXT("image/jpg\0") \
                      _TEXT("JPG\0") \
                      _TEXT("\0") \
                    _TEXT("image/jpeg\0") \
                      _TEXT("JPG\0") \
                      _TEXT("\0") \
                    _TEXT("image/png\0") \
                      _TEXT("PNG\0") \
                      _TEXT("\0") \
                    _TEXT("image/webp\0") \
                      _TEXT("WEBP\0") \
                      _TEXT("\0") \
                    _TEXT("image/svg+xml\0") \
                      _TEXT("SVG\0") \
                      _TEXT("\0") \
                    _TEXT("\0")                /* end of format list */

    /* Return list of supported formats */
    return memcpy(buf, FORMATS, sizeof(FORMATS));
}

#pragma argsused
char * _pascal _export MimeDrvText(_MimeTextParams_)
{
   /* This is a graphics driver that likes to be called for returning an
      image, rather than for returning a text transfer item. */

   tad->TAD_type = TAD_TYPE_REQUEST_IMG;

   return 0;                            /* anything... */
}

ImageImportStatus _pascal _export MimeDrvGraphic(_MimeGraphicParams_)
{
    return MimeDrvGraphicEx(sourceP, destinationH, optionsP, updatesP, resultP);
}
