typedef MemHandle ImpGIFHandle ;
extern void _pascal ImpGIFDestroy(ImpGIFHandle mem) ;

typedef struct {
    ImpGraphFormat format;
    Boolean compress;
    Boolean useSystemPalette;
    optr status;
} ImpGraphResolvedParams;

typedef enum {
    IMPGRAPH_WARNING_DIRECT_PARAMS_TOO_SMALL = 1,
    IMPGRAPH_WARNING_DIRECT_FORMAT_INVALID,
    IMPGRAPH_WARNING_DIRECT_SOURCE_RESET_FAILED,
    IMPGRAPH_WARNING_DIRECT_FORMAT_NOT_RECOGNIZED,
    IMPGRAPH_WARNING_DIRECT_WATCHER_CREATE_FAILED,
    IMPGRAPH_WARNING_DIRECT_PNG_DECODE_FAILED,
    IMPGRAPH_WARNING_DIRECT_JPEG_DECODE_FAILED,
    IMPGRAPH_WARNING_DIRECT_GIF_DECODE_FAILED,
    IMPGRAPH_WARNING_DIRECT_GRAPHIC_INCOMPLETE,
    IMPGRAPH_WARNING_DIRECT_BITMAP_MISSING,
    IMPGRAPH_WARNING_DIRECT_FILENAME_INVALID,
    IMPGRAPH_WARNING_DIRECT_DEST_FILE_INVALID,
    IMPGRAPH_WARNING_DIRECT_FILE_OPEN_FAILED,
    IMPGRAPH_WARNING_DIRECT_SOURCE_HANDLE_INVALID
} Warnings;

/* Force the warning names into the EC symbols for Swat's why-warning. */
#if ERROR_CHECK
Warnings impGraphWarnings;
#endif

typedef char ImpGraphImportParamsV1SizeCheck[
    (sizeof(ImpGraphImportParams) == IMP_GRAPH_IMPORT_PARAMS_V1_SIZE) ? 1 : -1];


/*****************************************************************************
 *  Global variables set by library initalization                            *
 *****************************************************************************/

Boolean initGlobals = FALSE;
Boolean doCompress = TRUE;
Boolean useSysPal = TRUE;
Boolean allowAnimations = TRUE;

void InitGlobals(void)
{
  DisplayClass displayClass ;
  DisplayScheme display ;

  if(!initGlobals)                      // init global variables only once
  {
    initGlobals = TRUE;

    /* if TRUE, we'll compress bitmap */
    InitFileReadBoolean("impgraph", "compress", &doCompress);

    /* Only use the system palette if we are in a video mode that is */
    /* 256 or less. */
    @call application::MSG_GEN_APPLICATION_GET_DISPLAY_SCHEME(&display) ;
    displayClass = (display.DS_displayType & DT_DISP_CLASS) ;

    if (displayClass <= DC_COLOR_8)
        useSysPal = TRUE ;
    else
        useSysPal = FALSE ;

    /* Ini will override */
    InitFileReadBoolean("impgraph", "useSysPalForGIF", &useSysPal);

    #if !PROGRESS_DISPLAY
      /* I don't want to write the data stream support in the assembly
         ImpGIFProcessFile routine, so we don't support no-animations for
         progress display */
      InitFileReadBoolean("impgraph", "allowAnimations", &allowAnimations) ;
    #endif
  }
}


/*****************************************************************************
 *  GIF import - main routine                                                *
 *****************************************************************************/

#if PROGRESS_DISPLAY
ImpBmpStatus ImpGIF(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          ImpBmpParams *params, Boolean *isAnimation, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, VMFileHandle destFile,
          ImportProgressData *importProgressDataP,
		  Boolean locAllowAnimations, FileHandle suppliedFile,
          Boolean locUseSysPal, optr statusOptr)
#else
ImpBmpStatus ImpGIF(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          ImpBmpParams *params, Boolean *isAnimation, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock,
		  Boolean locAllowAnimations, FileHandle suppliedFile,
          Boolean locUseSysPal, optr statusOptr)
#endif
{
    ImpBmpStatus status;
    MemHandle mem ;
    AnimationHeader *p_header ;
    VMChain *p_chain ;
    Boolean ownsFile = FALSE;

  params->IBP_bitmap = NullHandle ;
  params->IBP_dest = vmf;
  params->IBP_status = statusOptr;
#if PROGRESS_DISPLAY
  /* destination file for animated GIFs, they are written directly
     to destination file, not copied there later */
  params->IBP_animDest = destFile;
  /* point to import progress data */
  params->IBP_importProgressDataP = importProgressDataP;
#endif

  if (!locAllowAnimations)  {
      if (suppliedFile) {
          params->IBP_source = suppliedFile;
      } else {
          params->IBP_source = FileOpen(file, FILE_ACCESS_R|FILE_DENY_W);
          ownsFile = TRUE;
      }

      if(!params->IBP_source)              /* error opening file: abort */
        return 0;

      status = ImpGIFProcessFile(
                   params,
                   watcher,
                   usedMem,
                   resolution,
                   locUseSysPal,
                   MSG_SB_SET_STATUS_VALUE);

      /* Note if we got the whole graphic */
      if (status == IBS_IMPORT_STOPPED)
          iad->IAD_completeGraphic = FALSE ;
      else
          iad->IAD_completeGraphic = TRUE ;

      if (ownsFile && params->IBP_source)
          FileClose(params->IBP_source,TRUE);  /* close source file */

      *isCompacted = FALSE ;
  } else {
      status = ImpGIFProcessAnimationFile(
                   params,
                   file,
                   watcher,
                   usedMem,
                   resolution,
                   locUseSysPal,
                   MSG_SB_SET_STATUS_VALUE,
                   isAnimation,
                   &iad->IAD_completeGraphic);
      *isCompacted = TRUE ;
  }
  /* Load up to the abort point. */
  if ((status == IBS_IMPORT_STOPPED) && (params->IBP_bitmap != NullHandle))  {
      /* If we don't even have a first frame, then delete the whole thing */
      if (!*isAnimation)  {
          /* Only dump if we are not progressive */
#if PROGRESS_DISPLAY
          if ((!importProgressDataP) || (!importProgressDataP->IPD_callback))  {
#endif
              VMFreeVMChain(params->IBP_dest, VMCHAIN_MAKE_FROM_VM_BLOCK(params->IBP_bitmap)) ;

              /* Destroy the bitmap, but return the used memory count */
              AllocWatcherFree(watcher, *usedMem) ;
              *usedMem = 0 ;
              params->IBP_width = params->IBP_height = 1 ;
              params->IBP_bitmap = NullHandle ;
#if PROGRESS_DISPLAY
          }
#endif
      } else {
          /* We have at least one frame of this graphic.  Convert it to a single */
          /* frame image */
          VMBlockHandle originalBitmap = params->IBP_bitmap ;
          dword amountUsed ;
          int i ;

          /* Get access to each frame's animation */
          p_header = VMLock(params->IBP_animDest, params->IBP_bitmap, &mem) ;
          p_chain = (VMChain *)(((byte *)p_header) + p_header->AH_tree.VMCT_offset) ;

          /* Keep the first one */
          params->IBP_bitmap = VMCHAIN_GET_VM_BLOCK(*(p_chain++)) ;

          /* Delete the rest */
          for (i=1; i<p_header->AH_tree.VMCT_count; i++, p_chain++)
              VMFreeVMChain(params->IBP_animDest, *p_chain) ;

          /* Now delete the no longer needed header */
          VMUnlock(mem) ;
          VMFree(params->IBP_animDest, originalBitmap) ;

          /* Sorry, not an animation anymore */
          *isAnimation = FALSE ;

          /* Free up what we said we were using in memory */
          AllocWatcherFree(watcher, *usedMem) ;
          *usedMem = 0 ;

          /* Now allocate the lesser amount (ensuring we get it) */
          amountUsed = params->IBP_width ;
          amountUsed *= params->IBP_height ;
          if (AllocWatcherAllocate(watcher, amountUsed))
              *usedMem = amountUsed ;
      }
  }

  iad->IAD_size.XYS_width = params->IBP_width;
  iad->IAD_size.XYS_height = params->IBP_height;

  /* handle JPEGs disguised as GIFs (with .gif extension) */
  if (status == IBS_UNKNOWN_FORMAT) {
  }

  if ((status == IBS_NO_ERROR) || (status == IBS_IMPORT_STOPPED))
    *bmVMBlock = params->IBP_bitmap;
  else
    *bmVMBlock = 0;

    return status;
}


/*****************************************************************************
 *  JPEG import - main routine                                               *
 *****************************************************************************/

#if PROGRESS_DISPLAY
ImpBmpStatus ImpJPG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, ImportProgressData *importProgressDataP,
          MimeStatus *mimeStatus, FileHandle suppliedFile)
#else
ImpBmpStatus ImpJPG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock,
          MimeStatus *mimeStatus, FileHandle suppliedFile)
#endif
{
    ImpBmpStatus status;
#if SCANLINE_COMPRESS
    Boolean scanlineCompress = TRUE;
#endif

    /* we don't override scanlineCompress even if no progress display
       as it still seems faster than GrCompactBitmap */
#if SCANLINE_COMPRESS
    if (doCompress) {
	/* if TRUE, we'll compress per-scanline */
	InitFileReadBoolean("impgraph", "scanlineCompress", &scanlineCompress);
    } else {
	scanlineCompress = FALSE;
    }
#endif

    iad->IAD_completeGraphic = FALSE ;

@ifdef PRODUCT_FJPEG
    if (suppliedFile)
        FilePos(suppliedFile, 0, FILE_POS_START);
    *bmVMBlock =
        FJpegImport(file, vmf, &(iad->IAD_size), resolution, watcher, usedMem,
#if SCANLINE_COMPRESS
	        scanlineCompress,
#endif
            &iad->IAD_completeGraphic
#if PROGRESS_DISPLAY
	        , importProgressDataP
#endif
            , mimeStatus, suppliedFile
           );

    /* if fast import failed, try using IJGJPEG library */
    if(!(*bmVMBlock))
    {
@endif
        if (suppliedFile)
            FilePos(suppliedFile, 0, FILE_POS_START);
        *bmVMBlock =
            JpegImport(file, vmf, &(iad->IAD_size), resolution, watcher, usedMem,
#if SCANLINE_COMPRESS
	            scanlineCompress,
#endif
                &iad->IAD_completeGraphic
#if PROGRESS_DISPLAY
	            , importProgressDataP
#endif
                , mimeStatus, suppliedFile
           );
@ifdef PRODUCT_FJPEG
    }
@endif

#if SCANLINE_COMPRESS
    if (scanlineCompress) *isCompacted = TRUE;
#endif
    if (*bmVMBlock) {
      status = IBS_NO_ERROR;
      params->IBP_bitmap = *bmVMBlock;
    }
    else
      status = IBS_UNKNOWN_FORMAT;

    return status;
}

/********************************************************************
 ImpPNG
 *******************************************************************/

#if PROGRESS_DISPLAY
ImpBmpStatus ImpPNG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock, ImportProgressData *importProgressDataP,
          MimeStatus *mimeStatus, FileHandle suppliedFile)
#else
ImpBmpStatus ImpPNG(TCHAR *file, VMFileHandle vmf, ImageAdditionalData *iad,
          MimeRes resolution, AllocWatcherHandle watcher, dword *usedMem,
          Boolean doCompress, ImpBmpParams *params, Boolean *isCompacted,
          VMBlockHandle *bmVMBlock,
          MimeStatus *mimeStatus, FileHandle suppliedFile)
#endif
{
    ImpBmpStatus status = IBS_NO_ERROR;

    if (suppliedFile)
        FilePos(suppliedFile, 0, FILE_POS_START);

    if (suppliedFile) {
        *bmVMBlock = PngImportHandle(suppliedFile, vmf, &(iad->IAD_size),
        resolution, watcher, usedMem, &iad->IAD_completeGraphic
#if PROGRESS_DISPLAY
	    , importProgressDataP
#endif
        , mimeStatus);
    } else {
        *bmVMBlock = PngImport(file, vmf, &(iad->IAD_size), resolution,
        watcher, usedMem, &iad->IAD_completeGraphic
#if PROGRESS_DISPLAY
	    , importProgressDataP
#endif
        , mimeStatus);
    }

/*
    FIXME: SCANLINE_COMPRESS
    We don't do the improved scanline compression as of now
    (see "doCompress" in ImpJPG).
    So we return false in "isCompacted" and at least the
    (painfully slow) GrCompactBitmap will be called on
    the bitmap in our caller...
*/
    *isCompacted = FALSE;

    if (*bmVMBlock)
    {
      status = IBS_NO_ERROR;
      params->IBP_bitmap = *bmVMBlock;
    }
    else
    {
      status = IBS_UNKNOWN_FORMAT;
      params->IBP_bitmap = NullHandle;
    }

    return status;
}


/*****************************************************************************
 *  Common code for GIF and JPEG formats                                     *
 *****************************************************************************/

/*
 * Find out if we have already sent the bitmap to the text object
 * previously or not. If so, the text object should handle the freeing.
 * Otherwise (i.e. if no progress update ever got out), we'll just
 * discard the bitmap ourselves since nobody else knows about it.
 */
#if PROGRESS_DISPLAY
void FreeViaProgress(_ImportProgressParams_, VMFileHandle vmFile, VMBlockHandle bitmap)
{
    Boolean dofree;

    if (bitmap) {
	dofree = TRUE;

	if (importProgressDataP && importProgressDataP->IPD_callback)
	{
	    VMFileHandle oldFile = importProgressDataP->IPD_vmFile;
	    VMBlockHandle oldBitmap = importProgressDataP->IPD_bitmap;

	    if(oldFile == vmFile && oldBitmap == bitmap)
		dofree = FALSE;
	}

	if(dofree)
	  VMFreeVMChain(vmFile, VMCHAIN_MAKE_FROM_VM_BLOCK(bitmap));
    }
}
#endif

static Boolean
ImpGraphResolveParams(
    const ImpGraphImportParams *paramsP,
    ImpGraphResolvedParams *resolvedP)
{
    ImpGraphImportOptions optionMask;

    InitGlobals();

    resolvedP->format = IG_FORMAT_AUTO;
    resolvedP->compress = doCompress;
    resolvedP->useSystemPalette = useSysPal;
    resolvedP->status = NullOptr;

    if (!paramsP)
        return TRUE;

    if (paramsP->IGIP_size < IMP_GRAPH_IMPORT_PARAMS_V1_SIZE) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_PARAMS_TOO_SMALL);
        return FALSE;
    }

    if (paramsP->IGIP_format > IG_FORMAT_GIF) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_FORMAT_INVALID);
        return FALSE;
    }

    resolvedP->format = paramsP->IGIP_format;
    resolvedP->status = paramsP->IGIP_status;
    optionMask = paramsP->IGIP_optionMask;

    if (optionMask & IGIO_COMPRESS) {
        resolvedP->compress =
            ((paramsP->IGIP_options & IGIO_COMPRESS) != 0);
    }
    if (optionMask & IGIO_USE_SYSTEM_PALETTE) {
        resolvedP->useSystemPalette =
            ((paramsP->IGIP_options & IGIO_USE_SYSTEM_PALETTE) != 0);
    }

    return TRUE;
}

static Boolean
ImpGraphResetSource(FileHandle sourceFile)
{
    return (FilePos(sourceFile, 0, FILE_POS_START) == 0);
}

static Boolean
ImpGraphRecognizeFormat(
    FileHandle sourceFile,
    ImpGraphFormat *formatP)
{
    byte header[8] = {0};
    word bytesRead;
    Boolean recognized = FALSE;

    if (!ImpGraphResetSource(sourceFile)) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_SOURCE_RESET_FAILED);
        return FALSE;
    }

    bytesRead = FileRead(sourceFile, header, sizeof(header), FALSE);

    if (bytesRead == sizeof(header) &&
        memcmp(header, "\211PNG\r\n\032\n", sizeof(header)) == 0) {
        *formatP = IG_FORMAT_PNG;
        recognized = TRUE;
    } else if (bytesRead >= 3 &&
               header[0] == 0xff && header[1] == 0xd8 &&
               header[2] == 0xff) {
        *formatP = IG_FORMAT_JPEG;
        recognized = TRUE;
    } else if (bytesRead >= 6 &&
               (memcmp(header, "GIF87a", 6) == 0 ||
                memcmp(header, "GIF89a", 6) == 0)) {
        *formatP = IG_FORMAT_GIF;
        recognized = TRUE;
    }

    if (!recognized) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_FORMAT_NOT_RECOGNIZED);
    }

    if (!ImpGraphResetSource(sourceFile)) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_SOURCE_RESET_FAILED);
        return FALSE;
    }

    return recognized;
}

static VMBlockHandle
ImpGraphFinalizeDirectBitmap(
    VMFileHandle destFile,
    VMBlockHandle bitmap,
    Boolean compacted,
    Boolean compress)
{
    VMBlockHandle compactedBitmap;

    if (!bitmap || compacted || !compress)
        return bitmap;

    compactedBitmap = GrCompactBitmap(destFile, bitmap, destFile);
    if (compactedBitmap) {
        VMFreeVMChain(destFile, VMCHAIN_MAKE_FROM_VM_BLOCK(bitmap));
        bitmap = compactedBitmap;
    }

    return bitmap;
}

static VMBlockHandle
ImpGraphImportFileHandleResolved(
    FileHandle sourceFile,
    VMFileHandle destFile,
    const ImpGraphResolvedParams *resolvedP)
{
    ImpGraphFormat format;
    AllocWatcherHandle watcher;
    dword usedMem = 0;
    ImageAdditionalData iad;
    MimeStatus mimeStatus;
    ImpBmpParams privateParams;
    ImpBmpStatus status = IBS_UNKNOWN_FORMAT;
    VMBlockHandle bitmap = NullHandle;
    Boolean isAnimation = FALSE;
    Boolean isCompacted = FALSE;

    format = resolvedP->format;
    if (format == IG_FORMAT_AUTO) {
        if (!ImpGraphRecognizeFormat(sourceFile, &format))
            return NullHandle;
    }

    if (!ImpGraphResetSource(sourceFile)) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_SOURCE_RESET_FAILED);
        return NullHandle;
    }

    watcher = AllocWatcherCreate(MIME_LIMIT_NONE);
    if (!watcher) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_WATCHER_CREATE_FAILED);
        return NullHandle;
    }

    memset(&iad, 0, sizeof(iad));
    memset(&mimeStatus, 0, sizeof(mimeStatus));
    memset(&privateParams, 0, sizeof(privateParams));
    privateParams.IBP_mimeStatus = &mimeStatus;

    switch (format) {
    case IG_FORMAT_PNG:
        status = ImpPNG((TCHAR *)0, destFile, &iad,
                        MIME_RES_DISPLAY_DEFAULT, watcher, &usedMem,
                        resolvedP->compress, &privateParams, &isCompacted,
                        &bitmap
#if PROGRESS_DISPLAY
                        , (ImportProgressData *)0
#endif
                        , &mimeStatus, sourceFile);
        break;

    case IG_FORMAT_JPEG:
        status = ImpJPG((TCHAR *)0, destFile, &iad,
                        MIME_RES_DISPLAY_DEFAULT, watcher, &usedMem,
                        resolvedP->compress, &privateParams, &isCompacted,
                        &bitmap
#if PROGRESS_DISPLAY
                        , (ImportProgressData *)0
#endif
                        , &mimeStatus, sourceFile);
        break;

    case IG_FORMAT_GIF:
        status = ImpGIF((TCHAR *)0, destFile, &iad,
                        MIME_RES_DISPLAY_DEFAULT, watcher, &usedMem,
                        &privateParams, &isAnimation, &isCompacted, &bitmap
#if PROGRESS_DISPLAY
                        , destFile, (ImportProgressData *)0
#endif
                        , FALSE, sourceFile,
                        resolvedP->useSystemPalette, resolvedP->status);
        if (!bitmap && privateParams.IBP_bitmap)
            bitmap = privateParams.IBP_bitmap;
        break;
    }

    AllocWatcherDestroy(watcher);

    if (status != IBS_NO_ERROR) {
        switch (format) {
        case IG_FORMAT_PNG:
            EC_WARNING(IMPGRAPH_WARNING_DIRECT_PNG_DECODE_FAILED);
            break;
        case IG_FORMAT_JPEG:
            EC_WARNING(IMPGRAPH_WARNING_DIRECT_JPEG_DECODE_FAILED);
            break;
        case IG_FORMAT_GIF:
            EC_WARNING(IMPGRAPH_WARNING_DIRECT_GIF_DECODE_FAILED);
            break;
        }
    }
    if (!iad.IAD_completeGraphic) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_GRAPHIC_INCOMPLETE);
    }
    if (!bitmap) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_BITMAP_MISSING);
    }
    if (status != IBS_NO_ERROR || !iad.IAD_completeGraphic || !bitmap) {
        if (bitmap)
            VMFreeVMChain(destFile, VMCHAIN_MAKE_FROM_VM_BLOCK(bitmap));
        return NullHandle;
    }

    return ImpGraphFinalizeDirectBitmap(
        destFile, bitmap, isCompacted, resolvedP->compress);
}

VMBlockHandle _export _pascal
ImpGraphImportFile(
    const TCHAR *fileP,
    VMFileHandle destFile,
    const ImpGraphImportParams *paramsP)
{
    ImpGraphResolvedParams resolved;
    FileHandle sourceFile;
    VMBlockHandle bitmap;

    if (!ImpGraphResolveParams(paramsP, &resolved))
        return NullHandle;

    if (!fileP || !fileP[0]) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_FILENAME_INVALID);
        return NullHandle;
    }
    if (!destFile) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_DEST_FILE_INVALID);
        return NullHandle;
    }

    sourceFile = FileOpen(fileP, FILE_ACCESS_R | FILE_DENY_W);
    if (!sourceFile) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_FILE_OPEN_FAILED);
        return NullHandle;
    }

    bitmap = ImpGraphImportFileHandleResolved(sourceFile, destFile, &resolved);
    FileClose(sourceFile, TRUE);

    return bitmap;
}

VMBlockHandle _export _pascal
ImpGraphImportFileHandle(
    FileHandle sourceFile,
    VMFileHandle destFile,
    const ImpGraphImportParams *paramsP)
{
    ImpGraphResolvedParams resolved;

    if (!ImpGraphResolveParams(paramsP, &resolved))
        return NullHandle;

    if (!sourceFile) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_SOURCE_HANDLE_INVALID);
        return NullHandle;
    }
    if (!destFile) {
        EC_WARNING(IMPGRAPH_WARNING_DIRECT_DEST_FILE_INVALID);
        return NullHandle;
    }

    return ImpGraphImportFileHandleResolved(sourceFile, destFile, &resolved);
}

/*
 *  Import file whose name is specified in *file, assume it has the MIME
 *  type that is passed in *mimeType. The file is converted to a VMChain
 *  in the file specified by vmf. The size of the objects bounding box is
 *  passed back in *size.
 */
VMBlockHandle _pascal _export MimeDrvGraphicEx(_MimeGraphicParams_, dword extFlags)
{
	Boolean locAllowAnimations;
	Boolean locCompress;
    ImpBmpParams params;
    ImpBmpStatus status;
    VMBlockHandle dataVMBlock,bmVMBlock = NullHandle;
    Boolean isAnimation = FALSE ;
    Boolean isCompacted = FALSE ;
#if PROGRESS_DISPLAY
    VMFileHandle destFile = vmf;
#endif

    InitGlobals();                      /* Handled cached INI entries */

	locAllowAnimations = allowAnimations;
	locCompress = doCompress;

	if(extFlags & MIME_GREX_NO_ANIMATIONS) {

		locAllowAnimations = FALSE;
	}
	if(extFlags & MIME_GREX_NO_SCANLINE_COMPRESS) {

		locCompress = FALSE;
	}

    params.IBP_mimeStatus = mimeStatus ;
#if PROGRESS_DISPLAY
    /* use local work file, if available */
    if (importProgressDataP && importProgressDataP->IPD_callback) {
	/* must use actual dest file */
	importProgressDataP->IPD_vmFile = vmf;
	if (importProgressDataP->IPD_vmFile) {
	    vmf = importProgressDataP->IPD_vmFile;
	} else {
	    /* make sure progress handler knows we're using this file */
	    importProgressDataP->IPD_vmFile = vmf;
	}

        /* initialize complete structure for standard case: */
        importProgressDataP->IPD_iad.IAD_type = IAD_TYPE_BITMAP;
        importProgressDataP->IPD_iad.IAD_origin.P_x =
          importProgressDataP->IPD_iad.IAD_origin.P_y = 0;
        importProgressDataP->IPD_iad.IAD_completeGraphic = FALSE;
    }
#endif  /* PROGRESS_DISPLAY */

#if PROGRESS_DISPLAY
  #define IMP_DESTFILE_PARAM , destFile
  #define IMP_PROGRESS_PARAM , importProgressDataP
#else
  #define IMP_DESTFILE_PARAM
  #define IMP_PROGRESS_PARAM
#endif

#define IMP_GIF_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          &params, &isAnimation, &isCompacted, &bmVMBlock \
          IMP_DESTFILE_PARAM IMP_PROGRESS_PARAM, locAllowAnimations, \
          NullHandle, useSysPal, NullOptr
#define IMP_JPG_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          locCompress, &params, &isCompacted, &bmVMBlock IMP_PROGRESS_PARAM \
          , mimeStatus, NullHandle
#define IMP_PNG_PARAMS file, vmf, iad, resolution, watcher, usedMem, \
          locCompress, &params, &isCompacted, &bmVMBlock IMP_PROGRESS_PARAM \
          , mimeStatus, NullHandle


    if (strcmp(mimeType, _TEXT("image/gif")) == 0)
    {
        status = ImpGIF(IMP_GIF_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpPNG(IMP_PNG_PARAMS);
    }
    else if (strcmp(mimeType, _TEXT("image/jpeg")) == 0 || 
	     strcmp(mimeType, _TEXT("image/jpg")) == 0)
    {
        status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpGIF(IMP_GIF_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpPNG(IMP_PNG_PARAMS);
    }
    else if (strcmp(mimeType, _TEXT("image/png")) == 0)
    {
        status = ImpPNG(IMP_PNG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpJPG(IMP_JPG_PARAMS);
        if (status == IBS_UNKNOWN_FORMAT)
            status = ImpGIF(IMP_GIF_PARAMS);
    }


    if (bmVMBlock)                       /* check if import successful */
    {
      /* Compress and convert the bitmap to a GString if not an animation */
      if (!isAnimation)  {
	  /* Compact the bitmap if not already */
	  if (!isCompacted && locCompress)  {
	      VMBlockHandle bmCompacted;

	      bmCompacted = GrCompactBitmap(vmf, bmVMBlock, vmf);
	      if(bmCompacted)
	      {
#if PROGRESS_DISPLAY
		  FreeViaProgress(importProgressDataP, vmf, bmVMBlock);
#else
		  VMFreeVMChain(vmf, VMCHAIN_MAKE_FROM_VM_BLOCK(bmVMBlock));
#endif
		  bmVMBlock = bmCompacted;
	      }
	  }

	  dataVMBlock = bmVMBlock;
	  iad->IAD_type = IAD_TYPE_BITMAP;
      } else {
          iad->IAD_type = IAD_TYPE_ANIMATION; /* returned data is an animation */
          dataVMBlock = bmVMBlock ;
      }
      iad->IAD_origin.P_x = iad->IAD_origin.P_y = 0;
    }
    else
      dataVMBlock = 0;                  /* import did not succeed */

    return dataVMBlock;
}

char * _pascal _export MimeDrvInfo(_MimeInfoParams_)
{
    #define FORMATS _TEXT("image/gif\0")       /* MIME type of supported format */ \
                      _TEXT("GIF\0")           /* primary suggested extension */ \
                      _TEXT("\0")              /* end of extension list */ \
                    _TEXT("image/jpg\0") \
                      _TEXT("JPG\0") \
                      _TEXT("\0") \
                    _TEXT("image/jpeg\0") \
                      _TEXT("JPG\0") \
                      _TEXT("\0") \
                    _TEXT("image/png\0") \
                      _TEXT("PNG\0") \
                      _TEXT("\0") \
                    _TEXT("\0")                /* end of format list */

    /* Return list of supported formats */
    return memcpy(buf, FORMATS, sizeof(FORMATS));
}

#pragma argsused
char * _pascal _export MimeDrvText(_MimeTextParams_)
{
   /* This is a graphics driver that likes to be called for returning an
      image, rather than for returning a text transfer item. */

   tad->TAD_type = TAD_TYPE_REQUEST_IMG;

   return 0;                            /* anything... */
}

VMBlockHandle _pascal _export MimeDrvGraphic(_MimeGraphicParams_)
{
	return MimeDrvGraphicEx(
            mimeType,
            file,
            vmf,
            iad,
            resolution,
            watcher,
            usedMem,
            mimeStatus,
#ifdef PROGRESS_DISPLAY
			importProgressDataP,
#endif
			0		// no specific flags here
	);
}
