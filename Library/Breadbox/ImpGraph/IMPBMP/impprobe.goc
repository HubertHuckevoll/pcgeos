@include <stdapp.goh>
#include <htmldrv.h>

#include <Ansi/string.h>

typedef struct {
    FileHandle file;
#if PROGRESS_DISPLAY
    LoadProgressData *progressP;
#endif
    dword offset;
    dword limit;
} ImpGraphProbeReader;

typedef enum {
    IGP_FORMAT_UNKNOWN,
    IGP_FORMAT_GIF,
    IGP_FORMAT_JPEG,
    IGP_FORMAT_PNG
} ImpGraphProbeFormat;

static word _pascal
ImpGraphProbeRead(ImpGraphProbeReader *readerP, void *buffer, word count)
{
    dword remaining;
    word read;

    if(readerP->offset >= readerP->limit)
        return 0;

    remaining = readerP->limit - readerP->offset;
    if(remaining < count)
        count = (word)remaining;

#if PROGRESS_DISPLAY
    if(readerP->progressP)
    {
        LoadProgressData *progressP;

        progressP = readerP->progressP;
        read = ((pcfm_LoadProgressCallback *)
          ProcCallFixedOrMovable_pascal)(progressP, LPCT_PRE_READ,
          buffer, count, progressP->LPD_callback);
    }
    else
#endif
    {
        read = FileRead(readerP->file, buffer, count, FALSE);
    }

    readerP->offset += read;
    return read;
}

static Boolean _pascal
ImpGraphProbeReadExact(ImpGraphProbeReader *readerP, void *buffer, word count)
{
    return ImpGraphProbeRead(readerP, buffer, count) == count;
}

static Boolean _pascal
ImpGraphProbeSkip(ImpGraphProbeReader *readerP, dword count)
{
    byte buffer[32];
    word chunk;

    while(count)
    {
        chunk = sizeof(buffer);
        if(count < chunk)
            chunk = (word)count;
        if(ImpGraphProbeRead(readerP, buffer, chunk) != chunk)
            return FALSE;
        count -= chunk;
    }
    return TRUE;
}

static void _pascal
ImpGraphProbeReset(ImpGraphProbeReader *readerP)
{
    readerP->offset = 0;
#if PROGRESS_DISPLAY
    if(readerP->progressP)
    {
        LoadProgressData *progressP;

        progressP = readerP->progressP;
        ((pcfm_LoadProgressCallback *)ProcCallFixedOrMovable_pascal)(
          progressP, LPCT_RESET_STREAM_STATE, (void *)0, 0,
          progressP->LPD_callback);
    }
    else
#endif
    {
        FilePos(readerP->file, 0, FILE_POS_START);
    }
}

static ImpGraphProbeFormat _pascal
ImpGraphProbeDetect(ImpGraphProbeReader *readerP)
{
    static const byte pngSignature[8] =
      {0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a};
    byte signature[12];
    word read;
    ImpGraphProbeFormat format;

    memset(signature, 0, sizeof(signature));
    read = ImpGraphProbeRead(readerP, signature, sizeof(signature));
    format = IGP_FORMAT_UNKNOWN;

    if(read >= 6 &&
       (!memcmp(signature, "GIF87a", 6) ||
        !memcmp(signature, "GIF89a", 6)))
        format = IGP_FORMAT_GIF;
    else if(read >= 8 && !memcmp(signature, pngSignature, 8))
        format = IGP_FORMAT_PNG;
    else if(read >= 2 && signature[0] == 0xff && signature[1] == 0xd8)
        format = IGP_FORMAT_JPEG;

    ImpGraphProbeReset(readerP);
    return format;
}

static dword _pascal
ImpGraphProbeGetBE32(const byte *p)
{
    dword value;

    value = ((dword)p[0] << 24) | ((dword)p[1] << 16) |
      ((dword)p[2] << 8) | p[3];
    return value;
}

static MimeGraphicProbeResult _pascal
ImpGraphProbeGIF(ImpGraphProbeReader *readerP, MimeGraphicProbeData *dataP)
{
    byte header[13];

    if(!ImpGraphProbeReadExact(readerP, header, sizeof(header)) ||
       (memcmp(header, "GIF87a", 6) && memcmp(header, "GIF89a", 6)))
        return MIME_GRAPHIC_PROBE_UNKNOWN;

    dataP->MGPD_width = header[6] | ((word)header[7] << 8);
    dataP->MGPD_height = header[8] | ((word)header[9] << 8);
    return dataP->MGPD_width && dataP->MGPD_height ?
      MIME_GRAPHIC_PROBE_FOUND : MIME_GRAPHIC_PROBE_UNKNOWN;
}

static MimeGraphicProbeResult _pascal
ImpGraphProbePNG(ImpGraphProbeReader *readerP, MimeGraphicProbeData *dataP)
{
    static const byte pngSignature[8] =
      {0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a};
    byte header[24];
    byte tail[9];

    if(!ImpGraphProbeReadExact(readerP, header, sizeof(header)) ||
       !ImpGraphProbeReadExact(readerP, tail, sizeof(tail)) ||
       memcmp(header, pngSignature, 8) ||
       ImpGraphProbeGetBE32(header + 8) != 13 ||
       memcmp(header + 12, "IHDR", 4) ||
       tail[2] != 0 || tail[3] != 0 || tail[4] > 1)
        return MIME_GRAPHIC_PROBE_UNKNOWN;

    dataP->MGPD_width = ImpGraphProbeGetBE32(header + 16);
    dataP->MGPD_height = ImpGraphProbeGetBE32(header + 20);
    return dataP->MGPD_width && dataP->MGPD_height ?
      MIME_GRAPHIC_PROBE_FOUND : MIME_GRAPHIC_PROBE_UNKNOWN;
}

static Boolean _pascal
ImpGraphProbeIsSOF(byte marker)
{
    return marker >= 0xc0 && marker <= 0xcf &&
      marker != 0xc4 && marker != 0xc8 && marker != 0xcc;
}

static MimeGraphicProbeResult _pascal
ImpGraphProbeJPEG(ImpGraphProbeReader *readerP, MimeGraphicProbeData *dataP)
{
    byte markerBytes[2];
    byte marker;
    byte size[2];
    byte sof[6];
    word segmentSize;

    if(!ImpGraphProbeReadExact(readerP, markerBytes, 2) ||
       markerBytes[0] != 0xff || markerBytes[1] != 0xd8)
        return MIME_GRAPHIC_PROBE_UNKNOWN;

    while(readerP->offset < readerP->limit)
    {
        do
        {
            if(!ImpGraphProbeReadExact(readerP, &marker, 1))
                return MIME_GRAPHIC_PROBE_UNKNOWN;
        } while(marker != 0xff);

        do
        {
            if(!ImpGraphProbeReadExact(readerP, &marker, 1))
                return MIME_GRAPHIC_PROBE_UNKNOWN;
        } while(marker == 0xff);

        if(marker == 0x00)
            continue;
        if(marker == 0xd9 || marker == 0xda)
            return MIME_GRAPHIC_PROBE_UNKNOWN;
        if(marker == 0xd8 || marker == 0x01 ||
           (marker >= 0xd0 && marker <= 0xd7))
            continue;

        if(!ImpGraphProbeReadExact(readerP, size, sizeof(size)))
            return MIME_GRAPHIC_PROBE_UNKNOWN;
        segmentSize = ((word)size[0] << 8) | size[1];
        if(segmentSize < 2)
            return MIME_GRAPHIC_PROBE_UNKNOWN;

        if(ImpGraphProbeIsSOF(marker))
        {
            if(segmentSize < 11 ||
               !ImpGraphProbeReadExact(readerP, sof, sizeof(sof)) ||
               !sof[5] || segmentSize != 8 + 3 * (word)sof[5] ||
               !ImpGraphProbeSkip(readerP, segmentSize - 8))
                return MIME_GRAPHIC_PROBE_UNKNOWN;
            dataP->MGPD_height = ((word)sof[1] << 8) | sof[2];
            dataP->MGPD_width = ((word)sof[3] << 8) | sof[4];
            return dataP->MGPD_width && dataP->MGPD_height ?
              MIME_GRAPHIC_PROBE_FOUND : MIME_GRAPHIC_PROBE_UNKNOWN;
        }

        if(!ImpGraphProbeSkip(readerP, segmentSize - 2))
            return MIME_GRAPHIC_PROBE_UNKNOWN;
    }

    return MIME_GRAPHIC_PROBE_UNKNOWN;
}

MimeGraphicProbeResult _pascal _export
MimeDrvGraphicProbe(_MimeGraphicProbeParams_)
{
    ImpGraphProbeReader reader;
    ImpGraphProbeFormat format;
    MimeGraphicProbeResult result;

    data->MGPD_width = data->MGPD_height = 0;
    reader.file = NullHandle;
#if PROGRESS_DISPLAY
    reader.progressP = loadProgressDataP;
#endif
    reader.offset = 0;
    reader.limit = maxBytes;

#if PROGRESS_DISPLAY
    if(!reader.progressP)
#endif
    {
        if(!file || !*file)
            return MIME_GRAPHIC_PROBE_UNKNOWN;
        reader.file = FileOpen(file, FILE_ACCESS_R | FILE_DENY_W);
        if(!reader.file)
            return MIME_GRAPHIC_PROBE_UNKNOWN;
    }

    format = ImpGraphProbeDetect(&reader);
    switch(format)
    {
      case IGP_FORMAT_GIF:
        result = ImpGraphProbeGIF(&reader, data);
        break;
      case IGP_FORMAT_JPEG:
        result = ImpGraphProbeJPEG(&reader, data);
        break;
      case IGP_FORMAT_PNG:
        result = ImpGraphProbePNG(&reader, data);
        break;
      default:
        result = MIME_GRAPHIC_PROBE_UNKNOWN;
        break;
    }

    ImpGraphProbeReset(&reader);
    if(reader.file)
        FileClose(reader.file, FALSE);

    (void)mimeType;
    return result;
}
