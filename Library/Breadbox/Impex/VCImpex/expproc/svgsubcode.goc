VCImpexSVGWritePolygonEnd(VCImpexSVGExportContext *context,
                          Boolean filled,
                          RegionFillRule fillRule,
                          const TransMatrix *tm)
{
    VCISVGStyle style;
    VCISVGMatrix matrix;

    if (context == (void*)0)
    {
        return FALSE;
    }
    VCImpexSVGNormalizeStyle(context, (filled == FALSE),
                             (filled != FALSE), filled, fillRule, &style);
    VCImpexSVGNormalizeMatrix(tm, &matrix);
    return VCISVGEmitPolygonEnd(&context->writer, &style,
                                &matrix) ? TRUE : FALSE;
}

