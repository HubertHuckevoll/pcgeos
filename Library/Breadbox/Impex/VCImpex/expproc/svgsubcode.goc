Boolean _pascal
VCImpexSVGWritePathEnd(VCImpexSVGExportContext *context,
                       Boolean fillPath,
                       Boolean strokePath,
                       RegionFillRule fillRule,
                       const TransMatrix *tm)
{
    VCISVGStyle style;
    VCISVGMatrix matrix;

    if (context == (void*)0)
    {
        return FALSE;
