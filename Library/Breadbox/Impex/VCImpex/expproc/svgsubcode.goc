VCImpexSVGWritePolygonPoint(VCImpexSVGExportContext *context,
                            const PointWWFixed *point)
{
    VCISVGPoint normalizedPoint;

    if ((context == (void*)0) || (point == (void*)0))
    {
        return FALSE;
    }
    VCImpexSVGNormalizePoint(point, &normalizedPoint);
    return VCISVGEmitPolygonPoint(&context->writer,
                                  &normalizedPoint) ? TRUE : FALSE;
}

