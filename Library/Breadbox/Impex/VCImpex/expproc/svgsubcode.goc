Boolean _pascal
VCImpexSVGWritePathCubic(VCImpexSVGExportContext *context,
                         const PointWWFixed *control1,
                         const PointWWFixed *control2,
                         const PointWWFixed *end)
{
    VCISVGPoint normalizedControl1;
    VCISVGPoint normalizedControl2;
    VCISVGPoint normalizedEnd;

    if ((context == (void*)0) || (control1 == (void*)0) ||
